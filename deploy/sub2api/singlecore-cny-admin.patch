+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { mount } from '@vue/test-utils'
+import type { ModelPlazaGroup, ModelPlazaResponse } from '@/api/modelPlaza'
+import ModelPlazaContent from '../ModelPlazaContent.vue'
+import PlazaFilterBar from '../PlazaFilterBar.vue'
+import PlazaGroupSection from '../PlazaGroupSection.vue'
+
+const { appStore } = vi.hoisted(() => ({ appStore: { siteLogo: '' } }))
+vi.mock('@/stores/app', () => ({ useAppStore: () => appStore }))
+vi.mock('@/stores/auth', () => ({ useAuthStore: () => ({ isAuthenticated: true }) }))
+vi.mock('vue-i18n', async () => {
+  const actual = await vi.importActual<typeof import('vue-i18n')>('vue-i18n')
+  return { ...actual, useI18n: () => ({ t: (key: string) => key }) }
+})
+
+function response(): ModelPlazaResponse {
+  return {
+    description: '',
+    groups: [{
+      id: 1, name: 'Synthetic group', platform: 'openai', rate_multiplier: 0.5,
+      models: [
+        { name: 'gpt-image-2', platform: 'openai', pricing: null, official_pricing: null },
+        { name: 'gpt-6.1-sol', platform: 'openai', pricing: null, official_pricing: null },
+      ],
+    } as ModelPlazaGroup],
+  }
+}
+
+function mountContent(data: ModelPlazaResponse, loading = false, error = false) {
+  return mount(ModelPlazaContent, {
+    props: { response: data, loading, error },
+    global: { stubs: { PlazaFilterBar: true, PlazaGroupSection: true, Icon: true } },
+  })
+}
+
+describe('RealYu model catalog display search', () => {
+  beforeEach(() => { appStore.siteLogo = '/brand/realyu-wordmark.png?v=1' })
+
+  it.each(['GPT Image 2.5', 'gpt-image-2'])('finds the exact source model by %s without changing source data', async (query) => {
+    const data = response()
+    const original = structuredClone(data)
+    const wrapper = mountContent(data)
+    wrapper.getComponent(PlazaFilterBar).vm.$emit('update:search', query)
+    await wrapper.vm.$nextTick()
+    const models = wrapper.getComponent(PlazaGroupSection).props('group').models
+    expect(models.map((model: { name: string }) => model.name)).toEqual(['gpt-image-2'])
+    expect(data).toEqual(original)
+    wrapper.unmount()
+  })
+
+  it('does not activate RealYu aliases for another custom brand', async () => {
+    appStore.siteLogo = '/custom-brand.png'
