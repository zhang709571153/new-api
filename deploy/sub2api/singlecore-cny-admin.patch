--- /dev/null
+++ b/backend/internal/service/realyu_customer_currency.go
@@ -0,0 +1,23 @@
+package service
+
+import (
+	"os"
+	"strings"
+
+	"github.com/shopspring/decimal"
+)
+
+// Customer currency changes presentation/input boundaries, never the USD ledger,
+// model reference prices, group multipliers or previously settled transactions.
+func (s *SettingService) realYuCustomerCurrency() (string, string) {
+	if s.cfg == nil || !s.cfg.RealYuFundingEnabled {
+		return "USD", "1"
+	}
+	rate, err := decimal.NewFromString(strings.TrimSpace(os.Getenv("REALYU_CUSTOMER_USD_TO_CNY")))
+	if err != nil || !rate.IsPositive() || rate.GreaterThan(decimal.NewFromInt(1000000)) || rate.Exponent() < -6 {
+		// No guessed exchange rate. Clients display unavailable and reject amount
+		// edits until the reviewed migration exchange rate is configured.
+		return "CNY", ""
+	}
+	return "CNY", rate.String()
+}
