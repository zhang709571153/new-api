+
+func TestRealYuClientDownloadsRangesLengthAndMutableCache(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	folder := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(folder, "runtime"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(folder, "runtime", "client.tar.gz"), []byte("0123456789"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(folder, "setup.ps1"), []byte("synthetic script"), 0600))
+	h := &RealYuClientCompatibilityHandler{assetsDir: folder}
+	r := gin.New()
+	r.GET("/downloads/realyu/*file", h.Download)
+	r.HEAD("/downloads/realyu/*file", h.Download)
+	for _, method := range []string{"GET", "HEAD"} {
+		req := httptest.NewRequest(method, "/downloads/realyu/runtime/client.tar.gz?v=fixture", nil)
+		req.Header.Set("Accept-Encoding", "gzip, br")
+		if method == "GET" {
+			req.Header.Set("Range", "bytes=3-6")
+		}
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, req)
+		require.Empty(t, rec.Header().Get("Content-Encoding"))
+		require.Contains(t, rec.Header().Get("Cache-Control"), "no-transform")
+		if method == "GET" {
+			require.Equal(t, 206, rec.Code)
+			require.Equal(t, "3456", rec.Body.String())
+			require.Equal(t, "4", rec.Header().Get("Content-Length"))
+			require.Equal(t, "bytes 3-6/10", rec.Header().Get("Content-Range"))
+		} else {
+			require.Equal(t, 200, rec.Code)
+			require.Empty(t, rec.Body.String())
+			require.Equal(t, "10", rec.Header().Get("Content-Length"))
+		}
+	}
+	for _, name := range []string{"setup.ps1", "missing", "../private", "setup.ps1:secret", "runtime%5c..%5cprivate", ""} {
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, httptest.NewRequest("GET", "/downloads/realyu/"+name, nil))
+		if name == "setup.ps1" {
+			require.Equal(t, 200, rec.Code)
+			require.Contains(t, rec.Header().Get("Cache-Control"), "no-store")
+		} else {
+			require.Equal(t, 404, rec.Code)
+			require.NotContains(t, rec.Body.String(), "<html")
+		}
+	}
+	h.assetsDir = ""
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("GET", "/downloads/realyu/setup.ps1", nil))
+	require.Equal(t, 404, rec.Code)
+}
+
+func TestRealYuClientDownloadRootRejectsSymlinkEscape(t *testing.T) {
+	root := t.TempDir()
+	outside := filepath.Join(t.TempDir(), "secret.txt")
+	require.NoError(t, os.WriteFile(outside, []byte("synthetic secret"), 0600))
+	if err := os.Symlink(outside, filepath.Join(root, "escape.txt")); err != nil {
+		t.Skip("host cannot create test symlinks")
+	}
+	h := &RealYuClientCompatibilityHandler{assetsDir: root}
+	r := gin.New()
+	r.GET("/downloads/realyu/*file", h.Download)
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("GET", "/downloads/realyu/escape.txt", nil))
+	require.Equal(t, 404, rec.Code)
+	require.NotContains(t, rec.Body.String(), "synthetic secret")
+}
+
+const syntheticDiagnostic = `{"id":"0123456789abcdef0123456789abcdef","client_version":"1.4.30","platform":"win32","architecture":"AMD64","stage":"key_validation","code":"KEY_REJECTED","http_status":401,"elevation":"standard","winerror":4551,"secret":"sk-never-persist","path":"C:/private/person","exception_message":"secret"}`
+
+func TestRealYuClientDiagnosticWhitelistDurableDedupAndFailures(t *testing.T) {
+	folder := filepath.Join(t.TempDir(), "diagnostics")
+	h := &RealYuClientCompatibilityHandler{diagnosticsDir: folder}
+	r := gin.New()
+	r.POST("/report", h.ReceiveClientDiagnostic)
+	var wg sync.WaitGroup
+	codes := make(chan int, 16)
+	for range 16 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			rec := httptest.NewRecorder()
+			r.ServeHTTP(rec, httptest.NewRequest("POST", "/report", strings.NewReader(syntheticDiagnostic)))
+			codes <- rec.Code
+		}()
+	}
+	wg.Wait()
+	close(codes)
+	for code := range codes {
+		require.Equal(t, 202, code)
+	}
+	files, err := os.ReadDir(folder)
+	require.NoError(t, err)
+	require.Len(t, files, 1)
+	stored, err := os.ReadFile(filepath.Join(folder, files[0].Name()))
+	require.NoError(t, err)
+	for _, secret := range []string{"sk-", "private", "secret", "exception_message"} {
+		require.NotContains(t, string(stored), secret)
+	}
+	require.Contains(t, string(stored), `"origin":"unverified_client"`)
+	for _, tc := range []struct {
+		body string
+		code int
+	}{
+		{strings.Repeat("x", 4097), 413}, {"{", 400},
+		{strings.Replace(syntheticDiagnostic, "KEY_REJECTED", "sk-secret", 1), 400},
+		{strings.Replace(syntheticDiagnostic, "key_validation", "private-path", 1), 400},
+		{strings.Replace(syntheticDiagnostic, `"secret":"sk-never-persist"`, `"session_actual_provider":"sk-private"`, 1), 400},
+		{strings.Replace(syntheticDiagnostic, `"secret":"sk-never-persist"`, `"session_thread_match":"matches","session_actual_provider":"openai"`, 1), 202},
+	} {
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, httptest.NewRequest("POST", "/report", strings.NewReader(tc.body)))
+		require.Equal(t, tc.code, rec.Code)
+	}
+	h.diagnosticsDir = filepath.Join(folder, files[0].Name(), "invalid")
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("POST", "/report", strings.NewReader(syntheticDiagnostic)))
+	require.Equal(t, 503, rec.Code)
+	h.diagnosticsDir = ""
+	rec = httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("POST", "/report", strings.NewReader(syntheticDiagnostic)))
+	require.Equal(t, 503, rec.Code)
+}
+
+func TestRealYuClientDiagnosticRateLimit120PerIP(t *testing.T) {
+	mini := miniredis.RunT(t)
+	rdb := redis.NewClient(&redis.Options{Addr: mini.Addr()})
+	t.Cleanup(func() { _ = rdb.Close() })
+	cfg := &config.Config{RealYuClientDiagnosticsDir: t.TempDir()}
+	h := NewRealYuClientCompatibilityHandler(cfg, nil, rdb, nil, BuildInfo{})
+	r := gin.New()
+	require.NoError(t, r.SetTrustedProxies(nil))
+	r.POST("/report", h.LimitDiagnostic, func(c *gin.Context) { c.Status(202) })
+	for n := 1; n <= 121; n++ {
+		req := httptest.NewRequest("POST", "/report", nil)
+		req.RemoteAddr = "198.51.100.10:5678"
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, req)
+		if n <= 120 {
+			require.Equal(t, 202, rec.Code)
+		} else {
+			require.Equal(t, 429, rec.Code)
+			require.NotEmpty(t, rec.Header().Get("Retry-After"))
+		}
+	}
+	req := httptest.NewRequest("POST", "/report", nil)
+	req.RemoteAddr = "198.51.100.11:5678"
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, req)
+	require.Equal(t, 202, rec.Code)
+}
+
+func TestRealYuClientDiagnosticStorageBoundAndRetention(t *testing.T) {
+	folder := t.TempDir()
+	for n := 0; n < 5000; n++ {
+		require.NoError(t, os.WriteFile(filepath.Join(folder, fmt.Sprintf("%032x.json", n)), []byte("{}"), 0600))
+	}
+	h := &RealYuClientCompatibilityHandler{diagnosticsDir: folder}
+	r := gin.New()
+	r.POST("/report", h.ReceiveClientDiagnostic)
+	body := strings.Replace(syntheticDiagnostic, "0123456789abcdef0123456789abcdef", "ffffffffffffffffffffffffffffffff", 1)
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("POST", "/report", strings.NewReader(body)))
+	require.Equal(t, 429, rec.Code)
+	old := filepath.Join(folder, fmt.Sprintf("%032x.json", 0))
+	require.NoError(t, os.Chtimes(old, time.Now().AddDate(0, 0, -31), time.Now().AddDate(0, 0, -31)))
+	rec = httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("POST", "/report", strings.NewReader(body)))
+	require.Equal(t, 202, rec.Code)
+	_, err := os.Stat(old)
+	require.True(t, os.IsNotExist(err))
+}
+
+func TestRealYuClientStatusReportsActualDependencyFailure(t *testing.T) {
+	h := &RealYuClientCompatibilityHandler{version: "synthetic-singlecore", siteName: func(context.Context) string { return "RealYu API" }, health: func(context.Context) error { return nil }}
+	r := gin.New()
