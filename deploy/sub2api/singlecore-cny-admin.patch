+
+// Embedding the interfaces fails the test on any unexpected mutating call.
+type entryUserRepo struct {
+	service.UserRepository
+	users map[int64]*service.User
+}
+
+func (r *entryUserRepo) GetByID(_ context.Context, id int64) (*service.User, error) {
+	u, ok := r.users[id]
+	if !ok {
+		return nil, service.ErrUserNotFound
+	}
+	copy := *u
+	return &copy, nil
+}
+
+func (r *entryUserRepo) GetUserAvatar(context.Context, int64) (*service.UserAvatar, error) {
+	return nil, nil
+}
+
+type entrySettingsRepo struct {
+	service.SettingRepository
+	ackReads int
+}
+
+func (r *entrySettingsRepo) GetValue(_ context.Context, key string) (string, error) {
+	if strings.HasPrefix(key, "admin_compliance_acknowledgement") {
+		r.ackReads++
+	}
+	return "", service.ErrSettingNotFound
+}
+func (r *entrySettingsRepo) GetMultiple(context.Context, []string) (map[string]string, error) {
+	return map[string]string{}, nil
+}
+func (r *entrySettingsRepo) GetAll(context.Context) (map[string]string, error) {
+	return map[string]string{}, nil
+}
+
+func TestRealYuAdminEntryUsesAuthenticationWithoutFirstUseAcknowledgement(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	cfg := &config.Config{JWT: config.JWTConfig{Secret: "synthetic-admin-entry-test", ExpireHour: 1}}
+	authSvc := service.NewAuthService(nil, nil, nil, nil, cfg, nil, nil, nil, nil, nil, nil, nil, nil)
+	users := &entryUserRepo{users: map[int64]*service.User{
+		1: {ID: 1, Email: "admin@synthetic.invalid", Role: service.RoleAdmin, Status: service.StatusActive, TokenVersion: 7},
+		2: {ID: 2, Email: "user@synthetic.invalid", Role: service.RoleUser, Status: service.StatusActive},
+		3: {ID: 3, Email: "disabled@synthetic.invalid", Role: service.RoleAdmin, Status: "disabled"},
+	}}
+	userSvc := service.NewUserService(users, nil, nil, nil)
+	settingsRepo := &entrySettingsRepo{}
+	settingsSvc := service.NewSettingService(settingsRepo, cfg)
+	adminAuth := middleware.NewAdminAuthMiddleware(authSvc, userSvc, nil, nil)
+	audit := middleware.AuditLogMiddleware(func(c *gin.Context) { c.Next() })
+	stepUp := middleware.StepUpAuthMiddleware(func(c *gin.Context) { c.Next() })
+	settingsHandler := adminhandler.NewSettingHandler(settingsSvc, nil, nil, nil, nil, nil, nil)
+	adminPayment := adminhandler.NewPaymentHandler(nil, service.NewPaymentConfigService(nil, settingsRepo, nil))
+	router := gin.New()
+	v1 := router.Group("/api/v1")
+	RegisterAdminRoutes(v1, &handler.Handlers{Admin: &handler.AdminHandlers{Setting: settingsHandler}}, adminAuth, audit, stepUp, settingsSvc, nil)
+	RegisterPaymentRoutes(v1, &handler.PaymentHandler{}, &handler.PaymentWebhookHandler{}, adminPayment,
+		middleware.JWTAuthMiddleware(adminAuth), adminAuth, audit, settingsSvc, nil, nil)
+	handler.RegisterPageRoutes(v1, t.TempDir(), gin.HandlerFunc(adminAuth), gin.HandlerFunc(adminAuth), settingsSvc)
+
+	tokenFor := func(id int64, revoked bool) string {
+		user := *users.users[id]
+		if revoked {
+			user.TokenVersion--
+		}
+		token, err := authSvc.GenerateToken(context.Background(), &user)
+		require.NoError(t, err)
+		return "Bearer " + token
+	}
+	for _, path := range []string{"/api/v1/admin/settings", "/api/v1/admin/payment/config", "/api/v1/pages"} {
+		for _, tc := range []struct {
+			name string
+			auth string
+			want int
+		}{
+			{"anonymous", "", http.StatusUnauthorized},
+			{"invalid_token", "Bearer invalid-token", http.StatusUnauthorized},
+			{"ordinary_member", tokenFor(2, false), http.StatusForbidden},
+			{"disabled_admin", tokenFor(3, false), http.StatusUnauthorized},
+			{"revoked_admin", tokenFor(1, true), http.StatusUnauthorized},
+			{"admin_without_ack_record", tokenFor(1, false), http.StatusOK},
+		} {
+			t.Run(path+"/"+tc.name, func(t *testing.T) {
+				req := httptest.NewRequest(http.MethodGet, path, nil)
+				if tc.auth != "" {
+					req.Header.Set("Authorization", tc.auth)
+				}
+				rec := httptest.NewRecorder()
+				router.ServeHTTP(rec, req)
+				require.Equal(t, tc.want, rec.Code, rec.Body.String())
+				require.NotContains(t, rec.Body.String(), "ADMIN_COMPLIANCE_ACK_REQUIRED")
+			})
+		}
+	}
+	require.Zero(t, settingsRepo.ackReads, "console access must not read or create legal acknowledgement records")
+}
