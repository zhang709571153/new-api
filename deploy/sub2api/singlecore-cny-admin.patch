+import { describe, expect, it, vi } from 'vitest'
+import { mount, flushPromises } from '@vue/test-utils'
+
+const compliance = vi.hoisted(() => ({
+  fetchStatus: vi.fn().mockResolvedValue({ required: true }),
+  requireAcknowledgement: vi.fn(),
+  accept: vi.fn(),
+  reset: vi.fn(),
+}))
+const app = vi.hoisted(() => ({
+  siteName: 'RealYu API', siteLogo: '', cachedPublicSettings: {},
+  fetchPublicSettings: vi.fn().mockResolvedValue({}),
+}))
+vi.mock('vue-router', () => ({
+  RouterView: { template: '<main data-testid="console-route" />' },
+  useRouter: () => ({ afterEach: vi.fn(), replace: vi.fn() }),
+  useRoute: () => ({ fullPath: '/admin/dashboard', path: '/admin/dashboard', meta: {} }),
+}))
+vi.mock('@/stores', () => ({
+  useAppStore: () => app,
+  useAuthStore: () => ({ isAuthenticated: true, isAdmin: true }),
+  useSubscriptionStore: () => ({ fetchActiveSubscriptions: vi.fn(), startPolling: vi.fn(), clear: vi.fn() }),
+  useAnnouncementStore: () => ({ fetchAnnouncements: vi.fn(), reset: vi.fn() }),
+  useAdminComplianceStore: () => compliance,
+  useAdminSettingsStore: () => ({ customMenuItems: [] }),
+}))
+vi.mock('@/api/setup', () => ({ getSetupStatus: vi.fn().mockResolvedValue({ needs_setup: false }) }))
+vi.mock('@/router/title', () => ({ resolveRouteDocumentTitle: () => 'RealYu API' }))
+vi.mock('@/utils/branding', () => ({ updateFavicon: vi.fn() }))
+vi.mock('@/utils/featureFlags', () => ({ FeatureFlags: { subscription: 'subscription' }, isFeatureFlagEnabled: () => false }))
+vi.mock('@/utils/siteBillingMode', () => ({ resolveSiteBillingMode: () => 'recharge_only' }))
+vi.mock('@/components/admin/AdminComplianceDialog.vue', () => ({
+  default: { template: '<div data-testid="admin-confirmation">blocking confirmation</div>' },
+}))
+vi.mock('@/components/common/Toast.vue', () => ({ default: { template: '<div />' } }))
+vi.mock('@/components/common/NavigationProgress.vue', () => ({ default: { template: '<div />' } }))
+vi.mock('@/components/common/AnnouncementPopup.vue', () => ({ default: { template: '<div />' } }))
+
+import App from '../App.vue'
+
+describe('administrator console entry', () => {
+  it('renders the route without fetching or fabricating a legal acknowledgement', async () => {
+    const wrapper = mount(App)
+    await flushPromises()
+    expect(wrapper.find('[data-testid="console-route"]').exists()).toBe(true)
+    expect(wrapper.find('[data-testid="admin-confirmation"]').exists()).toBe(false)
+    window.dispatchEvent(new CustomEvent('admin-compliance-required', { detail: { required: true } }))
+    await flushPromises()
+    expect(compliance.fetchStatus).not.toHaveBeenCalled()
+    expect(compliance.requireAcknowledgement).not.toHaveBeenCalled()
+    expect(compliance.accept).not.toHaveBeenCalled()
+    wrapper.unmount()
+  })
+})
