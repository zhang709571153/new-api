+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/shopspring/decimal"
+)
+
+type RealYuTeamRepository struct {
+	db      *sql.DB
+	enabled bool
+}
+
+func NewRealYuTeamRepository(db *sql.DB, enabled bool) *RealYuTeamRepository {
+	return &RealYuTeamRepository{db, enabled}
+}
+
+type teamActor struct {
+	id         int64
+	admin      bool
+	legacyRole int
+}
+
+func readTeamActor(ctx context.Context, tx *sql.Tx, id int64) (teamActor, error) {
+	a := teamActor{id: id}
+	var role string
+	err := tx.QueryRowContext(ctx, `SELECT u.role,COALESCE(m.source_role,1) FROM users u LEFT JOIN realyu_legacy_user_metadata m ON m.user_id=u.id WHERE u.id=$1 AND u.status='active' AND u.deleted_at IS NULL`, id).Scan(&role, &a.legacyRole)
+	if errors.Is(err, sql.ErrNoRows) {
+		return a, service.ErrRealYuTeamAccess
+	}
+	a.admin = role == "admin"
+	return a, err
+}
+func teamAccess(ctx context.Context, tx *sql.Tx, a teamActor, id int64, write bool) (*service.RealYuTeam, error) {
+	team := new(service.RealYuTeam)
+	suffix := ""
+	if write {
+		suffix = " FOR UPDATE"
+	}
+	err := tx.QueryRowContext(ctx, `SELECT id,owner_user_id,name,closed_at FROM realyu_teams WHERE id=$1`+suffix, id).Scan(&team.ID, &team.OwnerUserID, &team.Name, &team.ClosedAt)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, service.ErrRealYuTeamAccess
+	}
+	if err != nil {
+		return nil, err
+	}
+	team.CanManage = a.admin || a.id == team.OwnerUserID
+	if !team.CanManage && a.legacyRole == 10 {
+		var lower bool
+		err = tx.QueryRowContext(ctx, `SELECT u.role<>'admin' AND COALESCE(m.source_role,1)<10 FROM users u LEFT JOIN realyu_legacy_user_metadata m ON m.user_id=u.id WHERE u.id=$1`, team.OwnerUserID).Scan(&lower)
+		if err != nil {
+			return nil, err
+		}
+		team.CanManage = lower
+	}
+	if !team.CanManage {
+		var member bool
+		err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM realyu_team_members WHERE team_id=$1 AND user_id=$2 AND status<>'removed')`, id, a.id).Scan(&member)
+		if err != nil {
+			return nil, err
+		}
+		if !member {
+			return nil, service.ErrRealYuTeamAccess
+		}
+	}
+	return team, nil
+}
+func (r *RealYuTeamRepository) begin(ctx context.Context, readOnly bool) (*sql.Tx, error) {
+	if !r.enabled {
+		return nil, service.ErrRealYuFundingDisabled
+	}
+	level := sql.LevelReadCommitted
+	if readOnly {
+		level = sql.LevelRepeatableRead
+	}
+	return r.db.BeginTx(ctx, &sql.TxOptions{Isolation: level, ReadOnly: readOnly})
+}
+func (r *RealYuTeamRepository) List(ctx context.Context, actorID int64) ([]service.RealYuTeam, error) {
+	tx, err := r.begin(ctx, true)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, actorID)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT t.id,t.owner_user_id,t.name,t.closed_at,
+      ($2 OR t.owner_user_id=$1 OR ($3=10 AND owner.role<>'admin' AND COALESCE(meta.source_role,1)<10))
+      FROM realyu_teams t JOIN users owner ON owner.id=t.owner_user_id LEFT JOIN realyu_legacy_user_metadata meta ON meta.user_id=owner.id
+      WHERE $2 OR t.owner_user_id=$1 OR ($3=10 AND owner.role<>'admin' AND COALESCE(meta.source_role,1)<10)
+      OR EXISTS(SELECT 1 FROM realyu_team_members m WHERE m.team_id=t.id AND m.user_id=$1 AND m.status<>'removed') ORDER BY t.id`, actorID, a.admin, a.legacyRole)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []service.RealYuTeam{}
+	for rows.Next() {
+		var t service.RealYuTeam
+		if err = rows.Scan(&t.ID, &t.OwnerUserID, &t.Name, &t.ClosedAt, &t.CanManage); err != nil {
+			return nil, err
+		}
+		out = append(out, t)
+	}
+	return out, rows.Err()
+}
+func (r *RealYuTeamRepository) Overview(ctx context.Context, actorID, teamID int64) (*service.RealYuTeamOverview, error) {
+	tx, err := r.begin(ctx, true)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, actorID)
+	if err != nil {
+		return nil, err
+	}
+	team, err := teamAccess(ctx, tx, a, teamID, false)
+	if err != nil {
+		return nil, err
+	}
+	out := &service.RealYuTeamOverview{Team: *team, Members: []service.RealYuTeamMember{}, ViewerID: actorID, QuotaPerUSD: service.RealYuQuotaPerUSD}
+	now := time.Now().Unix()
+	var subID, reset int64
+	rows, err := tx.QueryContext(ctx, fundingSubSelect+` WHERE team_id=$1 AND status='active' AND start_time<=$2 AND end_time>$2 ORDER BY id`, teamID, now)
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		if subID != 0 {
+			rows.Close()
+			return nil, service.ErrRealYuTeamConflict
+		}
+		s, e := scanFundingSubscription(rows)
+		if e != nil {
+			rows.Close()
+			return nil, e
+		}
+		refreshFundingWeek(s, now)
+		subID = s.id
+		reset = s.reset
+		out.WeeklyAvailableQuota = fundingAvailable(s)
+		out.WeeklyResetAt = s.reset
+		out.SubscriptionExpiresAt = s.end
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, err
+	}
+	if subID > 0 {
+		if err = tx.QueryRowContext(ctx, `SELECT purchase_title FROM realyu_funding_subscriptions WHERE id=$1`, subID).Scan(&out.SubscriptionTitle); err != nil {
+			return nil, err
+		}
+	}
+	var payerActive bool
+	if err = tx.QueryRowContext(ctx, `SELECT status='active' AND deleted_at IS NULL FROM users WHERE id=$1`, team.OwnerUserID).Scan(&payerActive); err != nil {
+		return nil, err
+	}
+	if team.ClosedAt != 0 || !payerActive {
+		out.WeeklyAvailableQuota = 0
+	}
+	rows, err = tx.QueryContext(ctx, `WITH historical_actors AS (
+      SELECT actor_user_id AS user_id FROM realyu_legacy_team_usage WHERE team_id=$1
+      UNION SELECT actor_user_id FROM realyu_funding_requests WHERE team_id=$1
+    ), member_list AS (
+      SELECT user_id,status,weekly_cap_quota FROM realyu_team_members WHERE team_id=$1
+      UNION ALL SELECT h.user_id,'removed',0::bigint FROM historical_actors h
+      WHERE NOT EXISTS(SELECT 1 FROM realyu_team_members current WHERE current.team_id=$1 AND current.user_id=h.user_id)
+    ) SELECT m.user_id,COALESCE(NULLIF(u.username,''),'#'||u.id::text),m.status,m.weekly_cap_quota,
+      COALESCE(p.used_quota,0),u.status='active' AND u.deleted_at IS NULL FROM member_list m JOIN users u ON u.id=m.user_id
+      LEFT JOIN realyu_member_period_usage p ON p.team_id=$1 AND p.user_id=m.user_id AND p.subscription_id=$3 AND p.weekly_reset_at=$4
+      WHERE ($2 OR m.user_id=$5) ORDER BY m.user_id`, teamID, team.CanManage, subID, reset, actorID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var m service.RealYuTeamMember
+		var active bool
+		if err = rows.Scan(&m.UserID, &m.Nickname, &m.Status, &m.WeeklyCapQuota, &m.WeeklyUsedQuota, &active); err != nil {
+			return nil, err
+		}
+		m.Owner = m.UserID == team.OwnerUserID
+		m.AvailableQuota = out.WeeklyAvailableQuota
+		if !m.Owner {
+			m.AvailableQuota = min(m.AvailableQuota, max(int64(0), m.WeeklyCapQuota-m.WeeklyUsedQuota))
+		}
+		if m.Status != "active" || !active {
+			m.AvailableQuota = 0
+		}
+		out.Members = append(out.Members, m)
+	}
+	return out, rows.Err()
+}
+func teamAudit(ctx context.Context, tx *sql.Tx, a, team, target int64, action, oldValue, newValue string) error {
+	_, err := tx.ExecContext(ctx, `INSERT INTO realyu_team_audit(actor_user_id,team_id,target_user_id,action,old_value,new_value) VALUES($1,$2,NULLIF($3,0),$4,$5,$6)`, a, team, target, action, oldValue, newValue)
+	return err
+}
+func (r *RealYuTeamRepository) Rename(ctx context.Context, aID, tID int64, name string) error {
+	name = strings.TrimSpace(name)
+	if name == "" || utf8.RuneCountInString(name) > 100 {
+		return service.ErrRealYuTeamInput
+	}
+	tx, err := r.begin(ctx, false)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, aID)
+	if err != nil {
+		return err
+	}
+	team, err := teamAccess(ctx, tx, a, tID, true)
+	if err != nil {
+		return err
+	}
+	if !team.CanManage {
+		return service.ErrRealYuTeamAccess
+	}
+	if _, err = tx.ExecContext(ctx, `UPDATE realyu_teams SET name=$2 WHERE id=$1`, tID, name); err != nil {
+		return err
+	}
+	if err = teamAudit(ctx, tx, aID, tID, 0, "rename", team.Name, name); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+func (r *RealYuTeamRepository) UpdateMember(ctx context.Context, aID, tID, mID int64, change service.RealYuTeamMemberUpdate) error {
+	if mID <= 0 || change.Status == nil && change.WeeklyCapQuota == nil {
+		return service.ErrRealYuTeamInput
+	}
+	if change.WeeklyCapQuota != nil && (*change.WeeklyCapQuota < 0 || *change.WeeklyCapQuota > service.RealYuMaxWalletQuota) {
+		return service.ErrRealYuTeamInput
+	}
+	if change.Status != nil && *change.Status != "active" && *change.Status != "disabled" && *change.Status != "removed" {
+		return service.ErrRealYuTeamInput
+	}
+	tx, err := r.begin(ctx, false)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, aID)
+	if err != nil {
+		return err
+	}
+	team, err := teamAccess(ctx, tx, a, tID, true)
+	if err != nil {
+		return err
+	}
+	if !team.CanManage {
+		return service.ErrRealYuTeamAccess
+	}
+	if team.ClosedAt != 0 || mID == team.OwnerUserID {
+		return service.ErrRealYuTeamConflict
+	}
+	if !a.admin && a.id != team.OwnerUserID {
+		var lower bool
+		err = tx.QueryRowContext(ctx, `SELECT u.role<>'admin' AND COALESCE(m.source_role,1)<10 FROM users u LEFT JOIN realyu_legacy_user_metadata m ON m.user_id=u.id WHERE u.id=$1`, mID).Scan(&lower)
+		if err != nil || !lower {
+			return service.ErrRealYuTeamAccess
+		}
+	}
+	var status string
+	var cap int64
+	err = tx.QueryRowContext(ctx, `SELECT status,weekly_cap_quota FROM realyu_team_members WHERE team_id=$1 AND user_id=$2 FOR UPDATE`, tID, mID).Scan(&status, &cap)
+	if errors.Is(err, sql.ErrNoRows) {
+		return service.ErrRealYuTeamAccess
+	}
+	if err != nil {
+		return err
+	}
+	if status == "removed" {
+		return service.ErrRealYuTeamConflict
+	}
+	old := fmt.Sprintf("%s:%d", status, cap)
+	if change.Status != nil {
+		status = *change.Status
+	}
+	if change.WeeklyCapQuota != nil {
+		cap = *change.WeeklyCapQuota
+	}
+	if _, err = tx.ExecContext(ctx, `UPDATE realyu_team_members SET status=$3,weekly_cap_quota=$4 WHERE team_id=$1 AND user_id=$2`, tID, mID, status, cap); err != nil {
+		return err
+	}
+	// Removal retires existing team credentials. Disabling is reversible and funding admission reads membership on every request.
+	if status == "removed" {
+		if _, err = tx.ExecContext(ctx, `UPDATE api_keys SET status='disabled',deleted_at=NOW(),updated_at=NOW() WHERE id IN(SELECT api_key_id FROM realyu_key_scopes WHERE team_id=$1 AND actor_user_id=$2) AND deleted_at IS NULL`, tID, mID); err != nil {
+			return err
+		}
+	}
+	if err = teamAudit(ctx, tx, aID, tID, mID, "member", old, fmt.Sprintf("%s:%d", status, cap)); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+const realyuTeamUsageCTE = `WITH team_usage AS (
+    SELECT 'native:'||u.id::text AS id,f.actor_user_id AS member_id,COALESCE(NULLIF(u.requested_model,''),u.model) AS model,
+      u.input_tokens::bigint,u.output_tokens::bigint,u.cache_creation_tokens::bigint,u.cache_read_tokens::bigint,
+      f.target_quota::bigint AS cost_quota,COALESCE(u.duration_ms,0)::bigint AS duration_ms,u.created_at
+      FROM usage_logs u JOIN realyu_funding_requests f ON f.request_id=u.request_id AND f.api_key_id=u.api_key_id
+      WHERE f.team_id=$1 AND f.status='settled' AND u.user_id=f.actor_user_id
+    UNION ALL
+    SELECT 'legacy:'||source_log_id::text,actor_user_id,model,input_tokens,output_tokens,0::bigint,0::bigint,cost_quota,duration_ms,created_at
+      FROM realyu_legacy_team_usage WHERE team_id=$1
+  ), filtered AS (SELECT * FROM team_usage WHERE ($2::bigint=0 OR member_id=$2) AND ($3::text='' OR model=$3) AND created_at >= $4 AND created_at < $5) `
+const realyuTeamAggregate = `COUNT(*),COALESCE(SUM(input_tokens),0),COALESCE(SUM(output_tokens),0),COALESCE(SUM(cache_creation_tokens),0),COALESCE(SUM(cache_read_tokens),0),(COALESCE(SUM(cost_quota),0)/500000.0)::text`
+
+func (r *RealYuTeamRepository) Usage(ctx context.Context, aID, tID int64, f service.RealYuTeamUsageFilter) (*service.RealYuTeamUsagePage, error) {
+	if f.MemberID < 0 || len(f.Model) > 200 || f.Page < 1 || f.Page > 100000 || f.PageSize < 1 || f.PageSize > 100 || !f.End.After(f.Start) || f.End.Sub(f.Start) > 31*24*time.Hour {
+		return nil, service.ErrRealYuTeamInput
+	}
+	tx, err := r.begin(ctx, true)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, aID)
+	if err != nil {
+		return nil, err
+	}
+	team, err := teamAccess(ctx, tx, a, tID, false)
+	if err != nil {
+		return nil, err
+	}
+	if !team.CanManage {
+		if f.MemberID != 0 && f.MemberID != aID {
+			return nil, service.ErrRealYuTeamAccess
+		}
+		f.MemberID = aID
+	}
+	args := []any{tID, f.MemberID, f.Model, f.Start, f.End}
+	out := &service.RealYuTeamUsagePage{Items: []service.RealYuTeamUsageItem{}, Breakdown: []service.RealYuTeamUsageBucket{}, Page: f.Page, PageSize: f.PageSize}
+	s := &out.Stats
+	err = tx.QueryRowContext(ctx, realyuTeamUsageCTE+`SELECT `+realyuTeamAggregate+` FROM filtered`, args...).Scan(&s.Requests, &s.InputTokens, &s.OutputTokens, &s.CacheCreationTokens, &s.CacheReadTokens, &s.CostUSD)
+	if err != nil {
+		return nil, err
+	}
+	out.Total = s.Requests
+	rows, err := tx.QueryContext(ctx, realyuTeamUsageCTE+`SELECT f.id,f.member_id,COALESCE(NULLIF(u.username,''),'#'||f.member_id::text),f.model,f.input_tokens,f.output_tokens,f.cache_creation_tokens,f.cache_read_tokens,(f.cost_quota/500000.0)::text,f.duration_ms,f.created_at FROM filtered f LEFT JOIN users u ON u.id=f.member_id ORDER BY f.created_at DESC,f.id DESC LIMIT $6 OFFSET $7`, append(args, f.PageSize, (f.Page-1)*f.PageSize)...)
+	if err != nil {
+		return nil, err
+	}
+	for rows.Next() {
+		var x service.RealYuTeamUsageItem
+		if err = rows.Scan(&x.ID, &x.MemberID, &x.Nickname, &x.Model, &x.InputTokens, &x.OutputTokens, &x.CacheCreationTokens, &x.CacheReadTokens, &x.CostUSD, &x.DurationMS, &x.CreatedAt); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		out.Items = append(out.Items, x)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return nil, err
+	}
+	rows, err = tx.QueryContext(ctx, realyuTeamUsageCTE+`SELECT member_id,COALESCE(NULLIF(u.username,''),'#'||member_id::text),model,`+realyuTeamAggregate+` FROM filtered LEFT JOIN users u ON u.id=member_id GROUP BY member_id,u.username,model ORDER BY member_id,model`, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var b service.RealYuTeamUsageBucket
+		if err = rows.Scan(&b.MemberID, &b.Nickname, &b.Model, &b.Requests, &b.InputTokens, &b.OutputTokens, &b.CacheCreationTokens, &b.CacheReadTokens, &b.CostUSD); err != nil {
+			return nil, err
+		}
+		out.Breakdown = append(out.Breakdown, b)
+	}
+	return out, rows.Err()
+}
+func (r *RealYuTeamRepository) RotateInvite(ctx context.Context, aID, tID int64) (string, error) {
+	tx, err := r.begin(ctx, false)
+	if err != nil {
+		return "", err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, aID)
+	if err != nil {
+		return "", err
+	}
+	team, err := teamAccess(ctx, tx, a, tID, true)
+	if err != nil {
+		return "", err
+	}
+	if !team.CanManage {
+		return "", service.ErrRealYuTeamAccess
+	}
+	if team.ClosedAt != 0 {
+		return "", service.ErrRealYuTeamConflict
+	}
+	random := make([]byte, 32)
+	if _, err = rand.Read(random); err != nil {
+		return "", err
+	}
+	code := hex.EncodeToString(random)
+	sum := sha256.Sum256([]byte(code))
+	_, err = tx.ExecContext(ctx, `INSERT INTO realyu_team_invites(team_id,code_hash) VALUES($1,$2) ON CONFLICT(team_id) DO UPDATE SET code_hash=EXCLUDED.code_hash,expires_at=0,updated_at=NOW()`, tID, hex.EncodeToString(sum[:]))
+	if err != nil {
+		return "", err
+	}
+	if err = teamAudit(ctx, tx, aID, tID, 0, "rotate_invite", "", ""); err != nil {
+		return "", err
+	}
+	if err = tx.Commit(); err != nil {
+		return "", err
+	}
+	return code, nil
+}
+func (r *RealYuTeamRepository) Join(ctx context.Context, aID int64, code string) (*service.RealYuTeamJoinResult, error) {
+	code = strings.TrimSpace(code)
+	if len(code) < 32 || len(code) > 128 {
+		return nil, service.ErrRealYuTeamInput
+	}
+	hash := sha256.Sum256([]byte(code))
+	hashText := hex.EncodeToString(hash[:])
+	tx, err := r.begin(ctx, false)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	_, err = readTeamActor(ctx, tx, aID)
+	if err != nil {
+		return nil, err
+	}
+	var tID, ownerID, closed int64
+	err = tx.QueryRowContext(ctx, `SELECT team_id FROM realyu_team_invites WHERE code_hash=$1 AND (expires_at=0 OR expires_at>$2)`, hashText, time.Now().Unix()).Scan(&tID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, service.ErrRealYuTeamAccess
+	}
+	if err != nil {
+		return nil, err
+	}
+	err = tx.QueryRowContext(ctx, `SELECT owner_user_id,closed_at FROM realyu_teams WHERE id=$1 FOR UPDATE`, tID).Scan(&ownerID, &closed)
+	if err != nil {
+		return nil, err
+	}
+	if closed != 0 {
+		return nil, service.ErrRealYuTeamConflict
+	}
+	var valid bool
+	err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM realyu_team_invites WHERE team_id=$1 AND code_hash=$2 AND (expires_at=0 OR expires_at>$3))`, tID, hashText, time.Now().Unix()).Scan(&valid)
+	if err != nil {
+		return nil, err
+	}
+	if !valid {
+		return nil, service.ErrRealYuTeamAccess
+	}
+	// One active team at a time. Lock the joining identity after the team, matching the funding lock order.
+	var actorState string
+	err = tx.QueryRowContext(ctx, `SELECT status FROM users WHERE id=$1 AND deleted_at IS NULL FOR UPDATE`, aID).Scan(&actorState)
+	if err != nil || actorState != "active" {
+		return nil, service.ErrRealYuTeamAccess
+	}
+	var other bool
+	err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM realyu_team_members WHERE user_id=$1 AND team_id<>$2 AND status<>'removed') OR EXISTS(SELECT 1 FROM realyu_teams WHERE owner_user_id=$1 AND id<>$2 AND closed_at=0)`, aID, tID).Scan(&other)
+	if err != nil {
+		return nil, err
+	}
+	if other {
+		return nil, service.ErrRealYuTeamConflict
+	}
+	var status string
+	err = tx.QueryRowContext(ctx, `SELECT status FROM realyu_team_members WHERE team_id=$1 AND user_id=$2`, tID, aID).Scan(&status)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return nil, err
+	}
+	if status == "disabled" {
+		return nil, service.ErrRealYuTeamAccess
+	}
+	if status == "active" {
+		var keyID int64
+		err = tx.QueryRowContext(ctx, `SELECT k.id FROM api_keys k JOIN realyu_key_scopes s ON s.api_key_id=k.id WHERE s.team_id=$1 AND s.actor_user_id=$2 AND k.deleted_at IS NULL ORDER BY k.id DESC LIMIT 1`, tID, aID).Scan(&keyID)
+		if err == nil {
+			return &service.RealYuTeamJoinResult{TeamID: tID, APIKeyID: keyID}, nil
+		}
+		if !errors.Is(err, sql.ErrNoRows) {
+			return nil, err
+		}
+	}
+	var groupID int64
+	err = tx.QueryRowContext(ctx, `SELECT k.group_id FROM api_keys k JOIN realyu_key_scopes s ON s.api_key_id=k.id JOIN groups g ON g.id=k.group_id JOIN users owner ON owner.id=$2 WHERE s.team_id=$1 AND k.deleted_at IS NULL AND k.status='active' AND g.status='active' AND g.deleted_at IS NULL AND g.subscription_type='standard' AND owner.status='active' AND owner.deleted_at IS NULL ORDER BY (s.actor_user_id=$2) DESC,k.id LIMIT 1`, tID, ownerID).Scan(&groupID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, service.ErrRealYuTeamConflict
+	}
+	if err != nil {
+		return nil, err
+	}
+	random := make([]byte, 32)
+	if _, err = rand.Read(random); err != nil {
+		return nil, err
+	}
+	key := "sk-" + hex.EncodeToString(random)
+	var keyID int64
+	err = tx.QueryRowContext(ctx, `INSERT INTO api_keys(user_id,key,name,group_id,status,quota,quota_used) VALUES($1,$2,$3,$4,'active',0,0) RETURNING id`, aID, key, "RealYu Team", groupID).Scan(&keyID)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO realyu_key_scopes(api_key_id,actor_user_id,payer_user_id,team_id) VALUES($1,$2,$3,$4)`, keyID, aID, ownerID, tID); err != nil {
+		return nil, err
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO user_allowed_groups(user_id,group_id) VALUES($1,$2) ON CONFLICT DO NOTHING`, aID, groupID); err != nil {
+		return nil, err
+	}
+	if _, err = tx.ExecContext(ctx, `INSERT INTO realyu_team_members(team_id,user_id,status,weekly_cap_quota) VALUES($1,$2,'active',0) ON CONFLICT(team_id,user_id) DO UPDATE SET status='active',weekly_cap_quota=CASE WHEN realyu_team_members.status='removed' THEN 0 ELSE realyu_team_members.weekly_cap_quota END`, tID, aID); err != nil {
+		return nil, err
+	}
+	if err = teamAudit(ctx, tx, aID, tID, aID, "join", status, "active"); err != nil {
+		return nil, err
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	return &service.RealYuTeamJoinResult{TeamID: tID, APIKeyID: keyID}, nil
+}
+func (r *RealYuTeamRepository) Leave(ctx context.Context, aID, tID int64) error {
+	tx, err := r.begin(ctx, false)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	a, err := readTeamActor(ctx, tx, aID)
+	if err != nil {
+		return err
+	}
+	team, err := teamAccess(ctx, tx, a, tID, true)
+	if err != nil {
+		return err
+	}
+	if team.OwnerUserID == aID {
+		return service.ErrRealYuTeamConflict
+	}
+	result, err := tx.ExecContext(ctx, `UPDATE realyu_team_members SET status='removed' WHERE team_id=$1 AND user_id=$2 AND status<>'removed'`, tID, aID)
+	if err != nil {
+		return err
+	}
+	n, _ := result.RowsAffected()
+	if n != 1 {
+		return service.ErrRealYuTeamAccess
+	}
+	if _, err = tx.ExecContext(ctx, `UPDATE api_keys SET status='disabled',deleted_at=NOW(),updated_at=NOW() WHERE id IN(SELECT api_key_id FROM realyu_key_scopes WHERE team_id=$1 AND actor_user_id=$2) AND deleted_at IS NULL`, tID, aID); err != nil {
+		return err
+	}
+	if err = teamAudit(ctx, tx, aID, tID, aID, "leave", "", "removed"); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+// Keep all displayed money exact; callers never relabel these USD values as CNY.
+func realyuTeamUSD(quota int64) string {
+	return decimal.NewFromInt(quota).Div(decimal.NewFromInt(service.RealYuQuotaPerUSD)).String()
+}
