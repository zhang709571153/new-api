+from urllib.parse import urlparse
+import uuid
+
+import import_team_history as history
+
+
+def fixture():
+    log = dict(id=1, user_id=1, token_id=12, workspace_team_id=101, model_name="synthetic-model", prompt_tokens=10, completion_tokens=4, quota=123, use_time=2, created_at=1200)
+    code = "a" * 64
+    return {
+        "teams": [dict(id=101, owner_user_id=1, created_at=1000)],
+        "tokens": [dict(id=12, user_id=1, workspace_user_id=2), dict(id=13, user_id=1, workspace_user_id=0)],
+        "logs": [log, {**log, "id": 2, "workspace_team_id": 0}, {**log, "id": 3, "workspace_team_id": -1},
+                 {**log, "id": 4, "workspace_team_id": 0, "created_at": 999}, {**log, "id": 5, "workspace_team_id": 0, "token_id": 13},
+                 {**log, "id": 6, "workspace_team_id": 303}],
+        "invites": [dict(hash=hashlib.sha256(code.encode()).hexdigest(), code=code, team_id=101, expires_at=0, used_by=0)],
+        "diagnostic_log_count": 1,
+    }
+
+
+class HistoryContract(unittest.TestCase):
+    def test_preserves_exact_legacy_team_scope_and_orphans(self):
+        rows, invites, orphans, summary = history.prepare(fixture())
+        self.assertEqual([1, 2], [row[0] for row in rows])
+        self.assertEqual([6], [row[0] for row in orphans])
+        self.assertEqual(2, summary["excluded_personal_or_preteam_rows"])
+        self.assertEqual(1, summary["unattributed_zero_scope_rows"])
+        self.assertEqual(2000, rows[0][7])
+        self.assertEqual(1, len(invites))
+
+    def test_never_assigns_a_mismatched_actor_to_an_existing_team(self):
+        tables = fixture(); tables["tokens"][0]["user_id"] = 99
+        with self.assertRaisesRegex(history.HistoryError, "ATTRIBUTION_MISSING"):
+            history.prepare(tables)
+
+    def test_rejects_corrupted_invite_and_multiple_active_codes(self):
+        tables = fixture(); tables["invites"][0]["code"] = "b" * 64
+        with self.assertRaisesRegex(history.HistoryError, "INVITE_HASH_MISMATCH"):
+            history.prepare(tables)
+        tables = fixture(); tables["invites"].append(copy.deepcopy(tables["invites"][0]))
+        with self.assertRaisesRegex(history.HistoryError, "MULTIPLE_ACTIVE_TEAM_INVITES"):
+            history.prepare(tables)
+
+    def test_expired_and_used_invites_do_not_reopen_access(self):
+        tables = fixture(); tables["invites"][0]["expires_at"] = 1000
+        self.assertEqual([], history.prepare(tables, now=1001)[1])
+        tables = fixture(); tables["invites"][0]["used_by"] = 2
+        self.assertEqual([], history.prepare(tables)[1])
+
+    def test_no_rounding_negative_or_unsafe_cost(self):
+        for value in (-1, 1.5, history.MAX_INTEGER + 1):
+            tables = fixture(); tables["logs"][0]["quota"] = value
+            with self.assertRaisesRegex(history.HistoryError, "INVALID_HISTORY_INTEGER"):
+                history.prepare(tables)
+
+    def test_snapshot_is_read_only_and_detects_hash_or_wal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "sealed.db"
+            with closing(sqlite3.connect(path)) as db:
+                db.executescript("CREATE TABLE workspace_teams(id,owner_user_id,created_at);CREATE TABLE tokens(id,user_id,workspace_user_id);CREATE TABLE workspace_invites(hash,code,team_id,expires_at,used_by);CREATE TABLE logs(id,user_id,token_id,workspace_team_id,model_name,prompt_tokens,completion_tokens,quota,use_time,created_at,type);")
+                db.execute("INSERT INTO workspace_teams VALUES(101,1,1000)")
+                db.commit()
+            digest = history.file_sha(path)
+            data = history.read_snapshot(path, digest)
+            self.assertEqual(1, len(data["teams"]))
+            self.assertEqual(digest, history.file_sha(path))
+            with self.assertRaisesRegex(history.HistoryError, "SHA256_MISMATCH"):
+                history.read_snapshot(path, "0" * 64)
+            Path(str(path) + "-wal").touch()
+            with self.assertRaisesRegex(history.HistoryError, "WITHOUT_WAL"):
+                history.read_snapshot(path, digest)
+
+
+@unittest.skipUnless(os.environ.get("REALYU_TEAM_HISTORY_TEST_DSN"), "explicit isolated PostgreSQL DSN required")
+class HistoryPostgres(unittest.TestCase):
+    def setUp(self):
+        import psycopg
+        from psycopg import sql
+        self.pg, self.sql = psycopg, sql
+        dsn = os.environ["REALYU_TEAM_HISTORY_TEST_DSN"]
+        target = urlparse(dsn)
+        if target.hostname not in ("127.0.0.1", "::1", "localhost") or target.path != "/realyu_funding_e2e":
+            raise RuntimeError("isolated test database required")
+        self.schema = "team_history_" + uuid.uuid4().hex
+        self.base = psycopg.connect(dsn, autocommit=True)
+        self.base.execute(sql.SQL("CREATE SCHEMA {}").format(sql.Identifier(self.schema)))
+        self.conn = psycopg.connect(dsn, autocommit=True, options="-csearch_path=" + self.schema)
+        self.conn.execute("""CREATE TABLE users(id BIGINT PRIMARY KEY,balance NUMERIC NOT NULL DEFAULT 55);
+            CREATE TABLE realyu_teams(id BIGINT PRIMARY KEY,owner_user_id BIGINT,closed_at BIGINT DEFAULT 0);
+            CREATE TABLE realyu_team_members(team_id BIGINT,user_id BIGINT);
+            CREATE TABLE realyu_funding_requests(team_id BIGINT,created_at TIMESTAMPTZ,actor_user_id BIGINT);
+            CREATE TABLE usage_logs(id BIGINT);
+            CREATE TABLE realyu_legacy_identities(source_user_id BIGINT,user_id BIGINT);
+            CREATE TABLE realyu_migration_state(singleton BOOLEAN,installation_id TEXT,phase TEXT,source_sha256 CHAR(64));
+            INSERT INTO users(id) VALUES(201),(202);INSERT INTO realyu_teams VALUES(101,201,0);
+            INSERT INTO realyu_legacy_identities VALUES(1,201),(2,202);
+            INSERT INTO realyu_migration_state VALUES(TRUE,'synthetic-install','staging',repeat('a',64));""")
+        migration = Path(__file__).resolve().parents[2] / "backend/migrations/305_realyu_teams.sql"
+        self.conn.execute(migration.read_text())
+
+    def tearDown(self):
+        self.conn.close()
+        self.base.execute(self.sql.SQL("DROP SCHEMA {} CASCADE").format(self.sql.Identifier(self.schema)))
+        self.base.close()
+
+    def apply(self, tables=None):
+        return history.apply_history(self.conn, tables or fixture(), "a" * 64, "synthetic-install")
+
+    def test_exact_scope_hash_only_invites_no_balance_write_and_replay(self):
+        receipt = self.apply()
+        self.assertEqual(2, receipt["imported_rows"])
+        self.assertEqual(1, receipt["quarantined_rows"])
+        rows = self.conn.execute("SELECT source_log_id,actor_user_id,cost_quota FROM realyu_legacy_team_usage ORDER BY source_log_id").fetchall()
+        self.assertEqual([(1, 202, 123), (2, 202, 123)], rows)
+        self.assertEqual(1, self.conn.execute("SELECT COUNT(*) FROM realyu_legacy_team_usage_orphans WHERE reason_code='SOURCE_TEAM_MISSING'").fetchone()[0])
+        self.assertEqual(110, self.conn.execute("SELECT SUM(balance) FROM users").fetchone()[0])
+        self.assertEqual(hashlib.sha256(("a" * 64).encode()).hexdigest(), self.conn.execute("SELECT code_hash FROM realyu_team_invites").fetchone()[0])
+        self.assertTrue(self.apply()["idempotent_replay"])
+        self.assertEqual(2, self.conn.execute("SELECT COUNT(*) FROM realyu_legacy_team_usage").fetchone()[0])
+
+    def test_active_target_or_wrong_source_rejected_before_writes(self):
+        for field, value in (("phase", "active"), ("source_sha256", "b" * 64), ("installation_id", "other-install")):
+            with self.subTest(field=field):
+                self.conn.execute(self.sql.SQL("UPDATE realyu_migration_state SET {}=%s").format(self.sql.Identifier(field)), (value,))
+                with self.assertRaisesRegex(history.HistoryError, "TARGET_NOT_MATCHING"):
+                    self.apply()
+                self.assertEqual(0, self.conn.execute("SELECT COUNT(*) FROM realyu_legacy_team_usage").fetchone()[0])
+                self.conn.execute("UPDATE realyu_migration_state SET phase='staging',source_sha256=repeat('a',64),installation_id='synthetic-install'")
+
+    def test_business_writes_prevent_a_staging_import(self):
+        self.conn.execute("INSERT INTO usage_logs VALUES(1)")
+        with self.assertRaisesRegex(history.HistoryError, "TARGET_ALREADY_HAS_BUSINESS_WRITES"):
+            self.apply()
+
+    def test_missing_historical_user_rolls_back_everything(self):
+        self.conn.execute("DELETE FROM realyu_legacy_identities WHERE source_user_id=2")
+        with self.assertRaisesRegex(history.HistoryError, "HISTORICAL_MEMBER_IDENTITY_MISSING"):
+            self.apply()
+        self.assertEqual(0, self.conn.execute("SELECT COUNT(*) FROM realyu_team_invites").fetchone()[0])
+        self.assertEqual(0, self.conn.execute("SELECT COUNT(*) FROM realyu_legacy_team_usage").fetchone()[0])
+
+    def test_late_invite_write_failure_rolls_back_history_and_quarantine(self):
+        self.conn.execute("CREATE FUNCTION deny_team_invite() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN RAISE EXCEPTION 'synthetic failure';END$$; CREATE TRIGGER deny_team_invite BEFORE INSERT ON realyu_team_invites FOR EACH ROW EXECUTE FUNCTION deny_team_invite()")
+        with self.assertRaises(self.pg.Error):
+            self.apply()
+        for name in ("realyu_legacy_team_usage", "realyu_legacy_team_usage_orphans", "realyu_team_history_imports"):
+            self.assertEqual(0, self.conn.execute("SELECT COUNT(*) FROM " + name).fetchone()[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
