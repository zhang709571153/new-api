+// RealYu's migrated quota is 500,000 units per USD. Keep edits exact through
+// the integer boundary; display currencies never change the stored unit.
+export function teamQuotaToUSD(quota: number): string {
+  if (!Number.isSafeInteger(quota) || quota < 0) return '—'
+  const micro = BigInt(quota) * 2n
+  const fractional = String(micro % 1_000_000n).padStart(6, '0').replace(/0+$/, '')
+  return `${micro / 1_000_000n}${fractional ? `.${fractional}` : ''}`
+}
+
+export function teamUSDToQuota(value: string): number | null {
+  const match = /^(\d{1,11})(?:\.(\d{1,6}))?$/.exec(value.trim())
+  if (!match) return null
+  const micro = BigInt(match[1]!) * 1_000_000n + BigInt((match[2] || '').padEnd(6, '0'))
+  if (micro % 2n !== 0n || micro / 2n > BigInt(Number.MAX_SAFE_INTEGER)) return null
+  return Number(micro / 2n)
+}
