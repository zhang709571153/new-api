+func (r *usageBillingRepository) RealYuLegacyResponseActor(ctx context.Context, keyID, actorID int64) (int64, int64, error) {
+	if r == nil || r.db == nil || !r.realyuFundingEnabled {
+		return 0, 0, service.ErrRealYuFundingDisabled
+	}
+	var actor, team int64
+	err := r.db.QueryRowContext(ctx, `SELECT i.source_user_id,COALESCE(s.team_id,0)
+        FROM realyu_key_scopes s JOIN realyu_legacy_identities i ON i.user_id=s.actor_user_id
