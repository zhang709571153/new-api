@@ -0,0 +1,62 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+import { configureCustomerCurrency, customerAmountToQuota, customerAmountToUSD, customerMoneyValue, formatCustomerMoney, formatCustomerQuota, quotaToCustomerInput, usdToCustomerInput } from '../customerMoney'
+
+describe('customer CNY presentation with unchanged USD ledger', () => {
+  beforeEach(() => configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7' }))
+  it('converts actual charge once and never reapplies group discount', () => {
+    expect(formatCustomerMoney(0.125)).toBe('¥0.88')
+    expect(formatCustomerMoney('1.005')).toBe('¥7.04')
+    expect(formatCustomerMoney(-0.005)).toBe('¥-0.04')
+    expect(customerMoneyValue(1)).toBe(7)
+    expect(formatCustomerQuota(500000)).toBe('¥7.00')
+  })
+  it('formats exact PostgreSQL aggregate decimal strings without changing their value', () => {
+    expect(formatCustomerMoney('1.7500000000000000')).toBe('¥12.25')
+    expect(formatCustomerMoney('1.00000000000000000000')).toBe('¥7.00')
+    expect(formatCustomerMoney('0.00000000000000000000')).toBe('¥0.00')
+    expect(formatCustomerMoney('0.14285714285714285715', 8)).toBe('¥1.00000000')
+    expect(formatCustomerMoney(0)).toBe('¥0.00')
+    expect(formatCustomerMoney('1.' + '0'.repeat(1001))).toBe('—')
+    // The API display contract does not widen editable input precision.
+    expect(customerAmountToUSD('1.00000000000000000000')).toBeNull()
+  })
+  it('does not turn missing or invalid monetary values into a zero charge', () => {
+    for (const value of [null, undefined, '', ' ', 'NaN', 'Infinity', '1x', '1e3', NaN, Infinity]) {
+      expect(formatCustomerMoney(value)).toBe('—')
+    }
+  })
+  it('converts CNY input at exact native boundaries', () => {
+    expect(customerAmountToUSD('70')).toBe(10)
+    expect(customerAmountToQuota('70')).toBe(5000000)
+    expect(customerAmountToQuota('100')).toBe(7142857)
+    expect(customerAmountToUSD('-7')).toBe(-1)
+    expect(customerAmountToUSD('0.00000001')).toBeNull() // never turn a positive cap into unlimited 0
+  })
+  it('retains every existing integer cap during edit round trips', () => {
+    for (const quota of [0,1,7142857,123456789,9007199254740991]) {
+      expect(customerAmountToQuota(quotaToCustomerInput(quota))).toBe(quota)
+    }
+  })
+  it('keeps native USD 8-decimal values unchanged through editing', () => {
+    for (const rate of ['7','7.123456']) {
+      configureCustomerCurrency({customer_currency:'CNY',customer_usd_to_cny:rate})
+      for (const value of [0.00000001,0.14285714,99.99999999,0,-0.14285714]) expect(customerAmountToUSD(usdToCustomerInput(value))).toBe(value)
+    }
+  })
+  it('does not guess a missing migrated rate', () => {
+    configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '' })
+    expect(formatCustomerMoney(1)).toBe('—')
+    expect(customerAmountToQuota('70')).toBeNull()
+    expect(customerAmountToUSD('70')).toBeNull()
+  })
+  it('supports reviewed rate changes without changing raw ledger values', () => {
+    configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7.25' })
+    expect(formatCustomerMoney(10)).toBe('¥72.50')
+    expect(customerAmountToUSD('72.50')).toBe(10)
+    expect(customerAmountToQuota(quotaToCustomerInput(12345))).toBe(12345)
+  })
+  it('keeps stock USD behavior outside managed deployment', () => {
+    configureCustomerCurrency({ customer_currency: 'USD', customer_usd_to_cny: '1' })
+    expect(formatCustomerMoney(1)).toBe('$1.00')
+  })
+})
