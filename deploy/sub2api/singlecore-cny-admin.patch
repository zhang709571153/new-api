+
+func realyuKeyEnrollmentPG(t *testing.T) (*sql.DB, *dbent.Client) {
+	t.Helper()
+	db := realyuPG(t)
+	// Exercise the real generated Ent create against PG. These are native key
+	// columns only; the actual immutable funding migration is applied by realyuPG.
+	_, err := db.Exec(`CREATE SEQUENCE enrollment_key_id START 1000;
+        ALTER TABLE api_keys ALTER COLUMN id SET DEFAULT nextval('enrollment_key_id');
+        ALTER TABLE api_keys ADD COLUMN key TEXT UNIQUE, ADD COLUMN name TEXT,
+          ADD COLUMN group_id BIGINT, ADD COLUMN created_at TIMESTAMPTZ,
+          ADD COLUMN last_used_at TIMESTAMPTZ, ADD COLUMN ip_whitelist JSONB, ADD COLUMN ip_blacklist JSONB,
+          ADD COLUMN rate_limit_5h NUMERIC DEFAULT 0, ADD COLUMN rate_limit_1d NUMERIC DEFAULT 0,
+          ADD COLUMN rate_limit_7d NUMERIC DEFAULT 0, ADD COLUMN usage_5h NUMERIC DEFAULT 0,
+          ADD COLUMN usage_1d NUMERIC DEFAULT 0, ADD COLUMN usage_7d NUMERIC DEFAULT 0,
+          ADD COLUMN window_5h_start TIMESTAMPTZ, ADD COLUMN window_1d_start TIMESTAMPTZ,
+          ADD COLUMN window_7d_start TIMESTAMPTZ;
+        UPDATE users SET signup_source=CASE id WHEN 1 THEN 'realyu_legacy' WHEN 2 THEN 'realyu_username' ELSE 'email' END`)
+	require.NoError(t, err)
+	return db, dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+}
+
+func enrollmentKey(user int64, name string) *service.APIKey {
+	group := int64(101) // Deliberately matches a team ID; it is NOT a team scope.
+	return &service.APIKey{UserID: user, Key: "synthetic-" + name, Name: name, Status: service.StatusActive, GroupID: &group}
+}
+
+func TestRealYuFundingPGKeyEnrollmentPersonalAndNative(t *testing.T) {
+	db, client := realyuKeyEnrollmentPG(t)
+	r := NewAPIKeyRepository(client, db)
+	ctx := context.Background()
+	for _, user := range []int64{1, 2, 3} {
+		key := enrollmentKey(user, []string{"", "legacy", "username", "native"}[user])
+		require.NoError(t, r.Create(ctx, key))
+		require.GreaterOrEqual(t, key.ID, int64(1000))
+		scope, err := NewRealYuFundingRepository(db, true).Resolve(ctx, key.ID, user)
+		require.NoError(t, err)
+		if user == 3 {
+			require.Nil(t, scope)
+			scope, err = NewRealYuFundingRepository(db, false).Resolve(ctx, key.ID, user)
+			require.NoError(t, err)
+			require.Nil(t, scope)
+		} else {
+			require.Equal(t, &service.RealYuFundingScope{APIKeyID: key.ID, ActorUserID: user, PayerUserID: user}, scope)
+			_, err = NewRealYuFundingRepository(db, false).Resolve(ctx, key.ID, user)
+			require.ErrorIs(t, err, service.ErrRealYuFundingDisabled)
+		}
+	}
+	// Re-applying default enrollment cannot replace an imported member's payer/team.
+	require.NoError(t, enrollRealYuPersonalKey(ctx, db, 12, 2))
+	scope, err := NewRealYuFundingRepository(db, true).Resolve(ctx, 12, 2)
+	require.NoError(t, err)
+	require.Equal(t, &service.RealYuFundingScope{APIKeyID: 12, ActorUserID: 2, PayerUserID: 1, TeamID: 101}, scope)
+}
+
+func TestRealYuFundingPGKeyEnrollmentAtomicRollback(t *testing.T) {
+	db, client := realyuKeyEnrollmentPG(t)
+	r := NewAPIKeyRepository(client, db)
+	ctx := context.Background()
+	// A real SQL failure after Ent inserted the key must roll back the whole key.
+	_, err := db.Exec(`ALTER TABLE realyu_key_scopes ADD CONSTRAINT synthetic_reject_new CHECK(api_key_id<1000)`)
+	require.NoError(t, err)
+	key := enrollmentKey(1, "scope-write-fails")
+	require.Error(t, r.Create(ctx, key))
+	require.Zero(t, key.ID)
+	require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM api_keys WHERE key='synthetic-scope-write-fails'`))
+	_, err = db.Exec(`ALTER TABLE realyu_key_scopes DROP CONSTRAINT synthetic_reject_new`)
+	require.NoError(t, err)
+	for _, injectClient := range []bool{false, true} {
+		t.Run(map[bool]string{false: "context_transaction", true: "injected_transaction_client"}[injectClient], func(t *testing.T) {
+			tx, err := client.Tx(ctx)
+			require.NoError(t, err)
+			defer tx.Rollback()
+			key := enrollmentKey(2, "outer-rollback")
+			if injectClient {
+				err = NewAPIKeyRepository(tx.Client(), db).Create(ctx, key)
+			} else {
+				err = r.Create(dbent.NewTxContext(ctx, tx), key)
+			}
+			require.NoError(t, err)
+			rows, err := tx.Client().QueryContext(ctx, `SELECT COUNT(*) FROM realyu_key_scopes WHERE api_key_id=$1`, key.ID)
+			require.NoError(t, err)
+			require.True(t, rows.Next())
+			var count int
+			require.NoError(t, rows.Scan(&count))
+			require.Equal(t, 1, count)
+			require.NoError(t, rows.Close())
+			require.NoError(t, tx.Rollback())
+			require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM api_keys WHERE key='synthetic-outer-rollback'`))
+			require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM realyu_key_scopes WHERE api_key_id>=1000`))
+		})
+	}
+}
+
+func TestRealYuFundingPGUnmappedManagedKeyFailsClosed(t *testing.T) {
+	db, _ := realyuKeyEnrollmentPG(t)
+	_, err := db.Exec(`INSERT INTO api_keys(id,user_id) VALUES(20,1),(21,1),(22,3),(23,3)`)
+	require.NoError(t, err)
+	ctx := context.Background()
+	for _, enabled := range []bool{false, true} {
+		funds := NewRealYuFundingRepository(db, enabled)
+		_, err = funds.Resolve(ctx, 20, 1)
+		want := service.ErrRealYuFundingScope
+		if !enabled {
+			want = service.ErrRealYuFundingDisabled
+		}
+		require.ErrorIs(t, err, want)
+		billing := NewUsageBillingRepositoryWithRealYuFunding(db, enabled).(*usageBillingRepository)
+		managed, same, err := billing.ValidateRealYuResponseScope(ctx, 20, 21, 1)
+		require.True(t, managed)
+		require.False(t, same)
+		require.ErrorIs(t, err, want)
+		_, err = billing.Apply(ctx, &service.UsageBillingCommand{RequestID: "must-not-native-fallback", APIKeyID: 20, UserID: 1, BalanceCost: 1})
+		if enabled {
+			want = service.ErrRealYuFundingNotReserved
+		}
+		require.ErrorIs(t, err, want)
+		require.Equal(t, "10.00000000", balanceFunding(t, db, 1))
+		require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM usage_billing_dedup`))
+		managed, same, err = billing.ValidateRealYuResponseScope(ctx, 22, 23, 3)
+		require.NoError(t, err)
+		require.False(t, managed)
+		require.True(t, same)
+	}
+	// Native user remains on the stock ledger even in the default-disabled mode.
+	_, err = db.Exec(`UPDATE users SET balance=2 WHERE id=3`)
+	require.NoError(t, err)
+	_, err = NewUsageBillingRepository(nil, db).Apply(ctx, &service.UsageBillingCommand{RequestID: "native-stock-bill", APIKeyID: 22, UserID: 3, BalanceCost: 1})
+	require.NoError(t, err)
+	require.Equal(t, "1.00000000", balanceFunding(t, db, 3))
+}
