+    const w = await createModal(mode === 'negative' ? '-7' : mode === 'tiny-negative' ? '-0.000000001' : '7')
+    if (mode === 'bad-input') {
+      const input = w.findAll('input[type="number"]')[0]!
+      Object.defineProperty(input.element, 'validity', { value: { badInput: true }, configurable: true })
+      await input.setValue('')
+    }
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(mocks.create).not.toHaveBeenCalled()
+    expect(mocks.run).not.toHaveBeenCalled()
+    expect(mocks.showError).toHaveBeenCalledWith('admin.users.amountRequired')
+  })
+
+  it('keeps the dialog open and does not bypass a blocked native step-up', async () => {
+    mocks.run.mockRejectedValueOnce({ code: 'STEP_UP_NOT_ENABLED' })
