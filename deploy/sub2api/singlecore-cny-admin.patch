diff --git a/frontend/src/utils/customerMoney.ts b/frontend/src/utils/customerMoney.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fed292adb445538f69334a3b71c2e807d4b8ca72
--- /dev/null
+++ b/frontend/src/utils/customerMoney.ts
@@ -0,0 +1,96 @@
+import { computed, shallowRef } from 'vue'
+
+type CurrencyConfig = { customer_currency?: string; customer_usd_to_cny?: string }
+const config = shallowRef<CurrencyConfig>({ customer_currency: 'USD', customer_usd_to_cny: '1' })
+
+export function configureCustomerCurrency(value: CurrencyConfig): void {
+  config.value = { customer_currency: value.customer_currency || 'USD', customer_usd_to_cny: value.customer_usd_to_cny || (value.customer_currency === 'CNY' ? '' : '1') }
+}
+export const customerCurrencyCode = computed(() => config.value.customer_currency === 'CNY' ? 'CNY' : 'USD')
+export const customerCurrencySymbol = computed(() => customerCurrencyCode.value === 'CNY' ? '¥' : '$')
+const rate = computed(() => {
+  const value = Number(config.value.customer_usd_to_cny)
+  return Number.isFinite(value) && value > 0 && value <= 1_000_000 ? value : NaN
+})
+export function customerMoneyValue(usd: number | string | null | undefined): number {
+  return Number(usd ?? 0) * rate.value
+}
+export function customerMoneyNumber(usd: number | string | null | undefined, digits = 2): string {
+  if (usd == null || !Number.isInteger(digits) || digits < 0 || digits > 12) return '—'
+  const input = usd
+  const text = typeof input === 'number' && /e/i.test(String(input)) ? input.toFixed(18) : String(input)
+  // PostgreSQL aggregate division may return 20+ decimal places. Parse that
+  // bounded display value exactly; editable amounts keep their original limit.
+  const amount = decimalParts(text, 1000); const exchange = ratio()
+  return amount && exchange ? fixedRounded(amount[0] * exchange[0], amount[1] * exchange[1], digits) : '—'
+}
+export function formatCustomerMoney(usd: number | string | null | undefined, digits = 2): string {
+  const value = customerMoneyNumber(usd, digits)
+  return value === '—' ? value : customerCurrencySymbol.value + value
+}
+function decimalParts(value: string, maxFractionDigits = 18): [bigint, bigint] | null {
+  const text = value.trim()
+  if (text.length > 17 + maxFractionDigits) return null
+  const match = /^([+-]?)(\d{1,15})(?:\.(\d+))?$/.exec(text)
+  if (!match) return null
+  const fraction = match[3] || ''
+  if (fraction.length > maxFractionDigits) return null
+  return [(match[1] === '-' ? -1n : 1n) * BigInt(match[2]! + fraction), 10n ** BigInt(fraction.length)]
+}
+function ratio(): [bigint, bigint] | null {
+  const parsed = decimalParts(config.value.customer_usd_to_cny || '')
+  return parsed && parsed[0] > 0n && Number.isFinite(rate.value) ? parsed : null
+}
+function rounded(numerator: bigint, denominator: bigint): bigint {
+  const sign = numerator < 0n ? -1n : 1n
+  const absolute = numerator < 0n ? -numerator : numerator
+  return sign * ((absolute * 2n + denominator) / (2n * denominator))
+}
+function fixedRounded(numerator: bigint, denominator: bigint, digits: number): string {
+  const scale = 10n ** BigInt(digits)
+  const units = rounded(numerator * scale, denominator)
+  const absolute = units < 0n ? -units : units
+  return `${units < 0n ? '-' : ''}${absolute / scale}${digits ? '.' + String(absolute % scale).padStart(digits, '0') : ''}`
+}
+// Convert customer input once at the API boundary. Native money accepts eight
+// USD decimal places; managed team caps accept integer quota, half away from 0.
+export function customerAmountToUSD(value: string | number): number | null {
+  const amount = decimalParts(String(value)); const exchange = ratio()
+  if (!amount || !exchange) return null
+  const units = rounded(amount[0] * exchange[1] * 100_000_000n, amount[1] * exchange[0])
+  if ((amount[0] !== 0n && units === 0n) || units > BigInt(Number.MAX_SAFE_INTEGER) || units < -BigInt(Number.MAX_SAFE_INTEGER)) return null
+  return Number(units) / 100_000_000
+}
+export function customerAmountToQuota(value: string): number | null {
+  const amount = decimalParts(value); const exchange = ratio()
+  if (!amount || amount[0] < 0n || !exchange) return null
+  const units = rounded(amount[0] * exchange[1] * 500_000n, amount[1] * exchange[0])
+  return units <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(units) : null
+}
+export function quotaToCustomerInput(quota: number): string {
+  const exchange = ratio()
+  if (!Number.isSafeInteger(quota) || quota < 0 || !exchange) return ''
+  // Up to six exchange-rate decimals => twelve customer decimals, exact.
+  const scale = 1_000_000_000_000n
+  const units = BigInt(quota) * exchange[0] * scale / (500_000n * exchange[1])
+  const fraction = String(units % scale).padStart(12, '0').replace(/0+$/, '')
+  return `${units / scale}${fraction ? '.' + fraction : ''}`
+}
+export function formatCustomerQuota(quota: number, digits = 2): string {
+  const exchange = ratio()
+  if (!Number.isSafeInteger(quota) || !exchange || !Number.isInteger(digits) || digits < 0 || digits > 12) return '—'
+  return customerCurrencySymbol.value + fixedRounded(BigInt(quota) * exchange[0], 500_000n * exchange[1], digits)
+}
+
+// Exact text for editing an existing native USD amount without changing it on open.
+export function usdToCustomerInput(usd: number): string {
+  const exchange = ratio()
+  const amount = decimalParts(usd.toFixed(8))
+  if (!exchange || !amount) return ''
+  const scale = 100_000_000_000_000n
+  const units = amount[0] * exchange[0] * scale / (amount[1] * exchange[1])
+  const negative = units < 0n
+  const absolute = negative ? -units : units
+  const fraction = String(absolute % scale).padStart(14, '0').replace(/0+$/, '')
+  return `${negative ? '-' : ''}${absolute / scale}${fraction ? '.' + fraction : ''}`
+}
