+<script setup lang="ts">
+import { computed, onMounted, onUnmounted, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import AppLayout from '@/components/layout/AppLayout.vue'
+import Pagination from '@/components/common/Pagination.vue'
+import { realyuTeamsApi, type RealYuTeam, type RealYuTeamMember, type RealYuTeamOverview, type RealYuTeamUsageFilter, type RealYuTeamUsagePage } from '@/api/realyuTeams'
+import { customerAmountToQuota, customerCurrencyCode, formatCustomerMoney, formatCustomerQuota, quotaToCustomerInput } from '@/utils/customerMoney'
+
+const { t } = useI18n()
+const teams = ref<RealYuTeam[]>([])
+const selectedID = ref(0)
+const overview = ref<RealYuTeamOverview | null>(null)
+const usage = ref<RealYuTeamUsagePage | null>(null)
+const listLoading = ref(true), listFailed = ref(false), teamLoading = ref(false), teamFailed = ref(false)
+const usageLoading = ref(false), usageFailed = ref(false), busy = ref(false)
+const actionError = ref(''), message = ref(''), joinCode = ref(''), inviteCode = ref(''), teamName = ref('')
+const caps = ref<Record<number, string>>({})
+const canManage = computed(() => overview.value?.team.can_manage === true)
+const ownMembership = computed(() => overview.value?.members.some(m => m.user_id === overview.value?.viewer_id && m.status !== 'removed'))
+const filterMember = ref(0), filterModel = ref(''), filterError = ref('')
+function localDate(value: Date) { return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}` }
+const endDate = ref(localDate(new Date()))
+const startDate = ref(localDate(new Date(Date.now() - 6 * 86400000)))
+let listRequest: AbortController | undefined, teamRequest: AbortController | undefined, usageRequest: AbortController | undefined
+let disposed = false
+let appliedFilter: RealYuTeamUsageFilter | null = null
+const money = formatCustomerQuota
+const usdText = formatCustomerMoney
+function unixDate(value: number) { return value ? new Date(value * 1000).toLocaleString() : '—' }
+
+function cancelTeam() {
+  teamRequest?.abort(); usageRequest?.abort()
+  overview.value = null; usage.value = null; inviteCode.value = ''; caps.value = {}
+  teamFailed.value = false; usageFailed.value = false; usageLoading.value = false
+  appliedFilter = null
+}
+async function loadTeams(preferred = selectedID.value) {
+  listRequest?.abort()
+  const request = new AbortController(); listRequest = request
+  listLoading.value = true; listFailed.value = false
+  cancelTeam()
+  try {
+    const value = await realyuTeamsApi.list(request.signal)
+    if (disposed || request.signal.aborted) return
+    teams.value = value
+    const id = value.find(team => team.id === preferred)?.id || value[0]?.id || 0
+    selectedID.value = id
+    if (id) await loadTeam(id)
+  } catch {
+    if (!disposed && !request.signal.aborted) { teams.value = []; listFailed.value = true }
+  } finally {
+    if (!disposed && !request.signal.aborted) listLoading.value = false
+  }
+}
+function changeTeam(event: Event) {
+  const id = Number((event.target as HTMLSelectElement).value)
+  if (!teams.value.some(team => team.id === id)) return
+  selectedID.value = id; message.value = ''; actionError.value = ''
+  void loadTeam(id)
+}
+async function loadTeam(id: number) {
+  cancelTeam()
+  const request = new AbortController(); teamRequest = request
+  teamLoading.value = true; filterMember.value = 0; filterError.value = ''
+  try {
+    const value = await realyuTeamsApi.overview(id, request.signal)
+    if (disposed || request.signal.aborted || selectedID.value !== id) return
+    overview.value = value; teamName.value = value.team.name
+    caps.value = Object.fromEntries(value.members.map(member => [member.user_id, quotaToCustomerInput(member.weekly_cap_quota)]))
+    applyFilter()
+  } catch {
+    if (!disposed && !request.signal.aborted) teamFailed.value = true
+  } finally {
+    if (!disposed && !request.signal.aborted) teamLoading.value = false
+  }
+}
+function applyFilter() {
+  const start = new Date(`${startDate.value}T00:00:00`)
+  const end = new Date(`${endDate.value}T00:00:00`)
+  end.setDate(end.getDate() + 1)
+  if (!Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime()) || end <= start || end.getTime() - start.getTime() > 31 * 86400000) {
+    filterError.value = t('realyuTeams.invalidDates'); return
+  }
+  filterError.value = ''
+  appliedFilter = { start: start.toISOString(), end: end.toISOString(), member_id: canManage.value ? filterMember.value : undefined, model: filterModel.value.trim(), page: 1, page_size: 25 }
+  void loadUsage(1)
+}
+async function loadUsage(page = 1) {
+  if (!overview.value || !appliedFilter) return
+  usageRequest?.abort()
+  const request = new AbortController(); usageRequest = request
+  const id = selectedID.value
+  usageLoading.value = true; usageFailed.value = false; usage.value = null
+  try {
+    const result = await realyuTeamsApi.usage(id, { ...appliedFilter, page }, request.signal)
+    if (!disposed && !request.signal.aborted && selectedID.value === id) usage.value = result
+  } catch {
+    if (!disposed && !request.signal.aborted) usageFailed.value = true
+  } finally {
+    if (!disposed && !request.signal.aborted) usageLoading.value = false
+  }
+}
+async function mutate(action: () => Promise<void>) {
+  if (busy.value) return
+  busy.value = true; actionError.value = ''; message.value = ''
+  try { await action() } catch { if (!disposed) actionError.value = t('realyuTeams.actionFailed') }
+  finally { if (!disposed) busy.value = false }
+}
+async function renameTeam() {
+  const id = selectedID.value, name = teamName.value.trim()
+  if (!canManage.value || !name) return
+  await mutate(async () => { await realyuTeamsApi.rename(id, name); if (!disposed) { message.value = t('realyuTeams.saved'); await loadTeams(id) } })
+}
+async function saveCap(member: RealYuTeamMember) {
+  const value = customerAmountToQuota(caps.value[member.user_id] || '')
+  if (value === null) { actionError.value = t('realyuTeams.invalidCap', { currency: customerCurrencyCode }); return }
+  const id = selectedID.value
+  await mutate(async () => { await realyuTeamsApi.updateMember(id, member.user_id, { weekly_cap_quota: value }); if (!disposed) { message.value = t('realyuTeams.saved'); await loadTeam(id) } })
+}
+async function updateStatus(member: RealYuTeamMember, status: RealYuTeamMember['status']) {
+  if (status === 'removed' && !window.confirm(t('realyuTeams.removeConfirm'))) return
+  const id = selectedID.value
+  await mutate(async () => { await realyuTeamsApi.updateMember(id, member.user_id, { status }); if (!disposed) { message.value = t('realyuTeams.saved'); await loadTeam(id) } })
+}
+async function rotateInvite() {
+  const id = selectedID.value
+  await mutate(async () => { const value = await realyuTeamsApi.invite(id); if (!disposed && selectedID.value === id) inviteCode.value = value })
+}
+async function joinTeam() {
+  const code = joinCode.value.trim()
+  if (code.length < 32 || code.length > 128) return
+  await mutate(async () => { const result = await realyuTeamsApi.join(code); if (!disposed) { joinCode.value = ''; message.value = t('realyuTeams.joined'); await loadTeams(result.team_id) } })
+}
+async function leaveTeam() {
+  if (!window.confirm(t('realyuTeams.leaveConfirm'))) return
+  const id = selectedID.value
+  await mutate(async () => { await realyuTeamsApi.leave(id); if (!disposed) await loadTeams() })
+}
+onMounted(() => { void loadTeams() })
+onUnmounted(() => { disposed = true; listRequest?.abort(); teamRequest?.abort(); usageRequest?.abort(); inviteCode.value = ''; joinCode.value = '' })
+</script>
