@@ -0,0 +1,210 @@
+package handler
+
+import (
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+type RealYuTeamHandler struct{ repo service.RealYuTeamRepository }
+
+func NewRealYuTeamHandler(repo service.RealYuTeamRepository) *RealYuTeamHandler {
+	return &RealYuTeamHandler{repo}
+}
+func teamError(c *gin.Context, err error) {
+	switch {
+	case errors.Is(err, service.ErrRealYuTeamAccess):
+		response.Forbidden(c, "Team access denied")
+	case errors.Is(err, service.ErrRealYuTeamInput):
+		response.BadRequest(c, "Invalid team request")
+	case errors.Is(err, service.ErrRealYuTeamConflict):
+		response.Error(c, 409, "Team state changed or is unavailable for this operation")
+	case errors.Is(err, service.ErrRealYuFundingDisabled):
+		response.Error(c, 503, "Team funding is unavailable")
+	default:
+		response.InternalError(c, "Unable to complete team request")
+	}
+}
+func teamRequestIDs(c *gin.Context) (int64, int64, bool) {
+	subject, ok := middleware.GetAuthSubjectFromContext(c)
+	if !ok {
+		response.Unauthorized(c, "User not authenticated")
+		return 0, 0, false
+	}
+	id := int64(0)
+	if raw := c.Param("team_id"); raw != "" {
+		var err error
+		id, err = strconv.ParseInt(raw, 10, 64)
+		if err != nil || id <= 0 {
+			teamError(c, service.ErrRealYuTeamInput)
+			return 0, 0, false
+		}
+	}
+	c.Header("Cache-Control", "no-store")
+	return subject.UserID, id, true
+}
+func (h *RealYuTeamHandler) List(c *gin.Context) {
+	actor, _, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	v, err := h.repo.List(c.Request.Context(), actor)
+	if err != nil {
+		teamError(c, err)
+		return
+	}
+	response.Success(c, v)
+}
+func (h *RealYuTeamHandler) Overview(c *gin.Context) {
+	actor, team, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	v, err := h.repo.Overview(c.Request.Context(), actor, team)
+	if err != nil {
+		teamError(c, err)
+		return
+	}
+	response.Success(c, v)
+}
+func (h *RealYuTeamHandler) Rename(c *gin.Context) {
+	actor, team, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	var req struct {
+		Name string `json:"name"`
+	}
+	if c.ShouldBindJSON(&req) != nil {
+		teamError(c, service.ErrRealYuTeamInput)
+		return
+	}
+	if err := h.repo.Rename(c.Request.Context(), actor, team, req.Name); err != nil {
+		teamError(c, err)
+		return
+	}
+	middleware.SetAuditAction(c, "realyu.team.rename")
+	response.Success(c, nil)
+}
+func (h *RealYuTeamHandler) UpdateMember(c *gin.Context) {
+	actor, team, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	id, err := strconv.ParseInt(c.Param("member_id"), 10, 64)
+	if err != nil || id <= 0 {
+		teamError(c, service.ErrRealYuTeamInput)
+		return
+	}
+	var req service.RealYuTeamMemberUpdate
+	if c.ShouldBindJSON(&req) != nil {
+		teamError(c, service.ErrRealYuTeamInput)
+		return
+	}
+	if err = h.repo.UpdateMember(c.Request.Context(), actor, team, id, req); err != nil {
+		teamError(c, err)
+		return
+	}
+	middleware.SetAuditAction(c, "realyu.team.member")
+	response.Success(c, nil)
+}
+func parseTeamUsageFilter(c *gin.Context) (service.RealYuTeamUsageFilter, error) {
+	now := time.Now().UTC()
+	f := service.RealYuTeamUsageFilter{Start: now.Add(-7 * 24 * time.Hour), End: now, Page: 1, PageSize: 25, Model: c.Query("model")}
+	for key, dest := range map[string]*int{"page": &f.Page, "page_size": &f.PageSize} {
+		if raw := c.Query(key); raw != "" {
+			n, err := strconv.Atoi(raw)
+			if err != nil {
+				return f, service.ErrRealYuTeamInput
+			}
+			*dest = n
+		}
+	}
+	if raw := c.Query("member_id"); raw != "" {
+		n, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil {
+			return f, service.ErrRealYuTeamInput
+		}
+		f.MemberID = n
+	}
+	for key, dest := range map[string]*time.Time{"start": &f.Start, "end": &f.End} {
+		if raw := c.Query(key); raw != "" {
+			v, err := time.Parse(time.RFC3339, raw)
+			if err != nil {
+				return f, service.ErrRealYuTeamInput
+			}
+			*dest = v
+		}
+	}
+	if f.MemberID < 0 || len(f.Model) > 200 || f.Page < 1 || f.Page > 100000 || f.PageSize < 1 || f.PageSize > 100 || !f.End.After(f.Start) || f.End.Sub(f.Start) > 31*24*time.Hour {
+		return f, service.ErrRealYuTeamInput
+	}
+	return f, nil
+}
+func (h *RealYuTeamHandler) Usage(c *gin.Context) {
+	actor, team, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	f, err := parseTeamUsageFilter(c)
+	if err != nil {
+		teamError(c, err)
+		return
+	}
+	v, err := h.repo.Usage(c.Request.Context(), actor, team, f)
+	if err != nil {
+		teamError(c, err)
+		return
+	}
+	response.Success(c, v)
+}
+func (h *RealYuTeamHandler) RotateInvite(c *gin.Context) {
+	actor, team, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	code, err := h.repo.RotateInvite(c.Request.Context(), actor, team)
+	if err != nil {
+		teamError(c, err)
+		return
+	}
+	middleware.SetAuditAction(c, "realyu.team.invite.rotate")
+	response.Success(c, map[string]string{"code": code})
+}
+func (h *RealYuTeamHandler) Join(c *gin.Context) {
+	actor, _, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	var req struct {
+		Code string `json:"code"`
+	}
+	if c.ShouldBindJSON(&req) != nil {
+		teamError(c, service.ErrRealYuTeamInput)
+		return
+	}
+	v, err := h.repo.Join(c.Request.Context(), actor, req.Code)
+	if err != nil {
+		teamError(c, err)
+		return
+	}
+	middleware.SetAuditAction(c, "realyu.team.join")
+	response.Success(c, v)
+}
+func (h *RealYuTeamHandler) Leave(c *gin.Context) {
+	actor, team, ok := teamRequestIDs(c)
+	if !ok {
+		return
+	}
+	if err := h.repo.Leave(c.Request.Context(), actor, team); err != nil {
+		teamError(c, err)
+		return
+	}
+	middleware.SetAuditAction(c, "realyu.team.leave")
+	response.Success(c, nil)
+}
