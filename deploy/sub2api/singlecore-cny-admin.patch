+)
+
+func legacyInboxPG(t *testing.T) *sql.DB {
+	t.Helper()
+	db := realyuPG(t)
+	_, err := db.Exec(`CREATE TABLE realyu_legacy_records(source_table TEXT,source_key TEXT,row_sha256 CHAR(64),source_row JSONB,snapshot_sha256 CHAR(64),PRIMARY KEY(source_table,source_key))`)
+	require.NoError(t, err)
+	migration, err := os.ReadFile("../../migrations/304_realyu_legacy_payment_inbox.sql")
+	require.NoError(t, err)
+	_, err = db.Exec(string(migration))
+	require.NoError(t, err)
+	return db
+}
+func insertLegacyInboxOrder(t *testing.T, db *sql.DB, table, key, trade, status, method string, price int64) {
+	t.Helper()
+	row := map[string]any{"trade_no": trade, "status": status, "payment_method": method, "price_cents": price, "payment_provider": "epay", "money": json.Number("12.34"), "user_id": 1, "kind": "paygo", "plan_snapshot": "retained-original"}
+	raw, err := json.Marshal(row)
+	require.NoError(t, err)
+	_, err = db.Exec(`INSERT INTO realyu_legacy_records VALUES($1,$2,$3,$4,$5)`, table, key, strings.Repeat("b", 64), raw, strings.Repeat("c", 64))
+	require.NoError(t, err)
+}
+func legacyInboxEvent() service.RealYuLegacyPaymentEvent {
+	return service.RealYuLegacyPaymentEvent{MerchantID: "synthetic", ProviderTradeNo: "provider01", OrderTradeNo: "RYsynthetic", SourceTable: "billing_orders", PaymentMethod: "alipay", PaidCents: 1234, EventSHA256: strings.Repeat("e", 64), PayloadSHA256: strings.Repeat("d", 64)}
+}
+func TestRealYuLegacyInboxPGConcurrentDurabilityNoFulfillment(t *testing.T) {
+	db := legacyInboxPG(t)
+	insertLegacyInboxOrder(t, db, "billing_orders", "1", "RYsynthetic", "pending", "epay:alipay", 1234)
+	r := NewRealYuLegacyPaymentRepository(db)
+	var wg sync.WaitGroup
+	errs := make(chan error, 24)
+	for i := 0; i < 24; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			receipt, err := r.RecordVerified(context.Background(), legacyInboxEvent())
+			if err == nil && receipt.Status != "pending_review" {
+				err = service.ErrRealYuLegacyPaymentBlocked
+			}
+			errs <- err
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	require.EqualValues(t, 1, intFunding(t, db, `SELECT COUNT(*) FROM realyu_legacy_payment_inbox`))
+	require.EqualValues(t, 24, intFunding(t, db, `SELECT deliveries FROM realyu_legacy_payment_inbox`))
+	require.Equal(t, "10.00000000", balanceFunding(t, db, 1))
+	require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM realyu_funding_subscriptions`))
+	r = NewRealYuLegacyPaymentRepository(db)
+	receipt, err := r.RecordVerified(context.Background(), legacyInboxEvent())
+	require.NoError(t, err)
+	require.Equal(t, "pending_review", receipt.Status)
+	require.EqualValues(t, 25, intFunding(t, db, `SELECT deliveries FROM realyu_legacy_payment_inbox`))
+	var status, snapshot string
+	require.NoError(t, db.QueryRow(`SELECT source_row->>'status',source_row->>'plan_snapshot' FROM realyu_legacy_records`).Scan(&status, &snapshot))
+	require.Equal(t, "pending", status)
+	require.Equal(t, "retained-original", snapshot)
+}
+func TestRealYuLegacyInboxPGUnknownMismatchAndConflicts(t *testing.T) {
+	db := legacyInboxPG(t)
+	r := NewRealYuLegacyPaymentRepository(db)
+	e := legacyInboxEvent()
+	receipt, err := r.RecordVerified(context.Background(), e)
+	require.NoError(t, err)
+	require.Equal(t, "UNKNOWN_LEGACY_ORDER", receipt.ReasonCode)
+	insertLegacyInboxOrder(t, db, "billing_orders", "1", "RYsynthetic", "pending", "epay:alipay", 1234)
+	receipt, err = r.RecordVerified(context.Background(), e)
+	require.NoError(t, err)
+	require.Equal(t, "pending_review", receipt.Status)
+	e.PaidCents = 1235
+	e.EventSHA256 = strings.Repeat("f", 64)
+	receipt, err = r.RecordVerified(context.Background(), e)
+	require.NoError(t, err)
+	require.Equal(t, "SIGNED_EVENT_CONFLICT", receipt.ReasonCode)
+	require.EqualValues(t, 1, intFunding(t, db, `SELECT COUNT(*) FROM realyu_legacy_payment_conflicts`))
+	require.EqualValues(t, 1234, intFunding(t, db, `SELECT paid_cents FROM realyu_legacy_payment_inbox`))
+	e = legacyInboxEvent()
+	receipt, err = r.RecordVerified(context.Background(), e)
+	require.NoError(t, err)
+	require.Equal(t, "blocked", receipt.Status)
+	e.ProviderTradeNo = "provider02"
+	e.EventSHA256 = strings.Repeat("a", 64)
+	receipt, err = r.RecordVerified(context.Background(), e)
+	require.NoError(t, err)
+	require.Equal(t, "MULTIPLE_PROVIDER_TRANSACTIONS", receipt.ReasonCode)
+	require.EqualValues(t, 2, intFunding(t, db, `SELECT COUNT(*) FROM realyu_legacy_payment_inbox WHERE status='blocked'`))
+	require.Equal(t, "10.00000000", balanceFunding(t, db, 1))
+}
+func TestRealYuLegacyInboxPGArchivedKindsAndAtomicFailure(t *testing.T) {
+	for _, tc := range []struct {
+		name, table, status, method, expected string
+		price                                 int64
+	}{
+		{"billing_paid", "billing_orders", "paid", "epay:alipay", "already_fulfilled", 1234},
+		{"billing_wallet", "billing_orders", "wallet_credited", "epay:alipay", "already_fulfilled", 1234},
+		{"wrong_amount", "billing_orders", "pending", "epay:alipay", "blocked", 1235},
+		{"wrong_method", "billing_orders", "pending", "epay:wxpay", "blocked", 1234},
+		{"wrong_rail", "billing_orders", "pending", "balance", "blocked", 1234},
+		{"subscription_pending", "subscription_orders", "pending", "alipay", "pending_review", 0},
+		{"subscription_success", "subscription_orders", "success", "alipay", "already_fulfilled", 0},
+		{"subscription_cancelled", "subscription_orders", "expired", "alipay", "blocked", 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			db := legacyInboxPG(t)
+			insertLegacyInboxOrder(t, db, tc.table, "1", "RYsynthetic", tc.status, tc.method, tc.price)
+			e := legacyInboxEvent()
+			e.SourceTable = tc.table
+			r, err := NewRealYuLegacyPaymentRepository(db).RecordVerified(context.Background(), e)
+			require.NoError(t, err)
+			require.Equal(t, tc.expected, r.Status)
+			require.Equal(t, "10.00000000", balanceFunding(t, db, 1))
+		})
+	}
+	db := legacyInboxPG(t)
+	insertLegacyInboxOrder(t, db, "billing_orders", "1", "RYsynthetic", "pending", "epay:alipay", 1234)
+	_, err := db.Exec(`ALTER TABLE realyu_legacy_payment_inbox ADD CONSTRAINT synthetic_write_failure CHECK(status<>'pending_review')`)
+	require.NoError(t, err)
+	_, err = NewRealYuLegacyPaymentRepository(db).RecordVerified(context.Background(), legacyInboxEvent())
+	require.Error(t, err)
+	require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM realyu_legacy_payment_inbox`))
+}
