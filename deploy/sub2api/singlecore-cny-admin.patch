+// Explicit private test DSN only; never discovers a runtime/production DB.
+func realyuPG(t *testing.T) *sql.DB {
+	t.Helper()
+	raw := os.Getenv("REALYU_FUNDING_TEST_DSN")
+	if raw == "" {
+		t.Fatal("REALYU_FUNDING_TEST_DSN is required; no implicit production/default connection")
+	}
+	u, err := url.Parse(raw)
+	require.NoError(t, err)
+	require.Contains(t, []string{"127.0.0.1", "localhost", "::1"}, u.Hostname())
+	require.Equal(t, "/realyu_funding_e2e", u.Path)
+	base, err := sql.Open("postgres", raw)
+	require.NoError(t, err)
+	defer base.Close()
+	schema := fmt.Sprintf("funding_%d", time.Now().UnixNano())
+	_, err = base.Exec(`CREATE SCHEMA ` + schema)
+	require.NoError(t, err)
+	q := u.Query()
+	q.Set("search_path", schema)
+	u.RawQuery = q.Encode()
+	db, err := sql.Open("postgres", u.String())
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		db.Close()
+		base, e := sql.Open("postgres", raw)
+		if e == nil {
+			defer base.Close()
+			_, _ = base.Exec(`DROP SCHEMA ` + schema + ` CASCADE`)
+		}
+	})
+	_, err = db.Exec(`CREATE TABLE users(id BIGINT PRIMARY KEY,balance NUMERIC(20,8) NOT NULL DEFAULT 0,status TEXT NOT NULL DEFAULT 'active',signup_source TEXT NOT NULL DEFAULT 'email',deleted_at TIMESTAMPTZ,updated_at TIMESTAMPTZ);
+        CREATE TABLE api_keys(id BIGINT PRIMARY KEY,user_id BIGINT NOT NULL REFERENCES users(id),status TEXT NOT NULL DEFAULT 'active',expires_at TIMESTAMPTZ,quota NUMERIC(20,8) NOT NULL DEFAULT 0,quota_used NUMERIC(20,8) NOT NULL DEFAULT 0,deleted_at TIMESTAMPTZ,updated_at TIMESTAMPTZ);
+        CREATE TABLE usage_billing_dedup(id BIGSERIAL PRIMARY KEY,request_id TEXT NOT NULL,api_key_id BIGINT NOT NULL,request_fingerprint TEXT NOT NULL,UNIQUE(request_id,api_key_id));
+        CREATE TABLE usage_billing_dedup_archive(LIKE usage_billing_dedup INCLUDING ALL);`)
+	require.NoError(t, err)
+	migration, err := os.ReadFile("../../migrations/301_realyu_funding.sql")
+	require.NoError(t, err)
+	_, err = db.Exec(string(migration))
+	require.NoError(t, err)
+	_, err = db.Exec(`INSERT INTO users(id,balance) VALUES(1,10),(2,10),(3,0);INSERT INTO api_keys(id,user_id) VALUES(11,1),(12,2),(13,3),(14,2);
+        INSERT INTO realyu_teams(id,owner_user_id,name,historical_quota) VALUES(101,1,'synthetic',9999),(102,1,'separate',9999);
+        INSERT INTO realyu_team_members(team_id,user_id,weekly_cap_quota) VALUES(101,1,0),(101,2,400),(101,3,400),(102,2,400);
+        INSERT INTO realyu_key_scopes(api_key_id,actor_user_id,payer_user_id,team_id) VALUES(11,1,1,NULL),(12,2,1,101),(13,3,1,101),(14,2,1,102)`)
+	require.NoError(t, err)
+	return db
+}
