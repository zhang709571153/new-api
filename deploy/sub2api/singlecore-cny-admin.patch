diff --git a/backend/internal/web/realyu_brand_test.go b/backend/internal/web/realyu_brand_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c39e39d8f30abdee9a7ad08dd5b0623311e8341c
--- /dev/null
+++ b/backend/internal/web/realyu_brand_test.go
@@ -0,0 +1,35 @@
+//go:build embed
+
+package web
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestRealYuFaviconRequiresExplicitLocalWordmark(t *testing.T) {
+	const html = `<html><head><title>Sub2API - AI API Gateway</title><link rel="icon" href="/logo.svg" /></head></html>`
+	for _, tc := range []struct{ logo, want string }{
+		{"/brand/realyu-wordmark.png?v=20260924-2", "/brand/favicon.ico"},
+		{"/brand/realyu-wordmark.png", "/brand/favicon.ico"},
+		{"/custom-logo.png", "/custom-logo.png"},
+		{"https://custom.example/brand/realyu-wordmark.png", "https://custom.example/brand/realyu-wordmark.png"},
+		{"", "/logo.svg"},
+		{"javascript:alert(1)", "/logo.svg"},
+	} {
+		t.Run(tc.logo, func(t *testing.T) {
+			settings, err := json.Marshal(map[string]string{"site_logo": tc.logo})
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := string(injectSiteFavicon([]byte(html), settings))
+			if !strings.Contains(got, `href="`+tc.want+`"`) {
+				t.Fatalf("unexpected favicon: %s", got)
+			}
+			if !strings.Contains(got, `<title>Sub2API - AI API Gateway</title>`) {
+				t.Fatal("favicon mapping changed the upstream title")
+			}
+		})
+	}
+}
