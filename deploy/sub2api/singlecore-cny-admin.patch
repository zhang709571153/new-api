+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { enableAutoUnmount, flushPromises, mount } from '@vue/test-utils'
+import { nextTick } from 'vue'
+import AccountStatsModal from '../AccountStatsModal.vue'
+import AdminAccountStatsModal from '@/components/admin/account/AccountStatsModal.vue'
+import AccountTodayStatsCell from '../AccountTodayStatsCell.vue'
+import { configureCustomerCurrency } from '@/utils/customerMoney'
+import type { Account, AccountUsageStatsResponse } from '@/types'
+
+const { getStats } = vi.hoisted(() => ({ getStats: vi.fn() }))
+vi.mock('@/api/admin', () => ({ adminAPI: { accounts: { getStats } } }))
+vi.mock('vue-i18n', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('vue-i18n')>()),
+  useI18n: () => ({ t: (key: string) => key }),
+}))
+vi.mock('vue-chartjs', () => ({
+  Line: { name: 'LineChartStub', props: ['data', 'options'], template: '<div />' },
+  Doughnut: { template: '<div />' },
+}))
+enableAutoUnmount(afterEach)
+
+const stats: AccountUsageStatsResponse = {
+  history: [{ date: '2026-10-10', label: '10-10', requests: 3, tokens: 200, cost: 20, actual_cost: 4, user_cost: 0.5 }],
+  summary: {
+    days: 30, actual_days_used: 10, total_cost: 10, total_user_cost: 1.25, total_standard_cost: 20,
+    total_requests: 30, total_tokens: 2000, avg_daily_cost: 1, avg_daily_user_cost: 0.125,
+    avg_daily_requests: 3, avg_daily_tokens: 200, avg_duration_ms: 100,
+    today: { date: '2026-10-10', cost: 4, user_cost: 0.5, requests: 3, tokens: 200 },
+    highest_cost_day: { date: '2026-10-09', label: '10-09', cost: 5, user_cost: 0.75, requests: 4 },
+    highest_request_day: { date: '2026-10-08', label: '10-08', cost: 3, user_cost: 1, requests: 5 },
+  },
+  models: [], endpoints: [], upstream_endpoints: [],
+}
+
+beforeEach(() => {
+  configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7' })
+  getStats.mockReset().mockResolvedValue(structuredClone(stats))
+})
+
+describe('account table customer spend', () => {
+  it('uses customer currency for billed spend while keeping the supplier amount in USD', async () => {
+    const w = mount(AccountTodayStatsCell, { props: { stats: { requests: 3, tokens: 500, cost: 4, standard_cost: 10, user_cost: 0.5 } } })
+    expect(w.text()).toContain('usage.accountBilled (USD):')
+    expect(w.text()).toContain('usage.userBilled (CNY):')
+    expect(w.text()).toContain('$4.00')
+    expect(w.text()).toContain('¥3.50')
+    configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7.5' })
+    await nextTick()
+    expect(w.text()).toContain('¥3.75')
+    expect(w.text()).toContain('$4.00')
+  })
+
+  it('keeps missing user cost hidden and an explicit zero visible', async () => {
+    const data = { requests: 0, tokens: 0, cost: 0, standard_cost: 0 }
+    const w = mount(AccountTodayStatsCell, { props: { stats: data } })
+    expect(w.text()).not.toContain('usage.userBilled')
+    await w.setProps({ stats: { ...data, user_cost: 0 } })
+    expect(w.text()).toContain('usage.userBilled (CNY)')
+    expect(w.text()).toContain('¥0.00')
+  })
+})
+
+describe.each([
+  ['shared account modal', AccountStatsModal],
+  ['admin account modal', AdminAccountStatsModal],
+] as const)('%s currencies', (_name, component) => {
+  async function openModal() {
+    const w = mount(component, {
+      props: { show: false, account: { id: 1, name: 'fixture', status: 'active' } as Account },
+      global: { stubs: {
+        BaseDialog: { template: '<div><slot /><slot name="footer" /></div>' },
+        LoadingSpinner: true, Icon: true, ModelDistributionChart: true, EndpointDistributionChart: true,
+      } },
+    })
+    await w.setProps({ show: true }); await flushPromises()
+    return w
+  }
+
+  it('converts every billed customer summary and leaves supplier/reference money in USD', async () => {
+    const w = await openModal()
+    for (const amount of ['¥8.7500', '¥0.8750', '¥3.5000', '¥5.2500', '¥7.0000']) {
+      expect(w.text()).toContain(amount)
+    }
+    expect(w.text()).toContain('usage.userBilled (CNY)')
+    expect(w.text()).toContain('usage.accountBilled (USD)')
+    expect(w.text()).toContain('$10.00')
+    expect(w.text()).toContain('admin.accounts.stats.standardCost (USD): $20.00')
+    expect(getStats).toHaveBeenCalledWith(1, 30)
+  })
+
+  it('uses one raw USD coordinate system with explicit equivalent customer ticks and correct tooltips', async () => {
+    const w = await openModal()
+    const chart = w.getComponent({ name: 'LineChartStub' })
+    const data = chart.props('data')
+    const options = chart.props('options')
+    expect(data.datasets.map((item: { data: number[] }) => item.data)).toEqual([[4], [0.5], [3]])
+    expect(data.datasets[1].label).toBe('usage.userBilled (CNY)')
+    const tooltip = options.plugins.tooltip.callbacks.label
+    expect(tooltip({ datasetIndex: 0, dataset: data.datasets[0], raw: 4 })).toBe('usage.accountBilled (USD): $4.00')
+    expect(tooltip({ datasetIndex: 1, dataset: data.datasets[1], raw: 0.5 })).toBe('usage.userBilled (CNY): ¥3.5000')
+    expect(tooltip({ datasetIndex: 2, dataset: data.datasets[2], raw: 3 })).toBe('admin.accounts.stats.requests: 3')
+    expect(options.scales.y.title.text).toBe('USD / CNY')
+    expect(options.scales.y.ticks.callback(1)).toBe('$1.00 / ¥7.00')
+    expect(options.scales.y1.ticks.callback(3)).toBe('3')
+
+    configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7.5' })
+    await nextTick()
+    const updated = chart.props('options')
+    expect(updated.scales.y.ticks.callback(1)).toBe('$1.00 / ¥7.50')
+    expect(updated.plugins.tooltip.callbacks.label({ datasetIndex: 1, dataset: chart.props('data').datasets[1], raw: 0.5 }))
+      .toBe('usage.userBilled (CNY): ¥3.7500')
+    expect(chart.props('data').datasets[1].data).toEqual([0.5])
+  })
+
+  it('keeps native USD mode without duplicating the monetary tick', async () => {
+    configureCustomerCurrency({ customer_currency: 'USD', customer_usd_to_cny: '1' })
+    const w = await openModal()
+    const chart = w.getComponent({ name: 'LineChartStub' })
+    expect(chart.props('data').datasets[1].label).toBe('usage.userBilled (USD)')
+    expect(chart.props('options').scales.y.title.text).toBe('USD')
+    expect(chart.props('options').scales.y.ticks.callback(1)).toBe('$1.00')
+    expect(w.text()).toContain('$1.2500')
+  })
+})
