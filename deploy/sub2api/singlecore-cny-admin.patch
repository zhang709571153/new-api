+-- Offline customer-import receipts. No HTTP endpoint creates or activates them.
+CREATE TABLE realyu_legacy_user_metadata (
+    user_id BIGINT PRIMARY KEY REFERENCES users(id),
+    source_role INTEGER NOT NULL CHECK (source_role IN (1,10,100))
+);
+CREATE TABLE realyu_migration_state (
+    singleton BOOLEAN PRIMARY KEY DEFAULT TRUE CHECK (singleton),
+    installation_id TEXT NOT NULL,
+    phase TEXT NOT NULL DEFAULT 'staging' CHECK (phase IN ('staging','active')),
+    source_sha256 CHAR(64),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE realyu_migration_runs (
+    operation_id TEXT PRIMARY KEY,
+    source_sha256 CHAR(64) NOT NULL,
+    mapping_sha256 CHAR(64) NOT NULL,
+    receipt JSONB NOT NULL,
+    applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE realyu_legacy_keys (
+    source_token_id BIGINT PRIMARY KEY,
+    api_key_id BIGINT NOT NULL UNIQUE REFERENCES api_keys(id),
+    source_actor_id BIGINT NOT NULL,
+    source_payer_id BIGINT NOT NULL,
+    legacy_team_id BIGINT NOT NULL DEFAULT 0,
+    model_limits_enabled BOOLEAN NOT NULL DEFAULT FALSE,
+    model_limits JSONB NOT NULL DEFAULT '{}',
+    unlimited_quota BOOLEAN NOT NULL,
+    opening_used_quota BIGINT NOT NULL,
+    opening_remaining_quota BIGINT NOT NULL,
+    CHECK (opening_used_quota BETWEEN 0 AND 9007199254740991),
+    CHECK (abs(opening_remaining_quota) <= 9007199254740991)
+);
+-- Historical orders/entitlements are preserved, never silently converted into
+-- a new paid purchase. A later payment adapter must explicitly claim fulfillment.
+CREATE TABLE realyu_legacy_records (
+    source_table TEXT NOT NULL,
+    source_key TEXT NOT NULL,
+    row_sha256 CHAR(64) NOT NULL,
+    source_row JSONB NOT NULL,
+    snapshot_sha256 CHAR(64) NOT NULL,
+    PRIMARY KEY (source_table, source_key)
+);
diff --git a/backend/migrations/304_realyu_legacy_payment_inbox.sql b/backend/migrations/304_realyu_legacy_payment_inbox.sql
new file mode 100644
index 0000000000000000000000000000000000000000..2ecc8a5daae1ad74c56236da7d92e145374e0031
--- /dev/null
+++ b/backend/migrations/304_realyu_legacy_payment_inbox.sql
@@ -0,0 +1,34 @@
+-- Receive-only takeover of signed legacy EasyPay/ZPay callbacks.
+-- A receipt is NOT fulfillment. No wallet/subscription/order is changed here.
+-- Keep this table across final snapshot imports and operational restores.
+CREATE TABLE realyu_legacy_payment_inbox (
+    id BIGSERIAL PRIMARY KEY,
+    merchant_id TEXT NOT NULL CHECK (length(merchant_id) BETWEEN 1 AND 128),
+    provider_trade_no TEXT NOT NULL CHECK (length(provider_trade_no) BETWEEN 1 AND 128),
+    order_trade_no TEXT NOT NULL CHECK (length(order_trade_no) BETWEEN 1 AND 128),
+    source_table TEXT NOT NULL CHECK (source_table IN ('billing_orders','subscription_orders')),
+    payment_method TEXT NOT NULL CHECK (payment_method IN ('alipay','wxpay')),
+    paid_cents BIGINT NOT NULL CHECK (paid_cents BETWEEN 1 AND 100000000),
+    event_sha256 CHAR(64) NOT NULL,
+    payload_sha256 CHAR(64) NOT NULL,
+    source_key TEXT,
+    source_row_sha256 CHAR(64),
+    snapshot_sha256 CHAR(64),
+    status TEXT NOT NULL CHECK (status IN ('pending_review','already_fulfilled','blocked')),
+    reason_code TEXT NOT NULL,
+    deliveries BIGINT NOT NULL DEFAULT 1,
+    first_seen_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    last_seen_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    UNIQUE(merchant_id,provider_trade_no)
+);
+CREATE INDEX realyu_legacy_payment_inbox_review ON realyu_legacy_payment_inbox(status,id);
+CREATE INDEX realyu_legacy_payment_inbox_order ON realyu_legacy_payment_inbox(merchant_id,order_trade_no);
+-- Conflicting signed deliveries are evidence, not a replacement for the first receipt.
+CREATE TABLE realyu_legacy_payment_conflicts (
+    inbox_id BIGINT NOT NULL REFERENCES realyu_legacy_payment_inbox(id),
+    event_sha256 CHAR(64) NOT NULL,
+    payload_sha256 CHAR(64) NOT NULL,
+    reason_code TEXT NOT NULL,
+    seen_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    PRIMARY KEY(inbox_id,event_sha256)
+);
