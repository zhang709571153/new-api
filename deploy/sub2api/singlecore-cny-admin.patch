diff --git a/backend/internal/handler/realyu_ws_turn.go b/backend/internal/handler/realyu_ws_turn.go
new file mode 100644
index 0000000000000000000000000000000000000000..5ffcac9fe0d892de4170f0559037999f242a81ec
--- /dev/null
+++ b/backend/internal/handler/realyu_ws_turn.go
@@ -0,0 +1,104 @@
+package handler
+
+import (
+	"context"
+	"strings"
+	"sync"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/ip"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/requestmodel"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+type realYuWSTurn struct {
+	ctx  context.Context
+	done func()
+	key  *service.APIKey
+}
+
+// One immutable hold per response.create, never one hold per WS connection.
+// AfterTurn can overlap admission of the next turn, so a mutable connection
+// context cannot identify the actor, price or reservation of completed work.
+type realYuWSTurns struct {
+	mu    sync.Mutex
+	turns map[int]realYuWSTurn
+}
+
+func (t *realYuWSTurns) put(n int, turn realYuWSTurn) error {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.turns == nil {
+		t.turns = make(map[int]realYuWSTurn)
+	}
+	if _, exists := t.turns[n]; exists {
+		return service.ErrRealYuFundingConflict
+	}
+	t.turns[n] = turn
+	return nil
+}
+
+func (t *realYuWSTurns) take(n int, fallback context.Context, key *service.APIKey) realYuWSTurn {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if turn, ok := t.turns[n]; ok {
+		delete(t.turns, n)
+		return turn
+	}
+	return realYuWSTurn{ctx: fallback, key: key, done: func() {}}
+}
+
+func (t *realYuWSTurns) close() {
+	t.mu.Lock()
+	remaining := t.turns
+	t.turns = nil
+	t.mu.Unlock()
+	for _, turn := range remaining {
+		turn.done()
+	}
+}
+
+func (h *OpenAIGatewayHandler) currentRealYuWSKey(ctx context.Context, c *gin.Context, initial *service.APIKey, payload []byte, model string) (*service.APIKey, error) {
+	if initial.RealYuFunding == nil {
+		return initial, nil
+	}
+	fields, malformed := 0, !gjson.ValidBytes(payload)
+	gjson.ParseBytes(payload).ForEach(func(name, value gjson.Result) bool {
+		if strings.EqualFold(name.String(), "model") {
+			fields++
+			malformed = malformed || name.String() != "model" || value.Type != gjson.String || strings.TrimSpace(value.String()) == ""
+		}
+		return true
+	})
+	if fields > 1 || malformed || strings.TrimSpace(model) == "" {
+		return nil, service.ErrRealYuFundingScope
+	}
+	key, err := h.apiKeyService.GetByID(ctx, initial.ID)
+	if err != nil || key == nil || !key.IsActive() || key.IsExpired() || key.IsQuotaExhausted() || key.User == nil || !key.User.IsActive() || key.UserID != initial.UserID || key.GroupID == nil || initial.GroupID == nil || *key.GroupID != *initial.GroupID || key.Group == nil || !key.Group.IsActive() || !key.User.CanBindGroup(key.Group.ID, key.Group.IsExclusive) {
+		return nil, service.ErrRealYuFundingScope
+	}
+	if allowed, _ := ip.CheckIPRestrictionWithCompiledRules(ip.GetClientIP(c), key.CompiledIPWhitelist, key.CompiledIPBlacklist); !allowed {
+		return nil, service.ErrRealYuFundingScope
+	}
+	key, err = h.apiKeyService.PrepareRealYuFunding(ctx, key)
+	if err != nil || key == nil || key.RealYuFunding == nil || key.RealYuFunding.ActorUserID != initial.RealYuFunding.ActorUserID || key.RealYuFunding.TeamID != initial.RealYuFunding.TeamID || key.RealYuFunding.PayerUserID != initial.RealYuFunding.PayerUserID {
+		return nil, service.ErrRealYuFundingScope
+	}
+	models := append([]string{model}, requestmodel.FromBodyCandidates("", "application/json", payload)...)
+	if blockedModelAllowlistCandidate(key.Group, models) != "" {
+		return nil, service.ErrRealYuFundingScope
+	}
+	policy, err := h.apiKeyService.GetRealYuKeyUsage(ctx, key.ID)
+	if err != nil {
+		return nil, err
+	}
+	if policy != nil && policy.ModelLimitsEnabled {
+		for _, m := range models {
+			if m == "" || !policy.ModelLimits[m] {
+				return nil, service.ErrRealYuFundingScope
+			}
+		}
+	}
+	return key, nil
+}
