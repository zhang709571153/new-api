+	removed := "removed"
+	require.NoError(t, r.UpdateMember(ctx, 1, 101, 2, service.RealYuTeamMemberUpdate{Status: &removed}))
+	require.EqualValues(t, 150, intFunding(t, db, `SELECT used_quota FROM realyu_member_period_usage WHERE user_id=2 AND team_id=101`))
+	require.EqualValues(t, 1, intFunding(t, db, `SELECT COUNT(*) FROM api_keys WHERE id=12 AND deleted_at IS NOT NULL`))
+	require.ErrorIs(t, r.UpdateMember(ctx, 1, 101, 1, service.RealYuTeamMemberUpdate{Status: &removed}), service.ErrRealYuTeamConflict)
+}
+func TestRealYuTeamPGInviteJoinRotateLeave(t *testing.T) {
+	db := teamPG(t)
+	ctx := context.Background()
+	r := NewRealYuTeamRepository(db, true)
+	_, err := r.RotateInvite(ctx, 2, 101)
+	require.ErrorIs(t, err, service.ErrRealYuTeamAccess)
+	code, err := r.RotateInvite(ctx, 1, 101)
+	require.NoError(t, err)
+	require.Len(t, code, 64)
+	joined, err := r.Join(ctx, 5, code)
+	require.NoError(t, err)
+	require.EqualValues(t, 101, joined.TeamID)
+	require.EqualValues(t, 0, intFunding(t, db, `SELECT weekly_cap_quota FROM realyu_team_members WHERE user_id=5`))
+	require.EqualValues(t, 1, intFunding(t, db, `SELECT COUNT(*) FROM realyu_key_scopes WHERE actor_user_id=5 AND payer_user_id=1 AND team_id=101`))
+	again, err := r.Join(ctx, 5, code)
+	require.NoError(t, err)
+	require.Equal(t, joined, again)
+	_, err = r.Join(ctx, 2, code)
+	require.ErrorIs(t, err, service.ErrRealYuTeamConflict) // user 2 already has another team in fixture.
+	_, err = r.RotateInvite(ctx, 1, 101)
+	require.NoError(t, err)
+	_, err = r.Join(ctx, 6, code)
+	require.ErrorIs(t, err, service.ErrRealYuTeamAccess)
+	require.NoError(t, r.Leave(ctx, 5, 101))
+	require.EqualValues(t, 1, intFunding(t, db, `SELECT COUNT(*) FROM api_keys WHERE user_id=5 AND deleted_at IS NOT NULL`))
+	require.ErrorIs(t, r.Leave(ctx, 1, 101), service.ErrRealYuTeamConflict)
+}
+func TestRealYuTeamPGAuditFailureRollsBack(t *testing.T) {
+	db := teamPG(t)
+	ctx := context.Background()
+	r := NewRealYuTeamRepository(db, true)
+	_, err := db.Exec(`CREATE FUNCTION reject_team_audit() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic audit failure'; END $$;CREATE TRIGGER reject_team_audit BEFORE INSERT ON realyu_team_audit FOR EACH ROW EXECUTE FUNCTION reject_team_audit();`)
+	require.NoError(t, err)
+	cap := int64(99)
+	require.Error(t, r.UpdateMember(ctx, 1, 101, 2, service.RealYuTeamMemberUpdate{WeeklyCapQuota: &cap}))
+	require.EqualValues(t, 400, intFunding(t, db, `SELECT weekly_cap_quota FROM realyu_team_members WHERE team_id=101 AND user_id=2`))
+}
