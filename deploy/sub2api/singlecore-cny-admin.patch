diff --git a/frontend/src/api/realyuTeams.ts b/frontend/src/api/realyuTeams.ts
new file mode 100644
index 0000000000000000000000000000000000000000..132316b18d8cad5c5ce00e5b294064aceefda4f9
--- /dev/null
+++ b/frontend/src/api/realyuTeams.ts
@@ -0,0 +1,96 @@
+import { apiClient } from './client'
+
+export interface RealYuTeam {
+  id: number
+  owner_user_id: number
+  name: string
+  closed_at: number
+  can_manage: boolean
+}
+export interface RealYuTeamMember {
+  user_id: number
+  nickname: string
+  status: 'active' | 'disabled' | 'removed'
+  weekly_cap_quota: number
+  weekly_used_quota: number
+  available_quota: number
+  owner: boolean
+}
+export interface RealYuTeamOverview {
+  team: RealYuTeam
+  members: RealYuTeamMember[]
+  weekly_available_quota: number
+  weekly_reset_at: number
+  subscription_expires_at: number
+  subscription_title: string
+  viewer_id: number
+  quota_per_usd: number
+}
+export interface RealYuTeamUsageStats {
+  requests: number
+  input_tokens: number
+  output_tokens: number
+  cache_creation_tokens: number
+  cache_read_tokens: number
+  cost_usd: string
+}
+export interface RealYuTeamUsageItem extends Omit<RealYuTeamUsageStats, 'requests'> {
+  id: string
+  member_id: number
+  nickname: string
+  model: string
+  duration_ms: number
+  created_at: string
+}
+export interface RealYuTeamUsageBucket extends RealYuTeamUsageStats {
+  member_id: number
+  nickname: string
+  model: string
+}
+export interface RealYuTeamUsagePage {
+  items: RealYuTeamUsageItem[]
+  total: number
+  page: number
+  page_size: number
+  stats: RealYuTeamUsageStats
+  breakdown: RealYuTeamUsageBucket[]
+}
+export interface RealYuTeamUsageFilter {
+  member_id?: number
+  model?: string
+  start: string
+  end: string
+  page: number
+  page_size: number
+}
+export interface RealYuTeamMemberUpdate {
+  weekly_cap_quota?: number
+  status?: RealYuTeamMember['status']
+}
+const base = '/realyu/teams'
+export const realyuTeamsApi = {
+  async list(signal?: AbortSignal): Promise<RealYuTeam[]> {
+    return (await apiClient.get<RealYuTeam[]>(base, { signal })).data
+  },
+  async overview(id: number, signal?: AbortSignal): Promise<RealYuTeamOverview> {
+    return (await apiClient.get<RealYuTeamOverview>(`${base}/${id}`, { signal })).data
+  },
+  async usage(id: number, params: RealYuTeamUsageFilter, signal?: AbortSignal): Promise<RealYuTeamUsagePage> {
+    return (await apiClient.get<RealYuTeamUsagePage>(`${base}/${id}/usage`, { params, signal })).data
+  },
+  async rename(id: number, name: string): Promise<void> {
+    await apiClient.patch(`${base}/${id}`, { name })
+  },
+  async updateMember(id: number, member: number, data: RealYuTeamMemberUpdate): Promise<void> {
+    await apiClient.put(`${base}/${id}/members/${member}`, data)
+  },
+  async invite(id: number): Promise<string> {
+    return (await apiClient.post<{ code: string }>(`${base}/${id}/invite`)).data.code
+  },
+  async join(code: string): Promise<{ team_id: number; api_key_id: number }> {
+    return (await apiClient.post<{ team_id: number; api_key_id: number }>(`${base}/join`, { code })).data
+  },
+  async leave(id: number): Promise<void> {
+    await apiClient.post(`${base}/${id}/leave`)
+  },
+}
