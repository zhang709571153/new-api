@@ -0,0 +1,50 @@
+package handler
+
+import (
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"io"
+	"net/http"
+)
+
+// Dedicated legacy endpoints must not use the native unknown-order ACK branch.
+// Returning success acknowledges durable receipt only, never fulfillment.
+type RealYuLegacyPaymentHandler struct {
+	service *service.RealYuLegacyPaymentService
+}
+
+func NewRealYuLegacyPaymentHandler(s *service.RealYuLegacyPaymentService) *RealYuLegacyPaymentHandler {
+	return &RealYuLegacyPaymentHandler{service: s}
+}
+func (h *RealYuLegacyPaymentHandler) BillingNotify(c *gin.Context) { h.receive(c, "billing_orders") }
+func (h *RealYuLegacyPaymentHandler) SubscriptionNotify(c *gin.Context) {
+	h.receive(c, "subscription_orders")
+}
+func (h *RealYuLegacyPaymentHandler) receive(c *gin.Context, source string) {
+	raw := c.Request.URL.RawQuery
+	if c.Request.Method == http.MethodPost {
+		if c.ContentType() != "application/x-www-form-urlencoded" {
+			c.String(http.StatusBadRequest, "fail")
+			return
+		}
+		data, err := io.ReadAll(io.LimitReader(c.Request.Body, 65537))
+		if err != nil || len(data) > 65536 {
+			c.String(http.StatusBadRequest, "fail")
+			return
+		}
+		// Preserve the old ParseForm duplicate guard across query and body.
+		if raw != "" && len(data) > 0 {
+			raw += "&"
+		}
+		raw += string(data)
+	} else if c.Request.Method != http.MethodGet {
+		c.String(http.StatusMethodNotAllowed, "fail")
+		return
+	}
+	if _, err := h.service.Receive(c.Request.Context(), source, raw); err != nil {
+		// Fixed response: never echo signature, merchant key, order or user data.
+		c.String(http.StatusServiceUnavailable, "fail")
+		return
+	}
+	c.String(http.StatusOK, "success")
+}
