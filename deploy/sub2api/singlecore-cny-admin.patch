+"""Import team consumption history and invite hashes from a sealed SQLite backup.
+
+The source is always immutable/read-only. The PostgreSQL target must be loopback,
+have the matching completed customer snapshot, and remain in staging with no new
+business/team writes. This command neither changes traffic nor activates a site.
+Only counts and hashes are reported; credentials, invite codes and names are not.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import closing
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import re
+import sqlite3
+import sys
+import time
+
+MAX_INTEGER = 9_007_199_254_740_991
+
+
+class HistoryError(ValueError):
+    """Public error codes contain no source data or database diagnostics."""
+
+
+def file_sha(path):
+    with path.open("rb") as source:
+        return hashlib.file_digest(source, "sha256").hexdigest()
+
+
+def integer(value, *, positive=False):
+    if type(value) is not int or value < (1 if positive else 0) or value > MAX_INTEGER:
+        raise HistoryError("INVALID_HISTORY_INTEGER")
+    return value
+
+
+def read_snapshot(path: Path, expected_sha: str):
+    path = path.resolve(strict=True)
+    if not re.fullmatch(r"[0-9a-f]{64}", expected_sha) or file_sha(path) != expected_sha:
+        raise HistoryError("SOURCE_SHA256_MISMATCH")
+    if any(Path(str(path) + suffix).exists() for suffix in ("-wal", "-journal")):
+        raise HistoryError("SOURCE_MUST_BE_SEALED_BACKUP_WITHOUT_WAL")
+    with closing(sqlite3.connect(path.as_uri() + "?mode=ro&immutable=1", uri=True)) as source:
+        source.row_factory = sqlite3.Row
+        source.execute("PRAGMA query_only=ON")
+        if source.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
+            raise HistoryError("SOURCE_INTEGRITY_FAILED")
+        try:
+            tables = {
+                "teams": [dict(row) for row in source.execute("SELECT id,owner_user_id,created_at FROM workspace_teams")],
+                # Unscoped tokens retain attribution for former team members.
+                "tokens": [dict(row) for row in source.execute("SELECT id,user_id,workspace_user_id FROM tokens")],
+                "logs": [dict(row) for row in source.execute("SELECT id,user_id,token_id,workspace_team_id,model_name,prompt_tokens,completion_tokens,quota,use_time,created_at FROM logs WHERE type=2 ORDER BY id")],
+                "invites": [dict(row) for row in source.execute("SELECT hash,code,team_id,expires_at,used_by FROM workspace_invites")],
+            }
+            tables["diagnostic_log_count"] = source.execute("SELECT COUNT(*) FROM logs WHERE type IN(5,6)").fetchone()[0]
+        except sqlite3.DatabaseError:
+            raise HistoryError("SOURCE_TEAM_SCHEMA_MISSING") from None
+    if file_sha(path) != expected_sha:
+        raise HistoryError("SOURCE_CHANGED_DURING_READ")
+    return tables
+
+
+def prepare(tables, now=None):
+    now = int(time.time()) if now is None else now
+    teams = {row["id"]: row for row in tables["teams"]}
+    owners = {row["owner_user_id"]: row for row in tables["teams"]}
+    if len(owners) != len(teams):
+        raise HistoryError("AMBIGUOUS_TEAM_OWNER")
+    tokens = {row["id"]: row for row in tables["tokens"]}
+    history = []
+    orphans = []
+    excluded = 0
+    unattributed = 0
+    for row in tables["logs"]:
+        token = tokens.get(row["token_id"])
+        team_id = row["workspace_team_id"]
+        if team_id == -1:
+            excluded += 1
+            continue
+        if team_id < -1:
+            raise HistoryError("INVALID_HISTORY_TEAM_SCOPE")
+        if team_id == 0:
+            # Exact legacy workspaceTeamLogScope: zero predates explicit scopes;
+            # both owner/credential-holder attribution and team creation matter.
+            team = owners.get(row["user_id"])
+            if not team or not token or token["workspace_user_id"] <= 0:
+                unattributed += 1
+                continue
+            if row["created_at"] < team["created_at"]:
+                excluded += 1
+                continue
+        else:
+            team = teams.get(team_id)
+        if team and (not token or token["workspace_user_id"] <= 0 or token["user_id"] != team["owner_user_id"] or row["user_id"] != team["owner_user_id"]):
+            raise HistoryError("EXPLICIT_TEAM_HISTORY_ATTRIBUTION_MISSING")
+        model = row["model_name"]
+        if not isinstance(model, str) or len(model) > 500:
+            raise HistoryError("INVALID_HISTORY_MODEL")
+        duration = integer(row["use_time"]) * 1000
+        integer(duration)
+        if not team:
+            orphans.append((integer(row["id"], positive=True), integer(team_id, positive=True), integer(row["user_id"], positive=True),
+                            token["workspace_user_id"] if token and token["workspace_user_id"] > 0 else None,
+                            integer(row["token_id"]), model, integer(row["prompt_tokens"]), integer(row["completion_tokens"]),
+                            integer(row["quota"]), duration, datetime.fromtimestamp(integer(row["created_at"], positive=True), timezone.utc)))
+            continue
+        history.append((integer(row["id"], positive=True), team["id"], integer(token["workspace_user_id"], positive=True), model,
+                        integer(row["prompt_tokens"]), integer(row["completion_tokens"]), integer(row["quota"]), duration,
+                        datetime.fromtimestamp(integer(row["created_at"], positive=True), timezone.utc)))
+    invites = []
+    invite_teams = set()
+    for row in tables["invites"]:
+        if row["used_by"] or (row["expires_at"] > 0 and row["expires_at"] <= now):
+            continue
+        if row["team_id"] not in teams:
+            raise HistoryError("INVITE_TEAM_MISSING")
+        code_hash = row["hash"]
+        if not re.fullmatch(r"[0-9a-f]{64}", code_hash or ""):
+            raise HistoryError("INVALID_INVITE_HASH")
+        if row["code"] and hashlib.sha256(row["code"].encode()).hexdigest() != code_hash:
+            raise HistoryError("INVITE_HASH_MISMATCH")
+        if row["team_id"] in invite_teams:
+            raise HistoryError("MULTIPLE_ACTIVE_TEAM_INVITES")
+        invite_teams.add(row["team_id"])
+        invites.append((row["team_id"], code_hash, integer(row["expires_at"])))
+    return history, invites, orphans, {
+        "source_consume_rows": len(tables["logs"]), "team_consume_rows": len(history),
+        "excluded_personal_or_preteam_rows": excluded, "unattributed_zero_scope_rows": unattributed,
+        "diagnostic_error_refund_rows_not_in_consumption_view": tables.get("diagnostic_log_count", 0),
+        "active_invites": len(invites),
+        "quarantined_missing_team_rows": len(orphans),
+    }
+
+
+def apply_history(conn, tables, source_sha, installation_id):
+    history, invites, orphans, summary = prepare(tables)
+    with conn.transaction():
+        conn.execute("SET LOCAL lock_timeout='5s'")
+        conn.execute("SET LOCAL statement_timeout='120s'")
+        conn.execute("SELECT pg_advisory_xact_lock(784930201026)")
+        conn.execute("LOCK TABLE realyu_migration_state,realyu_teams,realyu_team_members,realyu_team_audit,realyu_team_invites,realyu_legacy_team_usage,realyu_legacy_team_usage_orphans,realyu_team_history_imports,realyu_funding_requests,usage_logs IN ACCESS EXCLUSIVE MODE")
+        state = conn.execute("SELECT installation_id,phase,source_sha256 FROM realyu_migration_state WHERE singleton FOR UPDATE").fetchone()
+        if state != (installation_id, "staging", source_sha):
+            raise HistoryError("TARGET_NOT_MATCHING_STAGING_CUSTOMER_SNAPSHOT")
+        for table in ("realyu_funding_requests", "usage_logs", "realyu_team_audit"):
+            if conn.execute("SELECT EXISTS(SELECT 1 FROM " + table + ")").fetchone()[0]:
+                raise HistoryError("TARGET_ALREADY_HAS_BUSINESS_WRITES")
+        prior = conn.execute("SELECT imported_rows,imported_invites,quarantined_rows FROM realyu_team_history_imports WHERE source_sha256=%s", (source_sha,)).fetchone()
+        if prior:
+            return {"status": "PASS", "source_sha256": source_sha, "imported_rows": prior[0], "imported_invites": prior[1], "quarantined_rows": prior[2], "idempotent_replay": True}
+        users = dict(conn.execute("SELECT source_user_id,user_id FROM realyu_legacy_identities WHERE source_user_id IS NOT NULL"))
+        target_teams = {row[0]: row[1:] for row in conn.execute("SELECT id,owner_user_id,closed_at FROM realyu_teams")}
+        for team in tables["teams"]:
+            if team["id"] not in target_teams or users.get(team["owner_user_id"]) != target_teams[team["id"]][0]:
+                raise HistoryError("TARGET_TEAM_MAPPING_MISMATCH")
+        mapped = []
+        for row in history:
+            if row[2] not in users:
+                raise HistoryError("HISTORICAL_MEMBER_IDENTITY_MISSING")
+            mapped.append((*row[:2], users[row[2]], *row[3:], source_sha))
+        # Idempotent absolute rows; no user/team balances or weekly usage change.
+        with conn.cursor() as cursor:
+            cursor.executemany("""INSERT INTO realyu_legacy_team_usage(source_log_id,team_id,actor_user_id,model,input_tokens,output_tokens,cost_quota,duration_ms,created_at,snapshot_sha256)
+                VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) ON CONFLICT(source_log_id) DO UPDATE SET
+                team_id=EXCLUDED.team_id,actor_user_id=EXCLUDED.actor_user_id,model=EXCLUDED.model,input_tokens=EXCLUDED.input_tokens,
+                output_tokens=EXCLUDED.output_tokens,cost_quota=EXCLUDED.cost_quota,duration_ms=EXCLUDED.duration_ms,created_at=EXCLUDED.created_at,snapshot_sha256=EXCLUDED.snapshot_sha256""", mapped)
+            cursor.executemany("""INSERT INTO realyu_legacy_team_usage_orphans(source_log_id,source_team_id,source_owner_id,source_actor_id,source_token_id,model,input_tokens,output_tokens,cost_quota,duration_ms,created_at,snapshot_sha256,reason_code)
+                VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,'SOURCE_TEAM_MISSING') ON CONFLICT(source_log_id) DO UPDATE SET
+                source_team_id=EXCLUDED.source_team_id,source_owner_id=EXCLUDED.source_owner_id,source_actor_id=EXCLUDED.source_actor_id,source_token_id=EXCLUDED.source_token_id,
+                model=EXCLUDED.model,input_tokens=EXCLUDED.input_tokens,output_tokens=EXCLUDED.output_tokens,cost_quota=EXCLUDED.cost_quota,duration_ms=EXCLUDED.duration_ms,created_at=EXCLUDED.created_at,snapshot_sha256=EXCLUDED.snapshot_sha256""", [(*row, source_sha) for row in orphans])
+        # Staging has no team mutations, so its invite set follows the snapshot.
+        conn.execute("DELETE FROM realyu_team_invites")
+        imported_invites = 0
+        for row in invites:
+            if target_teams[row[0]][1] == 0:
+                conn.execute("INSERT INTO realyu_team_invites(team_id,code_hash,expires_at) VALUES(%s,%s,%s)", row)
+                imported_invites += 1
+        conn.execute("INSERT INTO realyu_team_history_imports(source_sha256,imported_rows,imported_invites,quarantined_rows) VALUES(%s,%s,%s,%s)", (source_sha, len(mapped), imported_invites, len(orphans)))
+        return {"status": "PASS", "source_sha256": source_sha, "imported_rows": len(mapped), "imported_invites": imported_invites, "quarantined_rows": len(orphans), "idempotent_replay": False, **summary}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", required=True, type=Path)
+    parser.add_argument("--sha256", required=True)
+    parser.add_argument("--private-target", type=Path)
+    parser.add_argument("--apply", action="store_true")
+    parser.add_argument("--report", type=Path)
+    args = parser.parse_args()
+    try:
+        tables = read_snapshot(args.source, args.sha256)
+        _, _, _, counts = prepare(tables)
+        result = {"status": "PASS", "mode": "inspect", "source_sha256": args.sha256, **counts}
+        if args.apply:
+            if not args.private_target:
+                raise HistoryError("PRIVATE_TARGET_REQUIRED")
+            config = json.loads(args.private_target.read_text(encoding="utf-8-sig"))
+            if config.get("host") not in ("127.0.0.1", "::1") or config.get("mode") not in ("rehearsal", "staging"):
+                raise HistoryError("ONLY_EXPLICIT_LOOPBACK_STAGING_TARGET_ALLOWED")
+            if not re.fullmatch(r"[A-Za-z0-9_-]{8,80}", config.get("installation_id", "")):
+                raise HistoryError("EXPLICIT_INSTALLATION_REQUIRED")
+            import psycopg
+            with psycopg.connect(host=config["host"], port=config["port"], dbname=config["database"], user=config["user"], password=config["password"], connect_timeout=5, autocommit=True) as conn:
+                result = apply_history(conn, tables, args.sha256, config["installation_id"])
+        if args.report:
+            args.report.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+        print(json.dumps(result, ensure_ascii=False))
+        return 0
+    except HistoryError as exc:
+        print(json.dumps({"status": "BLOCKED", "code": str(exc)}), file=sys.stderr)
+        return 2
+    except Exception:
+        print(json.dumps({"status": "BLOCKED", "code": "SOURCE_OR_TARGET_OPERATION_FAILED"}), file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
