new file mode 100644
index 0000000000000000000000000000000000000000..eeb9df4906c091059af69cc7e895a681ee8807a8
--- /dev/null
+++ b/backend/internal/handler/realyu_client_compatibility.go
@@ -0,0 +1,97 @@
+package handler
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	ratelimit "github.com/Wei-Shaw/sub2api/internal/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/redis/go-redis/v9"
+)
+
+// Static installers remain separate from the application binary. The configured
+// directory is opened read-only with os.Root, preventing traversal/symlink escape.
+type RealYuClientCompatibilityHandler struct {
+	assetsDir       string
+	diagnosticsDir  string
+	version         string
+	siteName        func(context.Context) string
+	health          func(context.Context) error
+	diagnosticLimit gin.HandlerFunc
+}
+
+func NewRealYuClientCompatibilityHandler(cfg *config.Config, db *sql.DB, rdb *redis.Client, settings *service.SettingService, build BuildInfo) *RealYuClientCompatibilityHandler {
+	h := &RealYuClientCompatibilityHandler{version: build.Version}
+	if cfg != nil {
+		h.assetsDir = strings.TrimSpace(cfg.RealYuClientAssetsDir)
+		h.diagnosticsDir = strings.TrimSpace(cfg.RealYuClientDiagnosticsDir)
+	}
+	h.siteName = func(ctx context.Context) string {
+		if settings == nil {
+			return "Sub2API"
+		}
+		return settings.GetSiteName(ctx)
+	}
+	h.health = func(ctx context.Context) error {
+		if db == nil || rdb == nil {
+			return errors.New("dependencies unavailable")
+		}
+		if err := db.PingContext(ctx); err != nil {
+			return err
+		}
+		return rdb.Ping(ctx).Err()
+	}
+	if rdb != nil {
+		h.diagnosticLimit = ratelimit.NewRateLimiter(rdb).LimitWithOptions("realyu-client-diagnostic-ip", 120, time.Minute, ratelimit.RateLimitOptions{FailureMode: ratelimit.RateLimitFailClose})
+	}
+	return h
+}
+
+func (h *RealYuClientCompatibilityHandler) Download(c *gin.Context) {
+	c.Header("Cache-Control", "no-store, no-transform")
+	if h.assetsDir == "" || !filepath.IsAbs(h.assetsDir) {
+		c.AbortWithStatus(http.StatusNotFound)
+		return
+	}
+	root, err := os.OpenRoot(h.assetsDir)
+	if err != nil {
+		c.AbortWithStatus(http.StatusNotFound)
+		return
+	}
+	defer root.Close()
+	clientDownloadHandler(root.FS())(c)
+}
+
+func (h *RealYuClientCompatibilityHandler) LimitDiagnostic(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if h.diagnosticsDir == "" || !filepath.IsAbs(h.diagnosticsDir) || h.diagnosticLimit == nil {
+		c.AbortWithStatus(http.StatusServiceUnavailable)
+		return
+	}
+	h.diagnosticLimit(c)
+}
+
+// /api/status is a compatibility status contract, not a model inference probe.
+// A success requires the native PostgreSQL and Redis dependencies to respond.
+func (h *RealYuClientCompatibilityHandler) Status(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 2*time.Second)
+	defer cancel()
+	if h.health == nil || h.health(ctx) != nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"success": false, "message": "Service dependencies unavailable"})
+		return
+	}
+	name := "Sub2API"
+	if h.siteName != nil {
+		name = h.siteName(ctx)
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true, "message": "", "data": gin.H{"version": h.version, "system_name": name, "engine": "sub2api", "single_core": true}})
+}
