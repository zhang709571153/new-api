+	require.False(t, b.Applied)
+	_, err = r.Refund(ctx, req)
+	require.NoError(t, err)
+	require.Equal(t, "9.99970000", balanceFunding(t, db, 1))
+	req.TargetQuota++
+	_, err = settleFunding(t, db, req)
