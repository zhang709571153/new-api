+	"github.com/stretchr/testify/require"
+)
+
+type legacyHandlerInbox struct {
+	calls  int
+	source string
+	err    error
+	status string
+}
+
+func (r *legacyHandlerInbox) RecordVerified(_ context.Context, e service.RealYuLegacyPaymentEvent) (*service.RealYuLegacyPaymentReceipt, error) {
+	r.calls++
+	r.source = e.SourceTable
+	return &service.RealYuLegacyPaymentReceipt{ID: 1, Status: r.status}, r.err
+}
+func legacyHandlerSigned() string {
+	p := url.Values{"pid": {"synthetic"}, "trade_no": {"txn01"}, "out_trade_no": {"RYsynthetic"}, "money": {"12.34"}, "type": {"alipay"}, "trade_status": {"TRADE_SUCCESS"}}
+	keys := make([]string, 0, len(p))
+	for k := range p {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	values := []string{}
+	for _, k := range keys {
+		values = append(values, k+"="+p.Get(k))
+	}
+	sum := md5.Sum([]byte(strings.Join(values, "&") + "synthetic-private-key"))
+	p.Set("sign", hex.EncodeToString(sum[:]))
+	p.Set("sign_type", "MD5")
+	return p.Encode()
+}
+func TestRealYuLegacyPaymentHTTPAcknowledgesOnlyDurableKnownReceipt(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name, method, path, status string
+		want                       int
+		err                        error
+	}{
+		{"get_billing", http.MethodGet, "/api/billing/epay/notify", "pending_review", 200, nil},
+		{"post_subscription", http.MethodPost, "/api/subscription/epay/notify", "pending_review", 200, nil},
+		{"already_fulfilled", http.MethodGet, "/api/billing/epay/notify", "already_fulfilled", 200, nil},
+		{"unknown_order", http.MethodGet, "/api/billing/epay/notify", "blocked", 503, nil},
+		{"failed_commit", http.MethodGet, "/api/billing/epay/notify", "pending_review", 503, errors.New("private database error must not be echoed")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &legacyHandlerInbox{status: tc.status, err: tc.err}
+			svc, err := service.NewRealYuLegacyPaymentService(repo, service.RealYuLegacyPaymentConfig{Enabled: true, MerchantID: "synthetic", MerchantKey: "synthetic-private-key", GatewayURL: "https://zpayz.cn"})
+			require.NoError(t, err)
+			h := NewRealYuLegacyPaymentHandler(svc)
+			router := gin.New()
+			router.GET("/api/billing/epay/notify", h.BillingNotify)
+			router.POST("/api/subscription/epay/notify", h.SubscriptionNotify)
+			raw := legacyHandlerSigned()
+			var req *http.Request
+			if tc.method == http.MethodGet {
+				req = httptest.NewRequest(tc.method, tc.path+"?"+raw, nil)
+			} else {
+				req = httptest.NewRequest(tc.method, tc.path, strings.NewReader(raw))
+				req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			}
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, req)
+			require.Equal(t, tc.want, w.Code)
+			require.Equal(t, 1, repo.calls)
+			require.NotContains(t, w.Body.String(), "private")
+			if tc.want == 200 {
+				require.Equal(t, "success", w.Body.String())
+			} else {
+				require.Equal(t, "fail", w.Body.String())
+			}
+			if strings.Contains(tc.path, "subscription") {
+				require.Equal(t, "subscription_orders", repo.source)
+			} else {
+				require.Equal(t, "billing_orders", repo.source)
+			}
+		})
+	}
+}
+func TestRealYuLegacyPaymentHTTPDuplicateAndOversizeNeverStored(t *testing.T) {
+	repo := &legacyHandlerInbox{status: "pending_review"}
+	svc, err := service.NewRealYuLegacyPaymentService(repo, service.RealYuLegacyPaymentConfig{Enabled: true, MerchantID: "synthetic", MerchantKey: "synthetic-private-key", GatewayURL: "https://zpayz.cn"})
+	require.NoError(t, err)
+	h := NewRealYuLegacyPaymentHandler(svc)
+	router := gin.New()
+	router.POST("/api/billing/epay/notify", h.BillingNotify)
+	for _, body := range []string{legacyHandlerSigned(), strings.Repeat("x", 65537)} {
+		req := httptest.NewRequest(http.MethodPost, "/api/billing/epay/notify?money=12.34", strings.NewReader(body))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, req)
+		require.GreaterOrEqual(t, w.Code, 400)
+	}
+	require.Zero(t, repo.calls)
+}
+
+func TestRealYuLegacyPaymentWrongNativeRouteDoesNotAcknowledge(t *testing.T) {
+	router := gin.New()
+	// No native service: legacy-prefix rejection must precede provider lookup.
+	h := NewPaymentWebhookHandler(nil, nil)
+	router.GET("/api/v1/payment/webhook/easypay", h.EasyPayNotify)
+	for _, id := range []string{"RYsynthetic", "SUBUSR1NOsynthetic"} {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/api/v1/payment/webhook/easypay?out_trade_no="+id, nil))
+		require.Equal(t, http.StatusServiceUnavailable, w.Code)
+		require.Equal(t, "fail", w.Body.String())
+	}
+}
