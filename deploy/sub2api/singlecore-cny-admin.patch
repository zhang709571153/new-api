+func TestRealYuFundingPGPersonalMixedAndIdempotent(t *testing.T) {
+	db := realyuPG(t)
+	addFundingSub(t, db, 201, 0, 1000, 900, true)
+	r := NewRealYuFundingRepository(db, true)
