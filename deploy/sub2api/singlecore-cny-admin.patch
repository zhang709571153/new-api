+type RealYuLegacyPaymentRepository struct{ db *sql.DB }
+
+func NewRealYuLegacyPaymentRepository(db *sql.DB) *RealYuLegacyPaymentRepository {
+	return &RealYuLegacyPaymentRepository{db: db}
+}
+
+type legacyInboxOrder struct {
+	TradeNo         string          `json:"trade_no"`
+	Status          string          `json:"status"`
+	PaymentMethod   string          `json:"payment_method"`
+	PaymentProvider string          `json:"payment_provider"`
+	PriceCents      int64           `json:"price_cents"`
+	Money           json.RawMessage `json:"money"`
+}
+
+type legacyInboxMatch struct{ sourceKey, rowSHA, snapshotSHA, status, reason string }
+
+// No user, wallet, entitlement, or archived order is mutated. A future verified
+// fulfillment command must consume this inbox transactionally and idempotently.
+func (r *RealYuLegacyPaymentRepository) RecordVerified(ctx context.Context, e service.RealYuLegacyPaymentEvent) (*service.RealYuLegacyPaymentReceipt, error) {
+	if r == nil || r.db == nil || e.PaidCents < 1 || e.PaidCents > 100000000 || len(e.EventSHA256) != 64 || len(e.PayloadSHA256) != 64 || (e.SourceTable != "billing_orders" && e.SourceTable != "subscription_orders") {
+		return nil, service.ErrRealYuLegacyPaymentInvalid
+	}
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	// Old payment traffic is low-volume. One merchant lock also serializes two
+	// different provider transaction IDs claiming the same merchant order.
+	if _, err = tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, "realyu-legacy-payment:"+e.MerchantID); err != nil {
+		return nil, err
+	}
+	var id int64
+	var existingEvent, existingReason string
+	err = tx.QueryRowContext(ctx, `SELECT id,event_sha256,reason_code FROM realyu_legacy_payment_inbox WHERE merchant_id=$1 AND provider_trade_no=$2 FOR UPDATE`, e.MerchantID, e.ProviderTradeNo).Scan(&id, &existingEvent, &existingReason)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return nil, err
+	}
+	if id > 0 && existingEvent != e.EventSHA256 {
+		if _, err = tx.ExecContext(ctx, `INSERT INTO realyu_legacy_payment_conflicts(inbox_id,event_sha256,payload_sha256,reason_code) VALUES($1,$2,$3,'SIGNED_EVENT_CONFLICT') ON CONFLICT DO NOTHING`, id, e.EventSHA256, e.PayloadSHA256); err != nil {
+			return nil, err
+		}
+		if _, err = tx.ExecContext(ctx, `UPDATE realyu_legacy_payment_inbox SET status='blocked',reason_code='SIGNED_EVENT_CONFLICT',deliveries=deliveries+1,last_seen_at=NOW() WHERE id=$1`, id); err != nil {
+			return nil, err
+		}
+		if err = tx.Commit(); err != nil {
+			return nil, err
+		}
+		return &service.RealYuLegacyPaymentReceipt{ID: id, Status: "blocked", ReasonCode: "SIGNED_EVENT_CONFLICT"}, nil
+	}
+	match, err := matchLegacyInboxOrder(ctx, tx, e)
+	if err != nil {
+		return nil, err
+	}
+	if existingReason == "SIGNED_EVENT_CONFLICT" || existingReason == "MULTIPLE_PROVIDER_TRANSACTIONS" {
+		match.status, match.reason = "blocked", existingReason
+	}
+	var multiple bool
+	if err = tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM realyu_legacy_payment_inbox WHERE merchant_id=$1 AND order_trade_no=$2 AND provider_trade_no<>$3)`, e.MerchantID, e.OrderTradeNo, e.ProviderTradeNo).Scan(&multiple); err != nil {
+		return nil, err
+	}
+	if multiple {
+		match.status, match.reason = "blocked", "MULTIPLE_PROVIDER_TRANSACTIONS"
+		if _, err = tx.ExecContext(ctx, `UPDATE realyu_legacy_payment_inbox SET status='blocked',reason_code='MULTIPLE_PROVIDER_TRANSACTIONS' WHERE merchant_id=$1 AND order_trade_no=$2`, e.MerchantID, e.OrderTradeNo); err != nil {
+			return nil, err
+		}
+	}
+	if id == 0 {
+		err = tx.QueryRowContext(ctx, `INSERT INTO realyu_legacy_payment_inbox(merchant_id,provider_trade_no,order_trade_no,source_table,payment_method,paid_cents,event_sha256,payload_sha256,source_key,source_row_sha256,snapshot_sha256,status,reason_code)
+          VALUES($1,$2,$3,$4,$5,$6,$7,$8,NULLIF($9,''),NULLIF($10,''),NULLIF($11,''),$12,$13) RETURNING id`, e.MerchantID, e.ProviderTradeNo, e.OrderTradeNo, e.SourceTable, e.PaymentMethod, e.PaidCents, e.EventSHA256, e.PayloadSHA256, match.sourceKey, match.rowSHA, match.snapshotSHA, match.status, match.reason).Scan(&id)
+	} else {
+		// A final source snapshot may now contain the formerly unknown order or
+		// show old fulfillment. Revalidate on retry, preserving first raw digest.
+		_, err = tx.ExecContext(ctx, `UPDATE realyu_legacy_payment_inbox SET source_key=NULLIF($2,''),source_row_sha256=NULLIF($3,''),snapshot_sha256=NULLIF($4,''),status=$5,reason_code=$6,deliveries=deliveries+1,last_seen_at=NOW() WHERE id=$1`, id, match.sourceKey, match.rowSHA, match.snapshotSHA, match.status, match.reason)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	return &service.RealYuLegacyPaymentReceipt{ID: id, Status: match.status, ReasonCode: match.reason}, nil
+}
+
+func matchLegacyInboxOrder(ctx context.Context, tx *sql.Tx, e service.RealYuLegacyPaymentEvent) (legacyInboxMatch, error) {
+	m := legacyInboxMatch{status: "blocked", reason: "UNKNOWN_LEGACY_ORDER"}
+	rows, err := tx.QueryContext(ctx, `SELECT source_key,row_sha256,snapshot_sha256,source_row FROM realyu_legacy_records WHERE source_table=$1 AND source_row->>'trade_no'=$2 LIMIT 2 FOR SHARE`, e.SourceTable, e.OrderTradeNo)
+	if err != nil {
+		return m, err
+	}
+	defer rows.Close()
+	var raw []byte
+	count := 0
+	for rows.Next() {
+		count++
+		if err = rows.Scan(&m.sourceKey, &m.rowSHA, &m.snapshotSHA, &raw); err != nil {
+			return m, err
+		}
+	}
+	if err = rows.Err(); err != nil {
+		return m, err
+	}
+	if count == 0 {
+		return m, nil
+	}
+	if count != 1 {
+		m.reason = "AMBIGUOUS_LEGACY_ORDER"
+		return m, nil
+	}
+	var order legacyInboxOrder
+	if err = json.Unmarshal(raw, &order); err != nil {
+		m.reason = "INVALID_ARCHIVED_ORDER"
+		return m, nil
+	}
+	if order.TradeNo != e.OrderTradeNo {
+		m.reason = "INVALID_ARCHIVED_ORDER"
+		return m, nil
+	}
+	expectedCents := order.PriceCents
+	expectedMethod := strings.TrimPrefix(order.PaymentMethod, "epay:")
+	if e.SourceTable == "billing_orders" {
+		if !strings.HasPrefix(order.PaymentMethod, "epay:") {
+			m.reason = "PAYMENT_RAIL_MISMATCH"
+			return m, nil
+		}
+	} else {
+		if order.PaymentProvider != "epay" {
+			m.reason = "PAYMENT_RAIL_MISMATCH"
+			return m, nil
+		}
+		price, parseErr := decimal.NewFromString(string(order.Money))
+		cents := price.Mul(decimal.NewFromInt(100))
+		if parseErr != nil || !cents.Equal(cents.Truncate(0)) || cents.LessThan(decimal.NewFromInt(1)) || cents.GreaterThan(decimal.NewFromInt(100000000)) {
+			m.reason = "INVALID_ARCHIVED_ORDER"
+			return m, nil
+		}
+		expectedCents = cents.IntPart()
+	}
+	if expectedMethod != e.PaymentMethod {
+		m.reason = "PAYMENT_METHOD_MISMATCH"
+		return m, nil
+	}
+	if expectedCents != e.PaidCents {
+		m.reason = "PAYMENT_AMOUNT_MISMATCH"
+		return m, nil
+	}
+	switch order.Status {
+	case "pending":
+		m.status, m.reason = "pending_review", "VERIFIED_RECEIPT_AWAITING_FULFILLMENT"
+	case "paid", "wallet_credited":
+		if e.SourceTable == "billing_orders" {
+			m.status, m.reason = "already_fulfilled", "SOURCE_ALREADY_FULFILLED"
+		} else {
+			m.reason = "SOURCE_STATUS_REQUIRES_REVIEW"
+		}
+	case "success":
+		if e.SourceTable == "subscription_orders" {
+			m.status, m.reason = "already_fulfilled", "SOURCE_ALREADY_FULFILLED"
+		} else {
+			m.reason = "SOURCE_STATUS_REQUIRES_REVIEW"
+		}
+	default:
+		m.reason = "SOURCE_STATUS_REQUIRES_REVIEW"
+	}
+	return m, nil
+}
