+package middleware
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type realyuPolicyFake struct {
+	usage *service.RealYuKeyUsage
+	err   error
+}
+
+func (f realyuPolicyFake) GetRealYuKeyUsage(context.Context, int64) (*service.RealYuKeyUsage, error) {
+	return f.usage, f.err
+}
+
+func TestRealYuLegacyKeyModelPolicy(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name, body string
+		reader     realyuPolicyFake
+		want       int
+	}{
+		{"allowed", `{"model":"allowed"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 200},
+		{"denied", `{"model":"denied"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"unlimited-still-enforces-model-limit", `{"model":"denied"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{UnlimitedQuota: true, TotalAvailable: 0, ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"duplicate-denied-first", `{"model":"denied","model":"allowed"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"duplicate-denied-last", `{"model":"allowed","model":"denied"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"empty-allowlist", `{"model":"allowed"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{}}}, 403},
+		{"stock-key", `{"model":"any"}`, realyuPolicyFake{}, 200},
+		{"database-unavailable", `{"model":"allowed"}`, realyuPolicyFake{err: errors.New("synthetic")}, 503},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := gin.New()
+			r.Use(func(c *gin.Context) { c.Set(string(ContextKeyAPIKey), &service.APIKey{ID: 1}); c.Next() })
+			r.Use(RealYuLegacyKeyPolicy(tc.reader))
+			called := false
+			r.POST("/v1/responses", func(c *gin.Context) {
+				called = true
+				b, err := io.ReadAll(c.Request.Body)
+				require.NoError(t, err)
+				require.Equal(t, tc.body, string(b))
+				c.Status(http.StatusOK)
+			})
+			w := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(tc.body))
+			req.Header.Set("Content-Type", "application/json")
+			r.ServeHTTP(w, req)
+			require.Equal(t, tc.want, w.Code)
+			require.Equal(t, tc.want == 200, called)
+		})
+	}
+}
+
+func runRealYuPolicyRequest(t *testing.T, method, route, requestURL, contentType string, body []byte, allowed ...string) (int, bool) {
+	t.Helper()
+	limits := make(map[string]bool, len(allowed))
+	for _, model := range allowed {
+		limits[model] = true
+	}
+	reader := realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: limits}}
+	r := gin.New()
+	r.Use(func(c *gin.Context) {
+		c.Set(string(ContextKeyAPIKey), &service.APIKey{ID: 1})
+		c.Next()
+	}, RealYuLegacyKeyPolicy(reader))
+	called := false
+	r.Handle(method, route, func(c *gin.Context) {
+		called = true
+		got, err := io.ReadAll(c.Request.Body)
+		require.NoError(t, err)
+		require.Equal(t, body, got, "authorization must preserve the downstream body")
+		c.Status(http.StatusOK)
+	})
+	req := httptest.NewRequest(method, requestURL, bytes.NewReader(body))
+	req.Header.Set("Content-Type", contentType)
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	return w.Code, called
+}
+
+func TestRealYuImagePolicyAuthorizesActualDefaultModel(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name, body, query string
+		allowed           []string
+		want              int
+	}{
+		{"no-model", `{"prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 403},
+		{"empty-model", `{"model":" ","prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 403},
+		{"null-model", `{"model":null,"prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 403},
+		{"case-variant-is-not-actual-model", `{"Model":"gpt-image-1","prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 403},
+		{"nested-session-is-not-actual-model", `{"session":{"model":"gpt-image-1"},"prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 403},
+		{"query-is-not-actual-model", `{"prompt":"synthetic"}`, "?model=gpt-image-1", []string{"gpt-image-1"}, 403},
+		{"duplicate-last-empty", `{"model":"gpt-image-1","model":"","prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 400},
+		{"duplicate-first-empty", `{"model":"","model":"gpt-image-1","prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 400},
+		{"duplicate-last-null", `{"model":"gpt-image-1","model":null,"prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 400},
+		{"duplicate-last-denied", `{"model":"gpt-image-1","model":"gpt-image-2","prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 403},
+		{"explicit-allowed", `{"model":"gpt-image-1","prompt":"synthetic"}`, "", []string{"gpt-image-1"}, 200},
+		{"native-default-allowed", `{"prompt":"synthetic"}`, "", []string{"gpt-image-2"}, 200},
+		{"public-alias-left-for-composite", `{"model":"public-image","prompt":"synthetic"}`, "", []string{"public-image"}, 200},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			status, called := runRealYuPolicyRequest(t, http.MethodPost, "/v1/images/generations", "/v1/images/generations"+tc.query, "application/json", []byte(tc.body), tc.allowed...)
+			require.Equal(t, tc.want, status)
+			require.Equal(t, tc.want == http.StatusOK, called)
+		})
+	}
+}
+
+func TestRealYuImagePolicyCoversRootAndAsyncAliases(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, path := range []string{
+		"/v1/images/generations", "/v1/images/edits", "/v1/images/generations/async", "/v1/images/edits/async",
+		"/images/generations", "/images/edits", "/images/generations/async", "/images/edits/async",
+	} {
+		t.Run(path, func(t *testing.T) {
+			status, called := runRealYuPolicyRequest(t, http.MethodPost, path, path, "application/json", []byte(`{"prompt":"synthetic","images":[{"image_url":"https://example.invalid/synthetic.png"}]}`), "gpt-text-only")
+			require.Equal(t, http.StatusForbidden, status)
+			require.False(t, called)
+		})
+	}
+}
+
+func TestRealYuImagePolicyMultipartUsesLastActualModel(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name      string
+		fields    [][2]string
+		fileModel bool
+		want      int
+	}{
+		{"no-model", nil, false, 403},
+		{"empty-model", [][2]string{{"model", ""}}, false, 403},
+		{"case-variant", [][2]string{{"Model", "gpt-image-1"}}, false, 403},
+		{"nested-session", [][2]string{{"session", `{"model":"gpt-image-1"}`}}, false, 403},
+		{"last-empty-model", [][2]string{{"model", "gpt-image-1"}, {"model", " "}}, false, 403},
+		{"last-denied-model", [][2]string{{"model", "gpt-image-1"}, {"model", "gpt-image-2"}}, false, 403},
+		{"file-part-is-not-model", nil, true, 403},
+		{"explicit-allowed", [][2]string{{"model", "gpt-image-1"}}, false, 200},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var body bytes.Buffer
+			writer := multipart.NewWriter(&body)
+			require.NoError(t, writer.WriteField("prompt", "synthetic"))
+			imagePart, err := writer.CreateFormFile("image", "synthetic.png")
+			require.NoError(t, err)
+			_, err = imagePart.Write([]byte("synthetic-image-bytes"))
+			require.NoError(t, err)
+			for _, field := range tc.fields {
+				require.NoError(t, writer.WriteField(field[0], field[1]))
+			}
+			if tc.fileModel {
+				part, err := writer.CreateFormFile("model", "synthetic.txt")
+				require.NoError(t, err)
+				_, err = io.WriteString(part, "gpt-image-1")
+				require.NoError(t, err)
+			}
+			require.NoError(t, writer.Close())
+			status, called := runRealYuPolicyRequest(t, http.MethodPost, "/v1/images/edits", "/v1/images/edits", writer.FormDataContentType(), body.Bytes(), "gpt-image-1")
+			require.Equal(t, tc.want, status)
+			require.Equal(t, tc.want == http.StatusOK, called)
+		})
+	}
+}
+
+func TestRealYuRestrictedWritesRequireActualExplicitModel(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, body := range []string{
+		`{}`, `{"previous_response_id":"synthetic-response"}`, `{"model":""}`, `{"model":null}`,
+		`{"Model":"allowed"}`, `{"session":{"model":"allowed"}}`,
+		`{"model":"allowed","model":"","previous_response_id":"synthetic-response"}`,
+		`{"model":"","model":"allowed","previous_response_id":"synthetic-response"}`,
+	} {
+		t.Run(body, func(t *testing.T) {
+			status, called := runRealYuPolicyRequest(t, http.MethodPost, "/v1/responses", "/v1/responses?model=allowed", "application/json", []byte(body), "allowed")
+			require.Equal(t, http.StatusBadRequest, status)
+			require.False(t, called)
+		})
+	}
+}
+
+func TestRealYuRestrictedReadAndLiveRoutesRemainUsable(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		method, route, url, body string
+		want                     int
+	}{
+		{http.MethodGet, "/v1/models", "/v1/models", "", 200},
+		{http.MethodGet, "/v1/images/tasks/:task_id", "/v1/images/tasks/synthetic", "", 200},
+		{http.MethodGet, "/v1/usage", "/v1/usage", "", 200},
+		{http.MethodGet, "/v1/realtime", "/v1/realtime?model=allowed", "", 200},
+		{http.MethodGet, "/v1/realtime", "/v1/realtime?model=denied", "", 403},
+		{http.MethodGet, "/v1/responses", "/v1/responses", "", 200},
+		{http.MethodPost, "/v1/live", "/v1/live", `{"session":{"model":"allowed"}}`, 200},
+		{http.MethodPost, "/v1/live", "/v1/live", `{"session":{}}`, 400},
+		{http.MethodPost, "/v1beta/models/*modelAction", "/v1beta/models/allowed:generateContent", `{"contents":[]}`, 200},
+		{http.MethodPost, "/v1beta/models/*modelAction", "/v1beta/models/denied:generateContent", `{"contents":[]}`, 403},
+	} {
+		t.Run(tc.method+" "+tc.url+tc.body, func(t *testing.T) {
+			status, called := runRealYuPolicyRequest(t, tc.method, tc.route, tc.url, "application/json", []byte(tc.body), "allowed")
+			require.Equal(t, tc.want, status)
+			require.Equal(t, tc.want == http.StatusOK, called)
+		})
+	}
+}
