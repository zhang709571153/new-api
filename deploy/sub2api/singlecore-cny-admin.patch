+    expect(w.text()).toContain('(CNY)')
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(mocks.run).toHaveBeenCalledTimes(1)
+    expect(mocks.create).toHaveBeenCalledWith(expect.objectContaining({ balance: 5, role: 'admin' }))
+    expect(w.emitted('success')).toHaveLength(1)
+  })
+
+  it('does not add a balance field when the optional input was not edited', async () => {
+    const w = await createModal()
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(mocks.create).toHaveBeenCalledTimes(1)
+    expect(mocks.create.mock.calls[0]![0]).not.toHaveProperty('balance')
+  })
+
+  it('preserves an explicitly entered zero balance', async () => {
+    const w = await createModal('0')
+    await w.get('form').trigger('submit'); await flushPromises()
+    expect(mocks.create).toHaveBeenCalledWith(expect.objectContaining({ balance: 0 }))
+  })
