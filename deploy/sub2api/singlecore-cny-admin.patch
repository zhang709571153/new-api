+
+type wsManagedKeyRepo struct {
+	service.APIKeyRepository
+	key     *service.APIKey
+	revoked atomic.Bool
+	reads   atomic.Int64
+}
+
+func (r *wsManagedKeyRepo) GetByKeyForAuth(ctx context.Context, _ string) (*service.APIKey, error) {
+	return r.GetByID(ctx, r.key.ID)
+}
+
+func (r *wsManagedKeyRepo) GetByID(context.Context, int64) (*service.APIKey, error) {
+	r.reads.Add(1)
+	k := *r.key
+	if r.revoked.Load() {
+		k.Status = service.StatusDisabled
+	}
+	return &k, nil
+}
+func (r *wsManagedKeyRepo) GetRealYuKeyUsage(context.Context, int64) (*service.RealYuKeyUsage, error) {
+	return &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"gpt-5.1": true}}, nil
+}
+
+type wsManagedFunding struct {
+	handlerFundingRepo
+	disabled atomic.Bool
+}
+
+func (r *wsManagedFunding) Resolve(context.Context, int64, int64) (*service.RealYuFundingScope, error) {
+	if r.disabled.Load() {
+		return nil, service.ErrRealYuFundingScope
+	}
+	return &service.RealYuFundingScope{APIKeyID: 2, ActorUserID: 1, PayerUserID: 7, TeamID: 5}, nil
+}
+
+// Real client WS -> native handler -> real upstream WS. The repositories are
+// deterministic fixtures; final production acceptance additionally uses PG and
+// the live upstream. A health endpoint cannot exercise these lifecycle paths.
+func TestRealYuWebSocketTwoTurnsAndFreshPermissions(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, ingressMode := range []string{service.OpenAIWSIngressModePassthrough, service.OpenAIWSIngressModeCtxPool} {
+		t.Run(ingressMode, func(t *testing.T) {
+			for _, scenario := range []string{"continuation", "revoked_key", "disabled_member", "forbidden_model", "duplicate_model"} {
+				t.Run(scenario, func(t *testing.T) {
+					ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+					defer cancel()
+					upstreamCalls := atomic.Int64{}
+					upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						conn, err := coderws.Accept(w, r, nil)
+						if err != nil {
+							return
+						}
+						defer conn.CloseNow()
+						for turn := 1; turn <= 2; turn++ {
+							_, payload, err := conn.Read(ctx)
+							if err != nil {
+								return
+							}
+							upstreamCalls.Add(1)
+							if turn == 2 && gjson.GetBytes(payload, "previous_response_id").String() != "resp_realyu_ws_1" {
+								t.Error("continuation ID did not reach upstream")
+							}
+							err = conn.Write(ctx, coderws.MessageText, []byte(fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp_realyu_ws_%d","model":"gpt-5.1","usage":{"input_tokens":1200,"output_tokens":300}}}`, turn)))
+							if err != nil {
+								return
+							}
+						}
+						_, _, _ = conn.Read(ctx)
+					}))
+					defer upstream.Close()
+					funding := &wsManagedFunding{}
+					group := int64(4)
+					in, out := .00000125, .000010
+					key := &service.APIKey{ID: 2, UserID: 1, Key: "synthetic-managed-key", Status: service.StatusActive, GroupID: &group,
+						User: &service.User{ID: 1, Status: service.StatusActive, RestrictPublicGroups: true, AllowedGroups: []int64{group}},
+						Group: &service.Group{ID: group, Status: service.StatusActive, Platform: service.PlatformOpenAI, RateMultiplier: 1, Hydrated: true,
+							ModelPricing: []service.ChannelModelPricing{{Models: []string{"gpt-5.1"}, BillingMode: service.BillingModeToken, InputPrice: &in, OutputPrice: &out}}},
+						RealYuFunding: &service.RealYuFundingScope{APIKeyID: 2, ActorUserID: 1, PayerUserID: 7, TeamID: 5}, RealYuFundingRepository: funding}
+					keyRepo := &wsManagedKeyRepo{key: key}
+					cfg := &config.Config{}
+					cfg.Default.RateMultiplier = 1
+					cfg.Security.URLAllowlist.AllowInsecureHTTP = true
+					cfg.Gateway.OpenAIWS.Enabled = true
+					cfg.Gateway.OpenAIWS.APIKeyEnabled = true
+					cfg.Gateway.OpenAIWS.ResponsesWebsocketsV2 = true
+					cfg.Gateway.OpenAIWS.ModeRouterV2Enabled = true
+					cfg.Gateway.OpenAIWS.DialTimeoutSeconds = 3
+					cfg.Gateway.OpenAIWS.ReadTimeoutSeconds = 4
+					cfg.Gateway.OpenAIWS.WriteTimeoutSeconds = 3
+					cfg.Gateway.OpenAIWS.IngressInterTurnIdleTimeoutSeconds = 4
+					keySvc := service.NewAPIKeyService(keyRepo, nil, nil, nil, nil, nil, cfg)
+					keySvc.SetRealYuFundingRepository(funding)
+					accountRepo := &openAIWSUsageHandlerAccountRepoStub{account: service.Account{ID: 3, Name: "synthetic", Platform: service.PlatformOpenAI, Type: service.AccountTypeAPIKey, Status: service.StatusActive, Schedulable: true, Concurrency: 1,
+						Credentials: map[string]any{"api_key": "synthetic", "base_url": upstream.URL}, Extra: map[string]any{"openai_apikey_responses_websockets_v2_enabled": true, "openai_apikey_responses_websockets_v2_mode": ingressMode}}}
+					logs := &cyberFundingUsageRepo{written: make(chan struct{}, 4)}
+					bill := &cyberFundingBillingRepo{}
+					billing := service.NewBillingService(cfg, nil)
+					cache := service.NewBillingCacheService(nil, nil, nil, nil, nil, nil, cfg, nil)
+					defer cache.Stop()
+					gateway := service.NewOpenAIGatewayService(accountRepo, logs, bill, nil, nil, nil, testutil.NewRedisGatewayCache(t), cfg, nil, nil, billing, nil, cache, nil, &service.DeferredService{}, nil, nil, service.NewModelPricingResolver(nil, billing), nil, nil, nil, nil)
+					concurrency := &concurrencyCacheMock{acquireUserSlotFn: func(context.Context, int64, int, string) (bool, error) { return true, nil }, acquireAccountSlotFn: func(context.Context, int64, int, string) (bool, error) { return true, nil }}
+					h := NewOpenAIGatewayHandler(gateway, service.NewConcurrencyService(concurrency), cache, keySvc, nil, nil, nil, nil, cfg)
+					done := make(chan struct{})
+					router := gin.New()
+					router.Use(func(c *gin.Context) {
+						c.Set(string(middleware.ContextKeyAPIKey), key)
+						c.Set(string(middleware.ContextKeyUser), middleware.AuthSubject{UserID: 1, Concurrency: 1})
+						c.Next()
+					})
+					router.GET("/v1/responses", func(c *gin.Context) { defer close(done); h.ResponsesWebSocket(c) })
+					server := httptest.NewServer(router)
+					defer server.Close()
+					client, _, err := coderws.Dial(ctx, "ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses", nil)
+					require.NoError(t, err)
+					defer client.CloseNow()
+					require.NoError(t, client.Write(ctx, coderws.MessageText, []byte(`{"type":"response.create","model":"gpt-5.1","input":"first"}`)))
+					_, event, err := client.Read(ctx)
+					require.NoError(t, err)
+					require.Equal(t, "resp_realyu_ws_1", gjson.GetBytes(event, "response.id").String())
+					next := `{"type":"response.create","model":"gpt-5.1","previous_response_id":"resp_realyu_ws_1","input":"continue"}`
+					switch scenario {
+					case "revoked_key":
+						keyRepo.revoked.Store(true)
+					case "disabled_member":
+						funding.disabled.Store(true)
+					case "forbidden_model":
+						next = strings.Replace(next, "gpt-5.1", "gpt-5.2", 1)
+					case "duplicate_model":
+						next = strings.Replace(next, `"model":"gpt-5.1"`, `"model":"gpt-5.1","model":""`, 1)
+					}
+					require.NoError(t, client.Write(ctx, coderws.MessageText, []byte(next)))
+					_, event, err = client.Read(ctx)
+					if scenario == "continuation" {
+						require.NoError(t, err)
+						require.Equal(t, "resp_realyu_ws_2", gjson.GetBytes(event, "response.id").String())
+						_ = client.Close(coderws.StatusNormalClosure, "")
+					} else {
+						require.Error(t, err)
+						require.Equal(t, coderws.StatusPolicyViolation, coderws.CloseStatus(err))
+					}
+					select {
+					case <-done:
+					case <-ctx.Done():
+						t.Fatal("handler did not exit")
+					}
+					expected := int64(1)
+					if scenario == "continuation" {
+						expected = 2
+					}
+					require.Equal(t, expected, upstreamCalls.Load())
+					require.Equal(t, expected, funding.reserved.Load())
+					require.Zero(t, funding.refunded.Load())
+					bill.mu.Lock()
+					defer bill.mu.Unlock()
+					require.Len(t, bill.commands, int(expected))
+					for _, command := range bill.commands {
+						require.NotNil(t, command.RealYuFunding)
+						require.Positive(t, command.RealYuFunding.TargetQuota)
+					}
+					if expected == 2 {
+						require.NotEqual(t, bill.commands[0].RealYuFunding.RequestID, bill.commands[1].RealYuFunding.RequestID, "different turns need different durable reservations")
+					}
+				})
+			}
+		})
+	}
+}
