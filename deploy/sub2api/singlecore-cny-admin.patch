@@ -0,0 +1,109 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/base64"
+	"fmt"
+	"strings"
+	"unicode/utf8"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"golang.org/x/crypto/argon2"
+	"golang.org/x/crypto/bcrypt"
+)
+
+const (
+	RealyuLegacySignupSource                    = "realyu_legacy"
+	RealyuUsernameSignupSource                  = "realyu_username"
+	SettingKeyRealyuUsernameRegistrationEnabled = "realyu_username_registration_enabled"
+	RealyuLegacyEmailDomain                     = "@realyu-legacy.invalid"
+	legacyPasswordMemory                        = 19 * 1024
+	legacyPasswordTime                          = 2
+)
+
+// LegacyLoginRepository resolves only aliases installed by the offline importer
+// or the explicit username registration flow.
+// Native editable profile usernames must never become authentication aliases.
+type LegacyLoginRepository interface {
+	GetByLegacyLoginName(context.Context, string) (*User, error)
+}
+
+type UsernameRegistrationRepository interface {
+	CreateWithUsernameIdentity(context.Context, *User, string) error
+}
+
+func (u *User) HasUsernameIdentity() bool {
+	return u != nil && (u.SignupSource == RealyuLegacySignupSource || u.SignupSource == RealyuUsernameSignupSource)
+}
+
+func (s *SettingService) IsUsernameRegistrationEnabled(ctx context.Context) bool {
+	value, err := s.settingRepo.GetValue(ctx, SettingKeyRealyuUsernameRegistrationEnabled)
+	return err == nil && value == "true"
+}
+
+// HasVerifiedRecoveryEmail deliberately excludes imported, unverified addresses,
+// including real addresses copied from the old system without verification proof.
+func (u *User) HasVerifiedRecoveryEmail() bool {
+	return u != nil && u.Email != "" && !isReservedEmail(u.Email) &&
+		(!u.HasUsernameIdentity() || u.LegacyEmailVerifiedAt != nil)
+}
+
+func (u *User) PublicEmail() string {
+	if u == nil || (u.HasUsernameIdentity() && !u.HasVerifiedRecoveryEmail()) {
+		return ""
+	}
+	return u.Email
+}
+
+func (u *User) PasswordMinimumLength() int {
+	if u.HasUsernameIdentity() && !u.TotpEnabled {
+		return 15
+	}
+	return 8
+}
+
+// checkAccountPassword supports the exact bounded Argon2id format emitted by
+// RealYu and native bcrypt. Plaintext is never trimmed, normalized or truncated.
+func checkAccountPassword(password, encoded string) bool {
+	if password == "" || len(password) > 128*utf8.UTFMax || len(encoded) > 256 {
+		return false
+	}
+	if strings.HasPrefix(encoded, "$argon2id$") {
+		parts := strings.Split(encoded, "$")
+		if len(parts) != 6 || parts[0] != "" || parts[1] != "argon2id" || parts[2] != "v=19" || parts[3] != "m=19456,t=2,p=1" {
+			return false
+		}
+		salt, err := base64.RawStdEncoding.Strict().DecodeString(parts[4])
+		if err != nil || len(salt) != 16 {
+			return false
+		}
+		expected, err := base64.RawStdEncoding.Strict().DecodeString(parts[5])
+		if err != nil || len(expected) != 32 {
+			return false
+		}
+		actual := argon2.IDKey([]byte(password), salt, legacyPasswordTime, legacyPasswordMemory, 1, 32)
+		return subtle.ConstantTimeCompare(actual, expected) == 1
+	}
+	if len(password) > 72 {
+		return false
+	}
+	cost, err := bcrypt.Cost([]byte(encoded))
+	if err != nil || cost > 16 {
+		return false
+	}
+	return bcrypt.CompareHashAndPassword([]byte(encoded), []byte(password)) == nil
+}
+
+func hashLegacyAccountPassword(password string, minimumLength int) (string, error) {
+	if !utf8.ValidString(password) || utf8.RuneCountInString(password) < minimumLength || utf8.RuneCountInString(password) > 128 {
+		return "", infraerrors.BadRequest("INVALID_PASSWORD", fmt.Sprintf("password must contain between %d and 128 characters", minimumLength))
+	}
+	salt := make([]byte, 16)
+	if _, err := rand.Read(salt); err != nil {
+		return "", fmt.Errorf("generate password salt: %w", err)
+	}
+	key := argon2.IDKey([]byte(password), salt, legacyPasswordTime, legacyPasswordMemory, 1, 32)
+	return fmt.Sprintf("$argon2id$v=19$m=19456,t=2,p=1$%s$%s", base64.RawStdEncoding.EncodeToString(salt), base64.RawStdEncoding.EncodeToString(key)), nil
+}
diff --git a/backend/internal/service/realyu_legacy_payment.go b/backend/internal/service/realyu_legacy_payment.go
new file mode 100644
index 0000000000000000000000000000000000000000..536af57374b499df2cf23ad4180f0d7e573a6fa1
--- /dev/null
+++ b/backend/internal/service/realyu_legacy_payment.go
@@ -0,0 +1,148 @@
+package service
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net/url"
+	"regexp"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/payment"
+	"github.com/Wei-Shaw/sub2api/internal/payment/provider"
+	"github.com/shopspring/decimal"
+)
+
+var (
+	ErrRealYuLegacyPaymentDisabled = errors.New("legacy payment inbox is disabled")
+	ErrRealYuLegacyPaymentInvalid  = errors.New("legacy payment notification is invalid")
+	ErrRealYuLegacyPaymentBlocked  = errors.New("legacy payment requires operator reconciliation")
+)
+
+// Enabled is opt-in. These are the OLD merchant credentials, supplied privately;
+// never infer them from a new native payment provider or expose them in logs.
+type RealYuLegacyPaymentConfig struct {
+	Enabled     bool
+	MerchantID  string
+	MerchantKey string
+	GatewayURL  string
+}
+
+type RealYuLegacyPaymentEvent struct {
+	MerchantID      string
+	ProviderTradeNo string
+	OrderTradeNo    string
+	SourceTable     string
+	PaymentMethod   string
+	PaidCents       int64
+	EventSHA256     string
+	PayloadSHA256   string
+}
+
+type RealYuLegacyPaymentReceipt struct {
+	ID         int64
+	Status     string
+	ReasonCode string
+}
+
+// RecordVerified commits BEFORE returning success. It only writes inbox/audit
+// tables; pending_review deliberately does not mean paid or fulfilled.
+type RealYuLegacyPaymentRepository interface {
+	RecordVerified(context.Context, RealYuLegacyPaymentEvent) (*RealYuLegacyPaymentReceipt, error)
+}
+
+type RealYuLegacyPaymentService struct {
+	repo       RealYuLegacyPaymentRepository
+	verifier   payment.Provider
+	merchantID string
+	zpayAlias  bool
+}
+
+func NewRealYuLegacyPaymentService(repo RealYuLegacyPaymentRepository, cfg RealYuLegacyPaymentConfig) (*RealYuLegacyPaymentService, error) {
+	s := &RealYuLegacyPaymentService{repo: repo}
+	if !cfg.Enabled {
+		return s, nil
+	}
+	u, err := url.Parse(cfg.GatewayURL)
+	if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || !legacyPaymentID.MatchString(cfg.MerchantID) || cfg.MerchantKey == "" || repo == nil {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	// NewEasyPay.VerifyNotification is local signature verification: no network
+	// or query/payment API is invoked by this receiver.
+	p, err := provider.NewEasyPay("realyu-legacy-inbox", map[string]string{
+		"pid": cfg.MerchantID, "pkey": cfg.MerchantKey, "apiBase": cfg.GatewayURL,
+		"notifyUrl": "https://invalid.invalid/receive-only", "returnUrl": "https://invalid.invalid/receive-only",
+	})
+	if err != nil {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	s.verifier, s.merchantID = p, cfg.MerchantID
+	s.zpayAlias = strings.EqualFold(u.Hostname(), "zpayz.cn")
+	return s, nil
+}
+
+var legacyPaymentID = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+var legacyPaymentMoney = regexp.MustCompile(`^[0-9]{1,9}(\.[0-9]{1,2})?$`)
+
+// Native callbacks must never silently ACK a legacy order sent to the wrong
+// endpoint. Legacy checkout prefixes are distinct from native "sub2_" orders.
+func IsRealYuLegacyPaymentOrderID(id string) bool {
+	return strings.HasPrefix(id, "RY") || strings.HasPrefix(id, "SUBUSR")
+}
+
+func legacyPaymentDigest(value string) string {
+	sum := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(sum[:])
+}
+
+func (s *RealYuLegacyPaymentService) Receive(ctx context.Context, sourceTable, raw string) (*RealYuLegacyPaymentReceipt, error) {
+	if s == nil || s.verifier == nil || s.repo == nil {
+		return nil, ErrRealYuLegacyPaymentDisabled
+	}
+	if (sourceTable != "billing_orders" && sourceTable != "subscription_orders") || len(raw) == 0 || len(raw) > 65536 {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	values, err := url.ParseQuery(raw)
+	if err != nil {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	for _, v := range values {
+		if len(v) != 1 {
+			return nil, ErrRealYuLegacyPaymentInvalid
+		}
+	}
+	if values.Get("pid") != s.merchantID || values.Get("trade_status") != "TRADE_SUCCESS" || (values.Get("sign_type") != "" && values.Get("sign_type") != "MD5") {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	if !legacyPaymentID.MatchString(values.Get("trade_no")) || !legacyPaymentID.MatchString(values.Get("out_trade_no")) || !legacyPaymentMoney.MatchString(values.Get("money")) {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	// Never use PaymentNotification.Amount (float64) for legacy ledger matching.
+	money, err := decimal.NewFromString(values.Get("money"))
+	cents := money.Mul(decimal.NewFromInt(100))
+	if err != nil || !cents.Equal(cents.Truncate(0)) || cents.LessThan(decimal.NewFromInt(1)) || cents.GreaterThan(decimal.NewFromInt(100000000)) {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	n, err := s.verifier.VerifyNotification(ctx, raw, nil)
+	if err != nil || n == nil || n.Status != payment.NotificationStatusSuccess {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	method := values.Get("type")
+	if method == "alipay9" && s.zpayAlias {
+		method = "alipay"
+	}
+	if method != "alipay" && method != "wxpay" {
+		return nil, ErrRealYuLegacyPaymentInvalid
+	}
+	event := RealYuLegacyPaymentEvent{MerchantID: s.merchantID, ProviderTradeNo: n.TradeNo, OrderTradeNo: n.OrderID, SourceTable: sourceTable, PaymentMethod: method, PaidCents: cents.IntPart(), PayloadSHA256: legacyPaymentDigest(raw)}
+	event.EventSHA256 = legacyPaymentDigest(strings.Join([]string{event.MerchantID, event.ProviderTradeNo, event.OrderTradeNo, event.SourceTable, event.PaymentMethod, cents.StringFixed(0)}, "\n"))
+	receipt, err := s.repo.RecordVerified(ctx, event)
+	if err != nil {
+		return nil, err
+	}
+	if receipt == nil || (receipt.Status != "pending_review" && receipt.Status != "already_fulfilled") {
+		return receipt, ErrRealYuLegacyPaymentBlocked
+	}
+	return receipt, nil
+}
diff --git a/backend/internal/service/realyu_legacy_payment_test.go b/backend/internal/service/realyu_legacy_payment_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e5dee980038dd5c264f7642f6e6d92fe2b17ecd8
--- /dev/null
+++ b/backend/internal/service/realyu_legacy_payment_test.go
@@ -0,0 +1,108 @@
+package service
+
+import (
+	"context"
+	"crypto/md5"
+	"encoding/hex"
+	"errors"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type legacyInboxFake struct {
+	calls  int
+	event  RealYuLegacyPaymentEvent
+	status string
+	err    error
+}
+
+func (r *legacyInboxFake) RecordVerified(_ context.Context, e RealYuLegacyPaymentEvent) (*RealYuLegacyPaymentReceipt, error) {
+	r.calls++
+	r.event = e
+	return &RealYuLegacyPaymentReceipt{ID: 1, Status: r.status}, r.err
+}
+func legacySigned(params url.Values, key string) string {
+	keys := make([]string, 0, len(params))
+	for k := range params {
+		if k != "sign" && k != "sign_type" && params.Get(k) != "" {
+			keys = append(keys, k)
+		}
+	}
+	sort.Strings(keys)
+	values := make([]string, 0, len(keys))
+	for _, k := range keys {
+		values = append(values, k+"="+params.Get(k))
+	}
+	sum := md5.Sum([]byte(strings.Join(values, "&") + key))
+	params.Set("sign", hex.EncodeToString(sum[:]))
+	params.Set("sign_type", "MD5")
+	return params.Encode()
+}
+func legacyCallbackValues() url.Values {
+	return url.Values{"pid": {"synthetic"}, "trade_no": {"provider01"}, "out_trade_no": {"RYsynthetic"}, "money": {"12.34"}, "type": {"alipay"}, "trade_status": {"TRADE_SUCCESS"}}
+}
+func TestRealYuLegacyPaymentVerificationBeforePersistence(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(url.Values)
+		key    string
+	}{
+		{"bad_signature", func(url.Values) {}, "wrong"},
+		{"wrong_merchant", func(v url.Values) { v.Set("pid", "other") }, "synthetic-key"},
+		{"duplicate", func(v url.Values) { v.Add("money", "12.34") }, "synthetic-key"},
+		{"precision", func(v url.Values) { v.Set("money", "12.341") }, "synthetic-key"},
+		{"scientific", func(v url.Values) { v.Set("money", "1e2") }, "synthetic-key"},
+		{"negative", func(v url.Values) { v.Set("money", "-12.34") }, "synthetic-key"},
+		{"not_paid", func(v url.Values) { v.Set("trade_status", "WAIT_BUYER_PAY") }, "synthetic-key"},
+		{"reflection", func(v url.Values) { v.Set("notify_url", "https://invalid.invalid/") }, "synthetic-key"},
+		{"method", func(v url.Values) { v.Set("type", "alipay99") }, "synthetic-key"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &legacyInboxFake{status: "pending_review"}
+			s, err := NewRealYuLegacyPaymentService(repo, RealYuLegacyPaymentConfig{Enabled: true, MerchantID: "synthetic", MerchantKey: "synthetic-key", GatewayURL: "https://zpayz.cn"})
+			require.NoError(t, err)
+			v := legacyCallbackValues()
+			tc.change(v)
+			_, err = s.Receive(context.Background(), "billing_orders", legacySigned(v, tc.key))
+			require.ErrorIs(t, err, ErrRealYuLegacyPaymentInvalid)
+			require.Zero(t, repo.calls)
+			require.NotContains(t, err.Error(), "synthetic-key")
+		})
+	}
+}
+func TestRealYuLegacyPaymentExactReceiptAndFailureBoundary(t *testing.T) {
+	repo := &legacyInboxFake{status: "pending_review"}
+	s, err := NewRealYuLegacyPaymentService(repo, RealYuLegacyPaymentConfig{Enabled: true, MerchantID: "synthetic", MerchantKey: "synthetic-key", GatewayURL: "https://zpayz.cn"})
+	require.NoError(t, err)
+	v := legacyCallbackValues()
+	v.Set("type", "alipay9")
+	r, err := s.Receive(context.Background(), "billing_orders", legacySigned(v, "synthetic-key"))
+	require.NoError(t, err)
+	require.Equal(t, "pending_review", r.Status)
+	require.EqualValues(t, 1234, repo.event.PaidCents)
+	require.Equal(t, "alipay", repo.event.PaymentMethod)
+	first := repo.event.EventSHA256
+	v.Set("money", "12.34")
+	_, err = s.Receive(context.Background(), "billing_orders", legacySigned(v, "synthetic-key"))
+	require.NoError(t, err)
+	require.Equal(t, first, repo.event.EventSHA256)
+	repo.status = "blocked"
+	_, err = s.Receive(context.Background(), "billing_orders", legacySigned(v, "synthetic-key"))
+	require.ErrorIs(t, err, ErrRealYuLegacyPaymentBlocked)
+	repo.err = errors.New("synthetic commit unavailable")
+	_, err = s.Receive(context.Background(), "billing_orders", legacySigned(v, "synthetic-key"))
+	require.Error(t, err)
+	s, err = NewRealYuLegacyPaymentService(repo, RealYuLegacyPaymentConfig{})
+	require.NoError(t, err)
+	_, err = s.Receive(context.Background(), "billing_orders", legacySigned(v, "synthetic-key"))
+	require.ErrorIs(t, err, ErrRealYuLegacyPaymentDisabled)
+	s, err = NewRealYuLegacyPaymentService(repo, RealYuLegacyPaymentConfig{Enabled: true, MerchantID: "synthetic", MerchantKey: "synthetic-key", GatewayURL: "https://other.invalid"})
+	require.NoError(t, err)
+	_, err = s.Receive(context.Background(), "billing_orders", legacySigned(v, "synthetic-key"))
+	require.ErrorIs(t, err, ErrRealYuLegacyPaymentInvalid)
+}
diff --git a/backend/internal/service/realyu_legacy_response.go b/backend/internal/service/realyu_legacy_response.go
new file mode 100644
index 0000000000000000000000000000000000000000..657562b6b86b6307bd25806dacfc73d39193591f
--- /dev/null
+++ b/backend/internal/service/realyu_legacy_response.go
@@ -0,0 +1,98 @@
+package service
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const realYuLegacyResponsePrefix = "resp_ry1_"
+
+var ErrRealYuResponseReference = errors.New("response reference is not available for this user and workspace")
+
+type realYuLegacyResponseActor interface {
+	RealYuLegacyResponseActor(context.Context, int64, int64) (int64, int64, error)
+}
+
+// Legacy response IDs authenticate the ORIGINAL actor and workspace, not the
+// projection account, editable nickname, routing group or current numeric ID.
+// Keep this verifier compatible with the deployed New API envelope. The secret
+// is supplied privately at startup; it is never returned in a response or log.
+func unwrapRealYuLegacyResponse(id, namespace, secret string, sourceActor, team int64) (string, error) {
+	if sourceActor <= 0 || team < 0 || namespace == "" || len(secret) < 32 || len(id) > 800 || !strings.HasPrefix(id, realYuLegacyResponsePrefix) {
+		return "", ErrRealYuResponseReference
+	}
+	encoded, signature, ok := strings.Cut(strings.TrimPrefix(id, realYuLegacyResponsePrefix), ".")
+	if !ok || len(signature) != 64 {
+		return "", ErrRealYuResponseReference
+	}
+	raw, err := base64.RawURLEncoding.Strict().DecodeString(encoded)
+	if err != nil || base64.RawURLEncoding.EncodeToString(raw) != encoded || len(raw) > 512 || !strings.HasPrefix(string(raw), "resp_") || strings.HasPrefix(string(raw), realYuLegacyResponsePrefix) {
+		return "", ErrRealYuResponseReference
+	}
+	mac := hmac.New(sha256.New, []byte(secret))
+	fmt.Fprintf(mac, "%s\x00response:%s\x00%d\x000", namespace, raw, sourceActor)
+	if team != 0 {
+		fmt.Fprintf(mac, "\x00team:%d", team)
+	}
+	expected := hex.EncodeToString(mac.Sum(nil))
+	if !hmac.Equal([]byte(expected), []byte(signature)) {
+		return "", ErrRealYuResponseReference
+	}
+	return string(raw), nil
+}
+
+// PrepareRealYuResponseReference converts an old signed reference only after
+// verifying its original scope. Binding the authenticated current owner lets
+// native HTTP and WS continuations use the same existing Redis account affinity.
+// Raw native references still go through the normal owner check; this function
+// never adopts an unsigned foreign response or removes a failed reference.
+func (s *OpenAIGatewayService) PrepareRealYuResponseReference(ctx context.Context, key *APIKey, body []byte) ([]byte, error) {
+	if key == nil || key.RealYuFunding == nil {
+		return body, nil
+	}
+	fields := 0
+	malformed := false
+	gjson.ParseBytes(body).ForEach(func(name, value gjson.Result) bool {
+		if strings.EqualFold(name.String(), "previous_response_id") {
+			fields++
+			malformed = malformed || name.String() != "previous_response_id" || (value.Type != gjson.String && value.Type != gjson.Null)
+		}
+		return true
+	})
+	if fields > 1 || malformed {
+		return nil, ErrRealYuResponseReference
+	}
+	id := gjson.GetBytes(body, "previous_response_id").String()
+	if !strings.HasPrefix(id, realYuLegacyResponsePrefix) {
+		return body, nil
+	}
+	resolver, ok := s.usageBillingRepo.(realYuLegacyResponseActor)
+	if !ok || s.cfg == nil {
+		return nil, ErrRealYuResponseReference
+	}
+	actor, team, err := resolver.RealYuLegacyResponseActor(ctx, key.ID, key.UserID)
+	if err != nil {
+		return nil, ErrRealYuResponseReference
+	}
+	raw, err := unwrapRealYuLegacyResponse(id, s.cfg.RealYuLegacyNamespace, s.cfg.RealYuLegacyIdentitySecret, actor, team)
+	if err != nil {
+		return nil, err
+	}
+	group := int64(0)
+	if key.GroupID != nil {
+		group = *key.GroupID
+	}
+	if err = s.BindOpenAIHTTPResponseOwner(ctx, group, raw, key.UserID, key.ID); err != nil {
+		return nil, ErrRealYuResponseReference
+	}
+	return sjson.SetBytes(body, "previous_response_id", raw)
+}
diff --git a/backend/internal/service/realyu_legacy_response_test.go b/backend/internal/service/realyu_legacy_response_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1ab855aa88cce7ff26e9830f30ed51a3d6cf45c3
--- /dev/null
+++ b/backend/internal/service/realyu_legacy_response_test.go
@@ -0,0 +1,83 @@
+package service
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+	"strings"
+	"testing"
+)
+
+const legacyFixtureSecret = "synthetic-identity-secret-32-bytes-minimum"
+
+// Golden signatures generated with Python hashlib against the deployed envelope.
+const legacyPersonal = "resp_ry1_cmVzcF9sZWdhY3lfZml4dHVyZQ.dcf162ae8d76bdfa4f48727822b79b5ba12a389421fe76a0048f9889b8e602e7"
+const legacyTeam = "resp_ry1_cmVzcF9sZWdhY3lfZml4dHVyZQ.f38eca14a55352e92fa5f3766b819a68996985f7aa8a67f77b395cd9431ed833"
+
+func TestRealYuLegacyResponseGoldenAndScope(t *testing.T) {
+	for _, tc := range []struct {
+		name, id, namespace, secret string
+		actor, team                 int64
+		ok                          bool
+	}{
+		{"personal", legacyPersonal, "realyu-test", legacyFixtureSecret, 7, 0, true},
+		{"team", legacyTeam, "realyu-test", legacyFixtureSecret, 7, 101, true},
+		{"other_actor", legacyTeam, "realyu-test", legacyFixtureSecret, 8, 101, false},
+		{"other_team", legacyTeam, "realyu-test", legacyFixtureSecret, 7, 102, false},
+		{"team_to_personal", legacyTeam, "realyu-test", legacyFixtureSecret, 7, 0, false},
+		{"personal_to_team", legacyPersonal, "realyu-test", legacyFixtureSecret, 7, 101, false},
+		{"other_namespace", legacyTeam, "other", legacyFixtureSecret, 7, 101, false},
+		{"missing_secret", legacyTeam, "realyu-test", "", 7, 101, false},
+		{"tamper", strings.Replace(legacyTeam, "f38e", "e38e", 1), "realyu-test", legacyFixtureSecret, 7, 101, false},
+		{"padding", strings.Replace(legacyTeam, "ZQ.", "ZQ=.", 1), "realyu-test", legacyFixtureSecret, 7, 101, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			id, err := unwrapRealYuLegacyResponse(tc.id, tc.namespace, tc.secret, tc.actor, tc.team)
+			if tc.ok {
+				require.NoError(t, err)
+				require.Equal(t, "resp_legacy_fixture", id)
+			} else {
+				require.ErrorIs(t, err, ErrRealYuResponseReference)
+			}
+		})
+	}
+}
+
+type legacyResponseRepo struct {
+	UsageBillingRepository
+	actor, team int64
+}
+
+func (r *legacyResponseRepo) RealYuLegacyResponseActor(context.Context, int64, int64) (int64, int64, error) {
+	return r.actor, r.team, nil
+}
+
+func TestRealYuLegacyResponseBindsOnlyVerifiedOwner(t *testing.T) {
+	ctx := context.Background()
+	group := int64(2)
+	svc := &OpenAIGatewayService{cfg: &config.Config{RealYuLegacyNamespace: "realyu-test", RealYuLegacyIdentitySecret: legacyFixtureSecret}, usageBillingRepo: &legacyResponseRepo{actor: 7, team: 101}}
+	key := &APIKey{ID: 72, UserID: 71, GroupID: &group, RealYuFunding: &RealYuFundingScope{TeamID: 101}}
+	body := []byte(`{"previous_response_id":"` + legacyTeam + `","temperature":0,"store":false,"input":[{"type":"function_call_output","call_id":"call_existing","output":"retained"}],"extension":9007199254740993}`)
+	prepared, err := svc.PrepareRealYuResponseReference(ctx, key, body)
+	require.NoError(t, err)
+	require.Equal(t, "resp_legacy_fixture", gjson.GetBytes(prepared, "previous_response_id").String())
+	require.Equal(t, strings.Replace(string(body), legacyTeam, "resp_legacy_fixture", 1), string(prepared))
+	ok, err := svc.ValidateOpenAIHTTPResponseOwner(ctx, group, "resp_legacy_fixture", 71, 72)
+	require.NoError(t, err)
+	require.True(t, ok)
+	ok, err = svc.ValidateOpenAIHTTPResponseOwner(ctx, group, "resp_legacy_fixture", 72, 72)
+	require.NoError(t, err)
+	require.False(t, ok)
+	for _, bad := range []string{`{"previous_response_id":1}`, `{"Previous_Response_Id":"x"}`, `{"previous_response_id":"x","previous_response_id":"y"}`} {
+		_, err = svc.PrepareRealYuResponseReference(ctx, key, []byte(bad))
+		require.ErrorIs(t, err, ErrRealYuResponseReference)
+	}
+	raw := []byte(`{"previous_response_id":"resp_unknown"}`)
+	prepared, err = svc.PrepareRealYuResponseReference(ctx, key, raw)
+	require.NoError(t, err)
+	require.Equal(t, raw, prepared)
+	ok, err = svc.ValidateOpenAIHTTPResponseOwner(ctx, group, "resp_unknown", 71, 72)
+	require.NoError(t, err)
+	require.False(t, ok, "unsigned reference must never establish ownership")
+}
diff --git a/backend/internal/service/realyu_pricing_migration_test.go b/backend/internal/service/realyu_pricing_migration_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9f06347a946e9c5f46f833b122dd3e6053f2709b
--- /dev/null
+++ b/backend/internal/service/realyu_pricing_migration_test.go
@@ -0,0 +1,100 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// This explicit operator-supplied fixture contains normalized public prices and
+// synthetic token vectors, never customer rows or credentials. A mismatch is an
+// exact integer-quota failure, not an epsilon-based acceptance of a price change.
+func TestRealYuLegacyPricingMappingExactNativeQuota(t *testing.T) {
+	path := os.Getenv("REALYU_PRICING_MAPPING")
+	if path == "" {
+		t.Skip("explicit read-only legacy pricing mapping required")
+	}
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	type interval struct {
+		Min    int    `json:"min_tokens"`
+		Max    *int   `json:"max_tokens"`
+		Input  string `json:"input_price"`
+		Output string `json:"output_price"`
+		Read   string `json:"cache_read_price"`
+		Write  string `json:"cache_write_price"`
+	}
+	var fixture struct {
+		Ratio string `json:"legacy_default_group_ratio"`
+		Rules []struct {
+			Model string `json:"model"`
+			Card  struct {
+				Input       string     `json:"input_price"`
+				Output      string     `json:"output_price"`
+				Read        string     `json:"cache_read_price"`
+				Write       string     `json:"cache_write_price"`
+				Fast        string     `json:"fast_multiplier"`
+				Flex        string     `json:"flex_multiplier"`
+				ImageInput  string     `json:"image_input_price"`
+				ImageOutput *string    `json:"image_output_price"`
+				Intervals   []interval `json:"intervals"`
+			} `json:"card"`
+			Vectors []struct {
+				Tokens map[string]int `json:"tokens"`
+				Tier   string         `json:"service_tier"`
+				Quota  int64          `json:"expected_quota"`
+			} `json:"vectors"`
+		} `json:"rules"`
+	}
+	require.NoError(t, json.Unmarshal(data, &fixture))
+	price := func(s string) *float64 { f, e := strconv.ParseFloat(s, 64); require.NoError(t, e); return &f }
+	ratio := *price(fixture.Ratio)
+	require.NotEmpty(t, fixture.Rules)
+	for _, rule := range fixture.Rules {
+		t.Run(rule.Model, func(t *testing.T) {
+			card := ChannelModelPricing{Platform: PlatformOpenAI, Models: []string{rule.Model}, BillingMode: BillingModeToken,
+				InputPrice: price(rule.Card.Input), OutputPrice: price(rule.Card.Output), CacheReadPrice: price(rule.Card.Read),
+				CacheWritePrice: price(rule.Card.Write), CacheWrite1hPrice: price(rule.Card.Write),
+				FastMultiplier: price(rule.Card.Fast), FlexMultiplier: price(rule.Card.Flex)}
+			card.ImageInputPrice = price(rule.Card.ImageInput)
+			if rule.Card.ImageOutput != nil {
+				card.ImageOutputPrice = price(*rule.Card.ImageOutput)
+			}
+			for _, iv := range rule.Card.Intervals {
+				card.Intervals = append(card.Intervals, PricingInterval{MinTokens: iv.Min, MaxTokens: iv.Max,
+					InputPrice: price(iv.Input), OutputPrice: price(iv.Output), CacheReadPrice: price(iv.Read), CacheWritePrice: price(iv.Write), CacheWrite1hPrice: price(iv.Write)})
+			}
+			billing := &BillingService{fallbackPrices: map[string]*ModelPricing{rule.Model: {InputPricePerToken: 99, OutputPricePerToken: 99, CacheReadPricePerToken: 99}}}
+			channel := &Channel{ID: 1, Status: StatusActive, ModelPricing: []ChannelModelPricing{card}}
+			cache := newEmptyChannelCache()
+			cache.channelByGroupID[2] = channel
+			cache.groupPlatform[2] = PlatformOpenAI
+			cache.pricingByGroupModel[channelModelKey{groupID: 2, platform: PlatformOpenAI, model: rule.Model}] = &card
+			cache.loadedAt = time.Now()
+			channelService := &ChannelService{}
+			channelService.cache.Store(cache)
+			resolver := NewModelPricingResolver(channelService, billing)
+			group := &Group{ID: 2, Platform: PlatformOpenAI, RateMultiplier: ratio, LongContextPricingEnabled: true}
+			resolved := resolver.Resolve(context.Background(), PricingInput{Model: rule.Model, GroupID: &group.ID, Group: group})
+			require.Equal(t, PricingSourceChannel, resolved.Source)
+			require.Len(t, resolved.Intervals, 2)
+			for i, v := range rule.Vectors {
+				t.Run(fmt.Sprintf("%02d-%s", i, v.Tier), func(t *testing.T) {
+					cost, e := billing.CalculateCostUnified(CostInput{Model: rule.Model, GroupID: &group.ID, Group: group,
+						Tokens:         UsageTokens{InputTokens: v.Tokens["p"], OutputTokens: v.Tokens["c"], CacheReadTokens: v.Tokens["cr"], CacheCreationTokens: v.Tokens["cc"], ImageInputTokens: v.Tokens["image_input"], ImageOutputTokens: v.Tokens["image_output"]},
+						RateMultiplier: ratio, ServiceTier: v.Tier, Resolver: resolver, Resolved: resolved})
+					require.NoError(t, e)
+					q, e := RealYuQuotaFromUSD(cost.ActualCost)
+					require.NoError(t, e)
+					require.Equal(t, v.Quota, q, "native cost=%s", strconv.FormatFloat(cost.ActualCost, 'g', -1, 64))
+				})
+			}
+		})
+	}
+}
