+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { enableAutoUnmount, mount } from '@vue/test-utils'
+import { nextTick } from 'vue'
+import PlatformCostCell from '../PlatformCostCell.vue'
+import PlatformUsageBreakdown from '../PlatformUsageBreakdown.vue'
+import { configureCustomerCurrency } from '@/utils/customerMoney'
+
+vi.mock('vue-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }))
+enableAutoUnmount(afterEach)
+beforeEach(() => configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7' }))
+
+describe('customer platform spend cells', () => {
+  it('shows billed totals using the current rate without altering raw usage', async () => {
+    const usage = { platform: 'openai', today_actual_cost: 0.25, total_actual_cost: 1 }
+    const w = mount(PlatformCostCell, { props: { usage } })
+    expect(w.text()).toContain('¥1.7500')
+    expect(w.text()).toContain('¥7.0000')
+    configureCustomerCurrency({ customer_currency: 'CNY', customer_usd_to_cny: '7.5' })
+    await nextTick()
+    expect(w.text()).toContain('¥1.8750')
+    expect(w.text()).toContain('¥7.5000')
+    expect(usage.total_actual_cost).toBe(1)
+  })
+
+  it('converts breakdown and unassigned remainder once while summing raw USD', () => {
+    const w = mount(PlatformUsageBreakdown, {
+      props: { today: 2, total: 10, byPlatform: [{ platform: 'openai', today_actual_cost: 1, total_actual_cost: 6 }] },
+      global: { stubs: { Icon: true } },
+    })
+    expect(w.text()).toContain('¥14.0000')
+    expect(w.text()).toContain('¥70.0000')
+    expect(w.text()).toContain('¥42.0000')
+    expect(w.text()).toContain('¥28.0000')
+    expect(w.text()).toContain('admin.users.platformOther')
+    expect(w.text()).not.toContain('$')
+  })
+
+  it('keeps stock USD mode and missing data distinct from zero usage', () => {
+    configureCustomerCurrency({ customer_currency: 'USD', customer_usd_to_cny: '1' })
+    const empty = mount(PlatformCostCell)
+    expect(empty.text()).toBe('—')
+    const zero = mount(PlatformCostCell, { props: { usage: { platform: 'openai', today_actual_cost: 0, total_actual_cost: 1 } } })
+    expect(zero.text()).toContain('$0.0000')
+    expect(zero.text()).toContain('$1.0000')
+  })
+})
