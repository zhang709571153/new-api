# Build only from the reviewed handoff commit. The root .dockerignore excludes
# private state and customer evidence. No runtime credentials belong in ARG.
FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS web
WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web/ ./
ARG APP_VERSION=realyu-sub2api-candidate
RUN VITE_REACT_APP_VERSION="$APP_VERSION" bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS api
ENV CGO_ENABLED=0 GOWORK=off
WORKDIR /build
COPY go.mod go.sum ./
COPY relaykit/go.mod ./relaykit/go.mod
RUN go mod download
COPY . .
COPY --from=web /build/web/dist ./web/dist
ARG APP_VERSION=realyu-sub2api-candidate
RUN go build -trimpath -ldflags "-s -w -X github.com/QuantumNous/new-api/common.Version=${APP_VERSION}" -o /new-api .
RUN go build -trimpath -ldflags "-s -w" -o /sub2api-prewarm ./cmd/sub2api-prewarm

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata wget && rm -rf /var/lib/apt/lists/*
COPY --from=api /new-api /new-api
COPY --from=api /sub2api-prewarm /sub2api-prewarm
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
WORKDIR /data
EXPOSE 3000
ENTRYPOINT ["/new-api"]
