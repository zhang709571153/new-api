+/* Activated only by the explicit native site_logo in deploy/realyu/branding-settings.json.
+ * Reuses RealYu's existing assets and blue theme; upstream and other sites retain
+ * their original styling. Primary anchors are from RealYu web/src/styles/theme.css:
+ * light oklch(0.692 0.141 243.716), dark oklch(0.54 0.142 248.516).
+ */
+html[data-brand-profile='realyu'] {
+  --brand-primary-50: 244 249 254;
+  --brand-primary-100: 226 241 253;
+  --brand-primary-200: 196 226 252;
+  --brand-primary-300: 158 206 245;
+  --brand-primary-400: 116 185 239;
+  --brand-primary-500: 62 164 236;
+  --brand-primary-600: 27 138 209;
+  --brand-primary-700: 0 114 177;
+  --brand-primary-800: 9 87 135;
+  --brand-primary-900: 15 62 94;
+  --brand-primary-950: 14 41 61;
+  --brand-ring: 66 166 255;
+}
+
+html.dark[data-brand-profile='realyu'] {
+  --brand-primary-500: 14 114 188;
+  --brand-primary-600: 14 114 188;
+  --brand-ring: 26 117 197;
+}
+
+html[data-brand-profile='realyu'] .brand-logo-wide {
+  width: 11.25rem;
+  max-width: 100%;
+  height: 2.5rem;
+  object-fit: contain;
+  border-radius: 0;
+  box-shadow: none;
+}
+
+html[data-brand-profile='realyu'] .sidebar-header:not(.sidebar-header-collapsed) .sidebar-logo {
+  flex: 0 1 10rem;
+  min-width: 0;
+  width: 10rem;
+  max-width: 100%;
+  height: 2.5rem;
+  border-radius: 0;
+  box-shadow: none;
+}
+
+/* The wordmark contains the name; the accessible link and version remain intact. */
+html[data-brand-profile='realyu'] .sidebar-header:not(.sidebar-header-collapsed) .sidebar-brand-title {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+html[data-brand-profile='realyu'] .focus\:ring-primary-500:focus {
+  --tw-ring-color: rgb(var(--brand-ring));
+}
