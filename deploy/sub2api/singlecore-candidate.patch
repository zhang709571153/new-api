+// Website presentation order; this does not affect upstream routing or billing.
+const MODEL_ORDER = [
+  'gpt-6.1-sol',
+  'gpt-6-astra',
+  'gpt-6-sol',
+  'gpt-6-luna',
+  'gpt-5.6-sol',
+  'gpt-5.6-terra',
+  'gpt-5.6-luna',
+  'gpt-5.5',
+  'gpt-image-2',
+]
+
+export function compareModelNames(left: string, right: string): number {
+  const leftIndex = MODEL_ORDER.indexOf(left)
+  const rightIndex = MODEL_ORDER.indexOf(right)
+  const leftRank = leftIndex < 0 ? MODEL_ORDER.length : leftIndex
+  const rightRank = rightIndex < 0 ? MODEL_ORDER.length : rightIndex
+  return (
+    leftRank - rightRank ||
+    left.localeCompare(right, undefined, { numeric: true })
+  )
+}
+
+export function modelDisplayName(model: string): string {
+  return model === 'gpt-image-2' ? 'GPT Image 2.5' : model
+}
