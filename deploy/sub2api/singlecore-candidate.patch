+          ADD COLUMN group_id BIGINT, ADD COLUMN created_at TIMESTAMPTZ,
+          ADD COLUMN last_used_at TIMESTAMPTZ, ADD COLUMN ip_whitelist JSONB, ADD COLUMN ip_blacklist JSONB,
+          ADD COLUMN rate_limit_5h NUMERIC DEFAULT 0, ADD COLUMN rate_limit_1d NUMERIC DEFAULT 0,
+          ADD COLUMN rate_limit_7d NUMERIC DEFAULT 0, ADD COLUMN usage_5h NUMERIC DEFAULT 0,
+          ADD COLUMN usage_1d NUMERIC DEFAULT 0, ADD COLUMN usage_7d NUMERIC DEFAULT 0,
+          ADD COLUMN window_5h_start TIMESTAMPTZ, ADD COLUMN window_1d_start TIMESTAMPTZ,
+          ADD COLUMN window_7d_start TIMESTAMPTZ;
