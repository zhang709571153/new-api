+// This opt-in test uses an isolated schema in the explicitly named local test
+// database. It does not connect to production or execute other candidate migrations.
+func TestRealyuPostgresIdentityE2E(t *testing.T) {
+	dsn := os.Getenv("REALYU_AUTH_TEST_DSN")
+	if dsn == "" {
+		t.Skip("set REALYU_AUTH_TEST_DSN for the isolated PostgreSQL database")
+	}
+	u, err := url.Parse(dsn)
+	require.NoError(t, err)
+	require.Equal(t, "127.0.0.1", u.Hostname())
+	require.Equal(t, "/realyu_auth_e2e", u.Path)
+	db, err := sql.Open("postgres", dsn)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = db.Close() })
+	ctx := context.Background()
+	schema := fmt.Sprintf("realyu_identity_test_%d", time.Now().UnixNano())
+	_, err = db.ExecContext(ctx, `CREATE SCHEMA `+schema)
+	require.NoError(t, err)
+	t.Cleanup(func() { _, _ = db.ExecContext(context.Background(), `DROP SCHEMA `+schema+` CASCADE`) })
+	query := u.Query()
+	query.Set("search_path", schema)
+	u.RawQuery = query.Encode()
+	testDB, err := sql.Open("postgres", u.String())
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = testDB.Close() })
+	client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, testDB)))
+	t.Cleanup(func() { _ = client.Close() })
+	require.NoError(t, client.Schema.Create(ctx))
+	migration, err := migrations.FS.ReadFile("300_realyu_legacy_identity.sql")
+	require.NoError(t, err)
+	_, err = testDB.ExecContext(ctx, string(migration))
+	require.NoError(t, err)
+	repo := repository.NewUserRepository(client, testDB)
+	cfg := &config.Config{JWT: config.JWTConfig{Secret: "isolated-auth-fixture-secret", ExpireHour: 1}}
+	settings := map[string]string{service.SettingKeyRegistrationEnabled: "true", service.SettingKeyRealyuUsernameRegistrationEnabled: "true"}
+	settingSvc := service.NewSettingService(&authIdentitySettingRepoStub{values: settings}, cfg)
+	svc := service.NewAuthService(client, repo, nil, nil, cfg, settingSvc, nil, nil, nil, nil, nil, nil, nil)
+	id := realyuImportedUser(t, client, "PreservedCase", "pg"+service.RealyuLegacyEmailDomain, realyuPasswordFixture("legacy-password"))
+	_, imported, err := svc.Login(ctx, "PreservedCase", "legacy-password")
+	require.NoError(t, err)
+	assert.Equal(t, id, imported.ID)
+	_, _, err = svc.Login(ctx, "preservedcase", "legacy-password")
+	assert.ErrorIs(t, err, service.ErrInvalidCredentials)
+	_, registered, err := svc.RegisterWithUsername(ctx, "new-pg-user", "Independent nickname", "", "new-password-for-postgres", "", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, service.RoleUser, registered.Role)
+	_, _, err = svc.RegisterWithUsername(ctx, "PreservedCase", "collision", "", "new-password-for-postgres", "", "", "")
+	assert.ErrorIs(t, err, service.ErrLoginNameUnavailable)
+	_, _, err = svc.RegisterWithUsername(ctx, "new-pg-user", "collision", "", "new-password-for-postgres", "", "", "")
+	assert.ErrorIs(t, err, service.ErrLoginNameUnavailable)
+	nickname := "Changed nickname"
+	_, err = service.NewUserService(repo, nil, nil, nil).UpdateProfile(ctx, registered.ID, service.UpdateProfileRequest{Username: &nickname})
+	require.NoError(t, err)
+	_, after, err := svc.Login(ctx, "new-pg-user", "new-password-for-postgres")
+	require.NoError(t, err)
+	assert.Equal(t, nickname, after.Username)
+	_, err = testDB.ExecContext(ctx, string(migration))
+	require.NoError(t, err, "same migration is idempotent and preserves imported records")
+	_, after, err = svc.Login(ctx, "PreservedCase", "legacy-password")
+	require.NoError(t, err)
+	assert.Equal(t, id, after.ID)
+	count, err := client.User.Query().Count(ctx)
+	require.NoError(t, err)
+	assert.Equal(t, 2, count, "failed collisions must not create accounts")
+}
+
+func TestRealyuPasswordCompatibility(t *testing.T) {
+	svc := &service.AuthService{}
+	password := "  " + strings.Repeat("密码", 20) + "  "
+	hash := realyuPasswordFixture(password)
+	bcryptHash, err := bcrypt.GenerateFromPassword([]byte("old-bcrypt-password"), bcrypt.MinCost)
+	require.NoError(t, err)
+	tests := []struct {
+		name, password, hash string
+		allowed              bool
+	}{
+		{"argon unicode and whitespace", password, hash, true},
+		{"no trim", strings.TrimSpace(password), hash, false},
+		{"no prefix truncation", password + "x", hash, false},
+		{"bcrypt", "old-bcrypt-password", string(bcryptHash), true},
+		{"wrong bcrypt", "wrong", string(bcryptHash), false},
+		{"empty hash", "anything", "", false},
+		{"empty password", "", realyuPasswordFixture(""), false},
+		{"bounded memory", password, strings.Replace(hash, "m=19456", "m=999999999", 1), false},
+		{"bounded time", password, strings.Replace(hash, "t=2", "t=999999999", 1), false},
+		{"bounded lanes", password, strings.Replace(hash, "p=1", "p=64", 1), false},
+		{"bounded plaintext", strings.Repeat("a", 513), hash, false},
+		{"invalid encoding", password, hash + "=", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) { assert.Equal(t, tc.allowed, svc.CheckPassword(tc.password, tc.hash)) })
+	}
+}
