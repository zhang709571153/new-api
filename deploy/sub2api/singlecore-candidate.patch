+func TestZPayReturnURLAndSignedNotification(t *testing.T) {
+	for _, mode := range []string{"", "zpay"} {
+		for _, paymentMode := range []string{"popup", "qrcode"} {
+			t.Run(mode+"/"+paymentMode, func(t *testing.T) {
+				var params url.Values
+				srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if r.Method != http.MethodPost || r.URL.Path != "/mapi.php" {
+						t.Error("creation transport changed")
+					}
+					if err := r.ParseForm(); err != nil {
+						t.Error(err)
+					}
+					params = r.PostForm
+					_, _ = w.Write([]byte(`{"code":1,"trade_no":"synthetic-trade","payurl":"https://cashier.example/pay"}`))
+				}))
+				defer srv.Close()
+				p := newZPayTestProvider(t, srv.URL)
+				p.config["compatibilityMode"], p.config["paymentMode"] = mode, paymentMode
+				originalReturn := "https://app.example/payment/result?order_id=42&resume_token=synthetic-token#fragment"
+				created, err := p.CreatePayment(context.Background(), payment.CreatePaymentRequest{
+					OrderID: "synthetic-order", Amount: "12.34", PaymentType: "alipay", Subject: "synthetic test",
+					ReturnURL: originalReturn,
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if paymentMode == "popup" {
+					parsed, err := url.Parse(created.PayURL)
+					if err != nil {
+						t.Fatal(err)
+					}
+					params = parsed.Query()
+				}
+				wantReturn := originalReturn
+				if mode == "zpay" {
+					wantReturn = "https://app.example/payment/result"
+				}
+				if params.Get("return_url") != wantReturn {
+					t.Errorf("return_url=%q, want %q", params.Get("return_url"), wantReturn)
+				}
+				if params.Get("notify_url") != "https://app.example/notify" {
+					t.Error("notification URL must remain unchanged")
+				}
+				signed := map[string]string{}
+				for k := range params {
+					signed[k] = params.Get(k)
+				}
+				if !easyPayVerifySign(signed, "synthetic-secret", params.Get("sign")) {
+					t.Error("creation signature must cover final return_url")
+				}
+				// A signed creation URL remains ineligible as a payment notification.
+				if _, err := p.VerifyNotification(context.Background(), params.Encode(), nil); err == nil {
+					t.Error("creation request was accepted as notification")
+				}
+				callback := map[string]string{"pid": "synthetic-pid", "out_trade_no": "synthetic-order", "trade_no": "synthetic-trade", "type": "alipay", "name": "synthetic test", "money": "12.34", "trade_status": "TRADE_SUCCESS"}
+				callback["sign"] = easyPaySign(callback, "synthetic-secret")
+				values := url.Values{}
+				for k, v := range callback {
+					values.Set(k, v)
+				}
+				notification, err := p.VerifyNotification(context.Background(), values.Encode(), nil)
+				if err != nil || notification.OrderID != "synthetic-order" || notification.Status != payment.ProviderStatusSuccess {
+					t.Fatalf("valid notification failed: %v", err)
+				}
+				values.Set("money", "99.99")
+				if _, err := p.VerifyNotification(context.Background(), values.Encode(), nil); err == nil {
+					t.Error("tampered notification accepted")
+				}
+			})
+		}
+	}
+}
+
+func TestZPayRejectsInvalidReturnURLBeforeCreatingPayment(t *testing.T) {
+	p := newZPayTestProvider(t, "https://invalid.example")
+	p.config["paymentMode"] = "popup"
+	for _, value := range []string{"javascript:alert(1)", "/payment/result", "https://user:pass@app.example/payment/result", "https://app.example/%zz"} {
+		if _, err := p.CreatePayment(context.Background(), payment.CreatePaymentRequest{ReturnURL: value}); err == nil {
+			t.Errorf("invalid return URL accepted: %s", value)
