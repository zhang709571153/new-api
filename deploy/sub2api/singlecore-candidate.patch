@@ -0,0 +1,28 @@
+package service
+
+import "context"
+
+// SetRealYuFundingRepository is startup-only dependency wiring. A disabled
+// repository still identifies and rejects managed keys, avoiding stock fallback.
+func (s *APIKeyService) SetRealYuFundingRepository(repo RealYuFundingRepository) {
+	s.realyuFundingRepository = repo
+}
+
+func (s *APIKeyService) PrepareRealYuFunding(ctx context.Context, key *APIKey) (*APIKey, error) {
+	if key == nil || s.realyuFundingRepository == nil {
+		return key, nil
+	}
+	scope, err := s.realyuFundingRepository.Resolve(ctx, key.ID, key.UserID)
+	if err != nil {
+		return nil, err
+	}
+	if scope == nil {
+		return key, nil
+	}
+	// GetByKey may return a shared cached object. Never add request-local state
+	// to it: different requests and workspaces must not share reservation handles.
+	copy := *key
+	copy.RealYuFunding = scope
+	copy.RealYuFundingRepository = s.realyuFundingRepository
+	return &copy, nil
+}
diff --git a/backend/internal/service/realyu_funding_lifecycle.go b/backend/internal/service/realyu_funding_lifecycle.go
