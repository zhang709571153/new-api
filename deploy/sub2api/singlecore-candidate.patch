@@ -0,0 +1,33 @@
+package middleware
+
+import (
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"strings"
+)
+
+func realyuFundingReadOnly(c *gin.Context) bool {
+	if c.Request.Method != http.MethodGet {
+		return false
+	}
+	p := c.Request.URL.Path
+	return p == "/api/client/key-check" || p == "/v1/usage" || p == "/v1/sub2api/billing" || p == "/v1/models" || strings.HasPrefix(p, "/v1/models/")
+}
+
+// Fail closed until the corresponding handler uses one durable reservation per
+// billable operation. In particular, a WS connection is NOT one billable turn.
+// New protocol paths must add lifecycle tests before joining this allowlist.
+func realyuFundingEndpointSupported(c *gin.Context) bool {
+	if realyuFundingReadOnly(c) {
+		return true
+	}
+	if c.Request.Method != http.MethodPost || c.GetHeader("Upgrade") != "" {
+		return false
+	}
+	switch c.Request.URL.Path {
+	case "/v1/responses", "/v1/responses/compact", "/v1/chat/completions", "/v1/messages", "/v1/images/generations", "/v1/images/edits":
+		return true
+	default:
+		return false
+	}
+}
