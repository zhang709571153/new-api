+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+func (r *apiKeyRepository) GetRealYuKeyUsage(ctx context.Context, id int64) (*service.RealYuKeyUsage, error) {
+	var out service.RealYuKeyUsage
+	var models []byte
+	var teamID int64
+	rows, err := r.sql.QueryContext(ctx, `SELECT k.name,
+	  CASE WHEN l.legacy_team_id<>0 THEN l.opening_remaining_quota
+	       WHEN l.unlimited_quota THEN l.opening_remaining_quota
+	       ELSE GREATEST(0,ROUND((k.quota-k.quota_used)*500000))::bigint END,
+	  ROUND(k.quota_used*500000)::bigint,l.unlimited_quota,
+	  l.model_limits_enabled,l.model_limits,COALESCE(EXTRACT(EPOCH FROM k.expires_at)::bigint,0),l.legacy_team_id
+	  FROM api_keys k JOIN realyu_legacy_keys l ON l.api_key_id=k.id
+	  WHERE k.id=$1 AND k.deleted_at IS NULL`, id)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	if !rows.Next() {
+		return nil, rows.Err()
+	}
+	if err := rows.Scan(&out.Name, &out.TotalAvailable, &out.TotalUsed,
+		&out.UnlimitedQuota, &out.ModelLimitsEnabled, &models, &out.ExpiresAt, &teamID); err != nil {
+		return nil, err
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	if teamID != 0 {
+		out.TotalAvailable, err = realyuTeamKeyAvailable(ctx, r.sql, id)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if out.TotalAvailable < 0 || out.TotalUsed < 0 || out.TotalAvailable > service.RealYuMaxWalletQuota-out.TotalUsed {
+		return nil, errors.New("legacy key quota outside supported range")
+	}
+	if err := json.Unmarshal(models, &out.ModelLimits); err != nil {
+		return nil, err
+	}
+	out.Object = "token_usage"
+	out.TotalGranted = out.TotalAvailable + out.TotalUsed
+	return &out, nil
+}
