+func TestRealyuUsernameLoginRetainsNativeMFA(t *testing.T) {
+	settings := map[string]string{service.SettingKeyTotpEnabled: "true"}
+	svc, repo, client := newAuthServiceWithEnt(t, settings, nil)
+	realyuIdentityTable(t, client)
+	ctx := context.Background()
+	_, err := client.ExecContext(ctx, `CREATE TABLE user_avatars (
+user_id INTEGER PRIMARY KEY, storage_provider TEXT NOT NULL, storage_key TEXT NOT NULL DEFAULT '',
+url TEXT NOT NULL, content_type TEXT NOT NULL DEFAULT '', byte_size INTEGER NOT NULL DEFAULT 0,
+sha256 TEXT NOT NULL DEFAULT '', updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)`)
+	require.NoError(t, err)
+	id := realyuImportedUser(t, client, "mfa-user", "mfa"+service.RealyuLegacyEmailDomain, realyuPasswordFixture("test-password"))
+	cfg := &config.Config{}
+	cfg.Totp.EncryptionKey = strings.Repeat("1", 64)
+	encryptor, err := repository.NewAESEncryptor(cfg)
+	require.NoError(t, err)
+	secret := "JBSWY3DPEHPK3PXP"
+	encrypted, err := encryptor.Encrypt(secret)
+	require.NoError(t, err)
+	_, err = client.User.UpdateOneID(id).SetTotpEnabled(true).SetTotpSecretEncrypted(encrypted).Save(ctx)
+	require.NoError(t, err)
+	redisServer := miniredis.RunT(t)
+	rdb := redis.NewClient(&redis.Options{Addr: redisServer.Addr()})
+	t.Cleanup(func() { _ = rdb.Close() })
+	settingSvc := service.NewSettingService(&authIdentitySettingRepoStub{values: settings}, cfg)
+	totpSvc := service.NewTotpService(repo, encryptor, repository.NewTotpCache(rdb), settingSvc, nil, nil)
+	h := handler.NewAuthHandler(cfg, svc, service.NewUserService(repo, nil, nil, nil), settingSvc, nil, nil, totpSvc, nil)
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.POST("/login", h.Login)
+	router.POST("/2fa", h.Login2FA)
+	request := func(path, payload string) (int, map[string]any) {
+		r := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, path, bytes.NewBufferString(payload))
+		req.Header.Set("Content-Type", "application/json")
+		router.ServeHTTP(r, req)
+		var body struct {
+			Data map[string]any `json:"data"`
+		}
+		require.NoError(t, json.Unmarshal(r.Body.Bytes(), &body))
+		return r.Code, body.Data
+	}
+	status, pending := request("/login", `{"email":"mfa-user","password":"test-password"}`)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, pending["requires_2fa"])
+	assert.Nil(t, pending["access_token"])
+	tempToken, ok := pending["temp_token"].(string)
+	require.True(t, ok)
+	code, err := totp.GenerateCode(secret, time.Now())
+	require.NoError(t, err)
+	status, completed := request("/2fa", fmt.Sprintf(`{"temp_token":%q,"totp_code":%q}`, tempToken, code))
+	require.Equal(t, http.StatusOK, status)
+	assert.NotEmpty(t, completed["access_token"])
+	status, replay := request("/2fa", fmt.Sprintf(`{"temp_token":%q,"totp_code":%q}`, tempToken, code))
+	assert.NotEqual(t, http.StatusOK, status)
+	assert.Nil(t, replay["access_token"])
+}
