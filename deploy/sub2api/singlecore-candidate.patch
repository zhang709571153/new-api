diff --git a/frontend/src/views/user/__tests__/SubscriptionsView.loading.spec.ts b/frontend/src/views/user/__tests__/SubscriptionsView.loading.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3efbfaa69b9f516a494bf043f7966a28c0a5d87
--- /dev/null
+++ b/frontend/src/views/user/__tests__/SubscriptionsView.loading.spec.ts
@@ -0,0 +1,110 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { flushPromises, mount } from '@vue/test-utils'
+import SubscriptionsView from '../SubscriptionsView.vue'
+
+const { getMySubscriptions } = vi.hoisted(() => ({ getMySubscriptions: vi.fn() }))
+vi.mock('@/api/subscriptions', () => ({ default: { getMySubscriptions } }))
+vi.mock('@/stores/app', () => ({ useAppStore: () => ({ cachedPublicSettings: null }) }))
+vi.mock('vue-router', () => ({ useRouter: () => ({ push: vi.fn() }) }))
+vi.mock('vue-i18n', async () => {
+  const actual = await vi.importActual<typeof import('vue-i18n')>('vue-i18n')
+  return { ...actual, useI18n: () => ({ t: (key: string) => key }) }
+})
+
+function pending<T>() {
+  let resolve!: (value: T) => void
+  let reject!: (error: unknown) => void
+  const promise = new Promise<T>((yes, no) => { resolve = yes; reject = no })
+  return { promise, resolve, reject }
+}
+
+function mountView() {
+  return mount(SubscriptionsView, {
+    global: { stubs: { AppLayout: { template: '<div><slot /></div>' }, Icon: true } },
+  })
+}
+
+describe('SubscriptionsView loading outcomes', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    vi.spyOn(console, 'error').mockImplementation(() => {})
+  })
+  afterEach(() => vi.restoreAllMocks())
+
+  it('does not present an unresolved request as an empty subscription list', async () => {
+    const response = pending<unknown[]>()
+    getMySubscriptions.mockReturnValue(response.promise)
+    const wrapper = mountView()
+    expect(wrapper.text()).not.toContain('userSubscriptions.noActiveSubscriptions')
+    expect(wrapper.find('[role="alert"]').exists()).toBe(false)
+    response.resolve([])
+    await flushPromises()
+    expect(wrapper.text()).toContain('userSubscriptions.noActiveSubscriptions')
+    wrapper.unmount()
+  })
+
+  it('shows persistent failure and offers retry instead of claiming there is no subscription', async () => {
+    getMySubscriptions.mockRejectedValue(new Error('synthetic unavailable'))
+    const wrapper = mountView()
+    await flushPromises()
+    expect(wrapper.get('[role="alert"]').text()).toContain('userSubscriptions.failedToLoad')
+    expect(wrapper.text()).not.toContain('userSubscriptions.noActiveSubscriptions')
+    expect(wrapper.get('[role="alert"] button').text()).toBe('common.tryAgain')
+    wrapper.unmount()
+  })
+
+  it('shows a true empty state only after a successful retry returns an empty list', async () => {
+    getMySubscriptions.mockRejectedValueOnce(new Error('synthetic unavailable')).mockResolvedValueOnce([])
+    const wrapper = mountView()
+    await flushPromises()
+    await wrapper.get('[role="alert"] button').trigger('click')
+    await flushPromises()
+    expect(getMySubscriptions).toHaveBeenCalledTimes(2)
+    expect(wrapper.find('[role="alert"]').exists()).toBe(false)
+    expect(wrapper.text()).toContain('userSubscriptions.noActiveSubscriptions')
+    wrapper.unmount()
+  })
+
+  it('shows returned subscription data after retry without duplicate requests from rapid clicks', async () => {
+    const retry = pending<unknown[]>()
+    getMySubscriptions.mockRejectedValueOnce(new Error('synthetic unavailable')).mockReturnValueOnce(retry.promise)
+    const wrapper = mountView()
+    await flushPromises()
+    const button = wrapper.get('[role="alert"] button').element as HTMLButtonElement
+    button.click()
+    button.click()
+    expect(getMySubscriptions).toHaveBeenCalledTimes(2)
+    retry.resolve([{ id: 901, group_id: 42, group: { name: 'Synthetic subscription', platform: 'openai' }, status: 'active', expires_at: null }])
+    await flushPromises()
+    expect(wrapper.text()).toContain('Synthetic subscription')
+    expect(wrapper.text()).not.toContain('userSubscriptions.noActiveSubscriptions')
+    expect(wrapper.find('[role="alert"]').exists()).toBe(false)
+    wrapper.unmount()
+  })
+
+  it('keeps the failure state visible when a retry fails again', async () => {
+    getMySubscriptions.mockRejectedValue(new Error('synthetic unavailable'))
+    const wrapper = mountView()
+    await flushPromises()
+    await wrapper.get('[role="alert"] button').trigger('click')
+    await flushPromises()
+    expect(wrapper.find('[role="alert"]').exists()).toBe(true)
+    expect(wrapper.text()).not.toContain('userSubscriptions.noActiveSubscriptions')
+    expect(getMySubscriptions).toHaveBeenCalledTimes(2)
+    wrapper.unmount()
+  })
+
+  it.each(['resolve', 'reject'] as const)('aborts on unmount and ignores a late %s', async (outcome) => {
+    const response = pending<unknown[]>()
+    getMySubscriptions.mockReturnValue(response.promise)
+    const wrapper = mountView()
+    const signal = getMySubscriptions.mock.calls[0][0].signal as AbortSignal
+    expect(signal.aborted).toBe(false)
+    wrapper.unmount()
+    expect(signal.aborted).toBe(true)
+    if (outcome === 'resolve') response.resolve([])
+    else response.reject(new Error('synthetic late response'))
+    await flushPromises()
+    expect(console.error).not.toHaveBeenCalled()
+  })
+})
