+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+type responseScopeStub struct {
+	UsageBillingRepository
+	managed, same        bool
+	err                  error
+	calls                int
+	owner, current, user int64
+}
+
+func (s *responseScopeStub) ValidateRealYuResponseScope(_ context.Context, owner, current, user int64) (bool, bool, error) {
+	s.calls++
+	s.owner = owner
+	s.current = current
+	s.user = user
+	return s.managed, s.same, s.err
+}
+func TestRealYuResponseScopeContinuationFailsClosed(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		managed, same bool
+		err           error
+		allow         bool
+	}{
+		{"native_same_user", false, true, nil, true},
+		{"same_personal_scope", true, true, nil, true},
+		{"same_team_scope", true, true, nil, true},
+		{"team_a_to_team_b", true, false, nil, false},
+		{"team_to_personal", true, false, nil, false},
+		{"one_scope_missing", true, false, nil, false},
+		{"database_failure", false, false, errors.New("synthetic DB unavailable"), false},
+		{"feature_disabled", true, false, ErrRealYuFundingDisabled, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &responseScopeStub{managed: tc.managed, same: tc.same, err: tc.err}
+			svc := &OpenAIGatewayService{usageBillingRepo: repo}
+			ctx := context.Background()
+			require.NoError(t, svc.BindOpenAIHTTPResponseOwner(ctx, 3, "resp_synthetic", 7, 11))
+			ok, err := svc.ValidateOpenAIHTTPResponseOwner(ctx, 3, "resp_synthetic", 7, 12)
+			require.Equal(t, tc.allow, ok)
+			require.ErrorIs(t, err, tc.err)
+			require.Equal(t, 1, repo.calls)
+			require.EqualValues(t, 11, repo.owner)
+			require.EqualValues(t, 12, repo.current)
+			require.EqualValues(t, 7, repo.user)
+			ok, err = svc.ValidateOpenAIHTTPResponseOwner(ctx, 3, "resp_synthetic", 8, 12)
+			require.NoError(t, err)
+			require.False(t, ok)
+			require.Equal(t, 1, repo.calls, "different users denied before scope lookup")
+		})
+	}
+}
