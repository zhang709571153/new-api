@@ -0,0 +1,56 @@
+package routes
+
+import (
+	"context"
+	"math"
+	"net/http"
+
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/shopspring/decimal"
+)
+
+type realyuClientReader interface {
+	GetRealYuKeyUsage(context.Context, int64) (*service.RealYuKeyUsage, error)
+}
+
+func RegisterRealYuClientRoutes(r *gin.Engine, auth middleware.APIKeyAuthMiddleware, keys realyuClientReader) {
+	r.GET("/api/client/key-check", func(c *gin.Context) {
+		c.Header("Cache-Control", "no-store")
+		c.Header("Pragma", "no-cache")
+		c.Next()
+	}, gin.HandlerFunc(auth), func(c *gin.Context) {
+		key, ok := middleware.GetAPIKeyFromContext(c)
+		if !ok || key == nil || key.IsExpired() || key.Status == service.StatusAPIKeyExpired {
+			c.JSON(http.StatusUnauthorized, gin.H{"code": false, "message": "API key unavailable"})
+			return
+		}
+		usage, err := keys.GetRealYuKeyUsage(c.Request.Context(), key.ID)
+		if err != nil {
+			c.JSON(http.StatusServiceUnavailable, gin.H{"code": false, "message": "Key inspection temporarily unavailable"})
+			return
+		}
+		if usage == nil {
+			// New native keys use the same client installation contract. The
+			// endpoint verifies identity, not eligibility to buy a model request.
+			if math.IsNaN(key.QuotaUsed) || math.IsInf(key.QuotaUsed, 0) || math.IsNaN(key.Quota) || math.IsInf(key.Quota, 0) || key.Quota < 0 {
+				c.JSON(http.StatusServiceUnavailable, gin.H{"code": false, "message": "Key quota unavailable"})
+				return
+			}
+			used := decimal.NewFromFloat(key.QuotaUsed).Mul(decimal.NewFromInt(service.RealYuQuotaPerUSD)).Round(0)
+			quota := decimal.NewFromFloat(key.Quota).Mul(decimal.NewFromInt(service.RealYuQuotaPerUSD)).Round(0)
+			if used.IsNegative() || used.GreaterThan(decimal.NewFromInt(service.RealYuMaxWalletQuota)) || quota.GreaterThan(decimal.NewFromInt(service.RealYuMaxWalletQuota)) {
+				c.JSON(http.StatusServiceUnavailable, gin.H{"code": false, "message": "Key quota unavailable"})
+				return
+			}
+			usage = &service.RealYuKeyUsage{Object: "token_usage", Name: key.Name, TotalUsed: used.IntPart(),
+				TotalGranted: quota.IntPart(), TotalAvailable: max(0, quota.Sub(used).IntPart()),
+				UnlimitedQuota: key.Quota <= 0, ModelLimits: map[string]bool{}}
+			if key.ExpiresAt != nil {
+				usage.ExpiresAt = key.ExpiresAt.Unix()
+			}
+		}
+		c.JSON(http.StatusOK, gin.H{"code": true, "message": "ok", "data": usage})
+	})
+}
