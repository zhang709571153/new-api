+// getZPayQuery is deliberately separate from the generic POST transport. ZPay
+// requires merchant credentials in the query string, so redirects are rejected
+// and transport errors must never include the request URL or secret.
+func (e *EasyPay) getZPayQuery(ctx context.Context, endpoint string, params map[string]string) ([]byte, error) {
+	parsed, err := url.Parse(endpoint)
+	if err != nil {
+		return nil, fmt.Errorf("invalid zpay query endpoint")
+	}
+	query := parsed.Query()
+	for k, v := range params {
+		query.Set(k, v)
+	}
+	parsed.RawQuery = query.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, parsed.String(), nil)
+	if err != nil {
+		return nil, fmt.Errorf("invalid zpay query request")
+	}
+	req.Header.Set("Accept", "application/json")
+	client := http.Client{Timeout: easypayHTTPTimeout}
+	if e.httpClient != nil {
+		client = *e.httpClient
+	}
+	client.CheckRedirect = func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }
+	resp, err := client.Do(req)
+	if err != nil {
+		var urlErr *url.Error
+		if errors.As(err, &urlErr) {
+			err = urlErr.Err
+		}
+		return nil, fmt.Errorf("zpay query request failed: %w", err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
+		return nil, fmt.Errorf("zpay query HTTP %d", resp.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxEasypayResponseSize+1))
+	if err != nil {
+		return nil, fmt.Errorf("zpay query response read failed: %w", err)
+	}
+	if len(body) > maxEasypayResponseSize {
+		return nil, fmt.Errorf("zpay query response exceeds size limit")
+	}
+	if len(bytes.TrimSpace(body)) == 0 {
+		return nil, fmt.Errorf("zpay query returned an empty response")
+	}
+	return body, nil
+}
