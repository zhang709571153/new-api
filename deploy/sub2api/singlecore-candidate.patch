+	require.NoError(t, err)
+	return db, dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+}
+
+func enrollmentKey(user int64, name string) *service.APIKey {
+	group := int64(101) // Deliberately matches a team ID; it is NOT a team scope.
+	return &service.APIKey{UserID: user, Key: "synthetic-" + name, Name: name, Status: service.StatusActive, GroupID: &group}
+}
+
+func TestRealYuFundingPGKeyEnrollmentPersonalAndNative(t *testing.T) {
+	db, client := realyuKeyEnrollmentPG(t)
+	r := NewAPIKeyRepository(client, db)
+	ctx := context.Background()
+	for _, user := range []int64{1, 2, 3} {
+		key := enrollmentKey(user, []string{"", "legacy", "username", "native"}[user])
+		require.NoError(t, r.Create(ctx, key))
+		require.GreaterOrEqual(t, key.ID, int64(1000))
+		scope, err := NewRealYuFundingRepository(db, true).Resolve(ctx, key.ID, user)
+		require.NoError(t, err)
+		if user == 3 {
+			require.Nil(t, scope)
+			scope, err = NewRealYuFundingRepository(db, false).Resolve(ctx, key.ID, user)
+			require.NoError(t, err)
+			require.Nil(t, scope)
+		} else {
+			require.Equal(t, &service.RealYuFundingScope{APIKeyID: key.ID, ActorUserID: user, PayerUserID: user}, scope)
+			_, err = NewRealYuFundingRepository(db, false).Resolve(ctx, key.ID, user)
+			require.ErrorIs(t, err, service.ErrRealYuFundingDisabled)
+		}
+	}
+	// Re-applying default enrollment cannot replace an imported member's payer/team.
+	require.NoError(t, enrollRealYuPersonalKey(ctx, db, 12, 2))
+	scope, err := NewRealYuFundingRepository(db, true).Resolve(ctx, 12, 2)
+	require.NoError(t, err)
+	require.Equal(t, &service.RealYuFundingScope{APIKeyID: 12, ActorUserID: 2, PayerUserID: 1, TeamID: 101}, scope)
+}
+
+func TestRealYuFundingPGKeyEnrollmentAtomicRollback(t *testing.T) {
+	db, client := realyuKeyEnrollmentPG(t)
+	r := NewAPIKeyRepository(client, db)
+	ctx := context.Background()
+	// A real SQL failure after Ent inserted the key must roll back the whole key.
+	_, err := db.Exec(`ALTER TABLE realyu_key_scopes ADD CONSTRAINT synthetic_reject_new CHECK(api_key_id<1000)`)
+	require.NoError(t, err)
+	key := enrollmentKey(1, "scope-write-fails")
+	require.Error(t, r.Create(ctx, key))
+	require.Zero(t, key.ID)
+	require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM api_keys WHERE key='synthetic-scope-write-fails'`))
+	_, err = db.Exec(`ALTER TABLE realyu_key_scopes DROP CONSTRAINT synthetic_reject_new`)
+	require.NoError(t, err)
+	for _, injectClient := range []bool{false, true} {
+		t.Run(map[bool]string{false: "context_transaction", true: "injected_transaction_client"}[injectClient], func(t *testing.T) {
+			tx, err := client.Tx(ctx)
+			require.NoError(t, err)
+			defer tx.Rollback()
+			key := enrollmentKey(2, "outer-rollback")
+			if injectClient {
+				err = NewAPIKeyRepository(tx.Client(), db).Create(ctx, key)
+			} else {
+				err = r.Create(dbent.NewTxContext(ctx, tx), key)
+			}
+			require.NoError(t, err)
+			rows, err := tx.Client().QueryContext(ctx, `SELECT COUNT(*) FROM realyu_key_scopes WHERE api_key_id=$1`, key.ID)
+			require.NoError(t, err)
+			require.True(t, rows.Next())
+			var count int
+			require.NoError(t, rows.Scan(&count))
+			require.Equal(t, 1, count)
+			require.NoError(t, rows.Close())
+			require.NoError(t, tx.Rollback())
+			require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM api_keys WHERE key='synthetic-outer-rollback'`))
+			require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM realyu_key_scopes WHERE api_key_id>=1000`))
+		})
+	}
+}
