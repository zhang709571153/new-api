@@ -0,0 +1,109 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/base64"
+	"fmt"
+	"strings"
+	"unicode/utf8"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"golang.org/x/crypto/argon2"
+	"golang.org/x/crypto/bcrypt"
+)
+
+const (
+	RealyuLegacySignupSource                    = "realyu_legacy"
+	RealyuUsernameSignupSource                  = "realyu_username"
+	SettingKeyRealyuUsernameRegistrationEnabled = "realyu_username_registration_enabled"
+	RealyuLegacyEmailDomain                     = "@realyu-legacy.invalid"
+	legacyPasswordMemory                        = 19 * 1024
+	legacyPasswordTime                          = 2
+)
+
+// LegacyLoginRepository resolves only aliases installed by the offline importer
+// or the explicit username registration flow.
+// Native editable profile usernames must never become authentication aliases.
+type LegacyLoginRepository interface {
+	GetByLegacyLoginName(context.Context, string) (*User, error)
+}
+
+type UsernameRegistrationRepository interface {
+	CreateWithUsernameIdentity(context.Context, *User, string) error
+}
+
+func (u *User) HasUsernameIdentity() bool {
+	return u != nil && (u.SignupSource == RealyuLegacySignupSource || u.SignupSource == RealyuUsernameSignupSource)
+}
+
+func (s *SettingService) IsUsernameRegistrationEnabled(ctx context.Context) bool {
+	value, err := s.settingRepo.GetValue(ctx, SettingKeyRealyuUsernameRegistrationEnabled)
+	return err == nil && value == "true"
+}
+
+// HasVerifiedRecoveryEmail deliberately excludes imported, unverified addresses,
+// including real addresses copied from the old system without verification proof.
+func (u *User) HasVerifiedRecoveryEmail() bool {
+	return u != nil && u.Email != "" && !isReservedEmail(u.Email) &&
+		(!u.HasUsernameIdentity() || u.LegacyEmailVerifiedAt != nil)
+}
+
+func (u *User) PublicEmail() string {
+	if u == nil || (u.HasUsernameIdentity() && !u.HasVerifiedRecoveryEmail()) {
+		return ""
+	}
+	return u.Email
+}
+
+func (u *User) PasswordMinimumLength() int {
+	if u.HasUsernameIdentity() && !u.TotpEnabled {
+		return 15
+	}
+	return 8
+}
+
+// checkAccountPassword supports the exact bounded Argon2id format emitted by
+// RealYu and native bcrypt. Plaintext is never trimmed, normalized or truncated.
+func checkAccountPassword(password, encoded string) bool {
+	if password == "" || len(password) > 128*utf8.UTFMax || len(encoded) > 256 {
+		return false
+	}
+	if strings.HasPrefix(encoded, "$argon2id$") {
+		parts := strings.Split(encoded, "$")
+		if len(parts) != 6 || parts[0] != "" || parts[1] != "argon2id" || parts[2] != "v=19" || parts[3] != "m=19456,t=2,p=1" {
+			return false
+		}
+		salt, err := base64.RawStdEncoding.Strict().DecodeString(parts[4])
+		if err != nil || len(salt) != 16 {
+			return false
+		}
+		expected, err := base64.RawStdEncoding.Strict().DecodeString(parts[5])
+		if err != nil || len(expected) != 32 {
+			return false
+		}
+		actual := argon2.IDKey([]byte(password), salt, legacyPasswordTime, legacyPasswordMemory, 1, 32)
+		return subtle.ConstantTimeCompare(actual, expected) == 1
+	}
+	if len(password) > 72 {
+		return false
+	}
+	cost, err := bcrypt.Cost([]byte(encoded))
+	if err != nil || cost > 16 {
+		return false
+	}
+	return bcrypt.CompareHashAndPassword([]byte(encoded), []byte(password)) == nil
+}
+
+func hashLegacyAccountPassword(password string, minimumLength int) (string, error) {
+	if !utf8.ValidString(password) || utf8.RuneCountInString(password) < minimumLength || utf8.RuneCountInString(password) > 128 {
+		return "", infraerrors.BadRequest("INVALID_PASSWORD", fmt.Sprintf("password must contain between %d and 128 characters", minimumLength))
+	}
+	salt := make([]byte, 16)
+	if _, err := rand.Read(salt); err != nil {
+		return "", fmt.Errorf("generate password salt: %w", err)
+	}
+	key := argon2.IDKey([]byte(password), salt, legacyPasswordTime, legacyPasswordMemory, 1, 32)
+	return fmt.Sprintf("$argon2id$v=19$m=19456,t=2,p=1$%s$%s", base64.RawStdEncoding.EncodeToString(salt), base64.RawStdEncoding.EncodeToString(key)), nil
+}
