+func TestRealYuFundingPGUnmappedManagedKeyFailsClosed(t *testing.T) {
+	db, _ := realyuKeyEnrollmentPG(t)
+	_, err := db.Exec(`INSERT INTO api_keys(id,user_id) VALUES(20,1),(21,1),(22,3),(23,3)`)
+	require.NoError(t, err)
+	ctx := context.Background()
+	for _, enabled := range []bool{false, true} {
+		funds := NewRealYuFundingRepository(db, enabled)
+		_, err = funds.Resolve(ctx, 20, 1)
+		want := service.ErrRealYuFundingScope
+		if !enabled {
+			want = service.ErrRealYuFundingDisabled
+		}
+		require.ErrorIs(t, err, want)
+		billing := NewUsageBillingRepositoryWithRealYuFunding(db, enabled).(*usageBillingRepository)
+		managed, same, err := billing.ValidateRealYuResponseScope(ctx, 20, 21, 1)
+		require.True(t, managed)
+		require.False(t, same)
+		require.ErrorIs(t, err, want)
+		_, err = billing.Apply(ctx, &service.UsageBillingCommand{RequestID: "must-not-native-fallback", APIKeyID: 20, UserID: 1, BalanceCost: 1})
+		if enabled {
+			want = service.ErrRealYuFundingNotReserved
+		}
+		require.ErrorIs(t, err, want)
+		require.Equal(t, "10.00000000", balanceFunding(t, db, 1))
+		require.Zero(t, intFunding(t, db, `SELECT COUNT(*) FROM usage_billing_dedup`))
+		managed, same, err = billing.ValidateRealYuResponseScope(ctx, 22, 23, 3)
+		require.NoError(t, err)
+		require.False(t, managed)
+		require.True(t, same)
+	}
+	// Native user remains on the stock ledger even in the default-disabled mode.
+	_, err = db.Exec(`UPDATE users SET balance=2 WHERE id=3`)
+	require.NoError(t, err)
+	_, err = NewUsageBillingRepository(nil, db).Apply(ctx, &service.UsageBillingCommand{RequestID: "native-stock-bill", APIKeyID: 22, UserID: 3, BalanceCost: 1})
+	require.NoError(t, err)
+	require.Equal(t, "1.00000000", balanceFunding(t, db, 3))
+}
