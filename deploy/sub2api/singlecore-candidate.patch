+		want       int
+	}{
+		{"allowed", `{"model":"allowed"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 200},
+		{"denied", `{"model":"denied"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"duplicate-denied-first", `{"model":"denied","model":"allowed"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"duplicate-denied-last", `{"model":"allowed","model":"denied"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{"allowed": true}}}, 403},
+		{"empty-allowlist", `{"model":"allowed"}`, realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: map[string]bool{}}}, 403},
+		{"stock-key", `{"model":"any"}`, realyuPolicyFake{}, 200},
+		{"database-unavailable", `{"model":"allowed"}`, realyuPolicyFake{err: errors.New("synthetic")}, 503},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := gin.New()
+			r.Use(func(c *gin.Context) { c.Set(string(ContextKeyAPIKey), &service.APIKey{ID: 1}); c.Next() })
+			r.Use(RealYuLegacyKeyPolicy(tc.reader))
+			called := false
+			r.POST("/v1/responses", func(c *gin.Context) {
+				called = true
+				b, err := io.ReadAll(c.Request.Body)
+				require.NoError(t, err)
+				require.Equal(t, tc.body, string(b))
+				c.Status(http.StatusOK)
+			})
+			w := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(tc.body))
+			req.Header.Set("Content-Type", "application/json")
+			r.ServeHTTP(w, req)
+			require.Equal(t, tc.want, w.Code)
+			require.Equal(t, tc.want == 200, called)
+		})
+	}
+}
+
+func runRealYuPolicyRequest(t *testing.T, method, route, requestURL, contentType string, body []byte, allowed ...string) (int, bool) {
+	t.Helper()
+	limits := make(map[string]bool, len(allowed))
+	for _, model := range allowed {
+		limits[model] = true
+	}
+	reader := realyuPolicyFake{usage: &service.RealYuKeyUsage{ModelLimitsEnabled: true, ModelLimits: limits}}
+	r := gin.New()
+	r.Use(func(c *gin.Context) {
+		c.Set(string(ContextKeyAPIKey), &service.APIKey{ID: 1})
+		c.Next()
+	}, RealYuLegacyKeyPolicy(reader))
+	called := false
+	r.Handle(method, route, func(c *gin.Context) {
+		called = true
+		got, err := io.ReadAll(c.Request.Body)
+		require.NoError(t, err)
+		require.Equal(t, body, got, "authorization must preserve the downstream body")
+		c.Status(http.StatusOK)
+	})
+	req := httptest.NewRequest(method, requestURL, bytes.NewReader(body))
+	req.Header.Set("Content-Type", contentType)
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	return w.Code, called
+}
