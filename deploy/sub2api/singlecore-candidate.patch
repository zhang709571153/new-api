+func TestRealyuUsernameRegistrationAndCollision(t *testing.T) {
+	settings := map[string]string{service.SettingKeyRegistrationEnabled: "true", service.SettingKeyRealyuUsernameRegistrationEnabled: "true"}
+	svc, repo, client := newAuthServiceWithEnt(t, settings, nil)
+	realyuIdentityTable(t, client)
+	ctx := context.Background()
+	oldToken, u, err := svc.RegisterWithUsername(ctx, "new-user", "New nickname", "", "new-password-123", "", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, "New nickname", u.Username)
+	assert.Empty(t, u.PublicEmail())
+	assert.True(t, strings.HasPrefix(u.PasswordHash, "$argon2id$"))
+	_, loggedIn, err := svc.Login(ctx, "new-user", "new-password-123")
+	require.NoError(t, err)
+	assert.Equal(t, u.ID, loggedIn.ID)
+	_, _, err = svc.Login(ctx, u.Email, "new-password-123")
+	assert.ErrorIs(t, err, service.ErrInvalidCredentials)
+	_, _, err = svc.RegisterWithUsername(ctx, "new-user", "Different nickname", "", "other-passphrase-123", "", "", "")
+	assert.ErrorIs(t, err, service.ErrLoginNameUnavailable)
+	count, err := client.User.Query().Count(ctx)
+	require.NoError(t, err)
+	assert.Equal(t, 1, count, "failed alias insert must roll back the new user")
+	_, _, err = svc.RegisterWithUsername(ctx, "mail@example.com", "", "", "new-password", "", "", "")
+	assert.Error(t, err, "new usernames cannot occupy the email namespace")
+	unicodeName := strings.Repeat("𐐀", 64)
+	_, unicodeUser, err := svc.RegisterWithUsername(ctx, unicodeName, "Unicode nickname", "", "new-password-123", "", "", "")
+	require.NoError(t, err)
+	_, unicodeLogin, err := svc.Login(ctx, unicodeName, "new-password-123")
+	require.NoError(t, err)
+	assert.Equal(t, unicodeUser.ID, unicodeLogin.ID)
+	settings[service.SettingKeyRealyuUsernameRegistrationEnabled] = "false"
+	_, _, err = svc.RegisterWithUsername(ctx, "disabled-mode", "", "", "new-password", "", "", "")
+	assert.ErrorIs(t, err, service.ErrRegDisabled)
+	_, native, err := svc.Register(ctx, "native@example.com", "native-password")
+	require.NoError(t, err)
+	_, gotNative, err := svc.Login(ctx, native.Email, "native-password")
+	require.NoError(t, err)
+	assert.Equal(t, native.ID, gotNative.ID)
+	userSvc := service.NewUserService(repo, nil, nil, nil)
+	require.NoError(t, userSvc.ChangePassword(ctx, u.ID, service.ChangePasswordRequest{CurrentPassword: "new-password-123", NewPassword: strings.Repeat("新密码", 30)}))
+	_, err = svc.RefreshToken(ctx, oldToken)
+	assert.ErrorIs(t, err, service.ErrTokenRevoked, "password change invalidates previous access token")
