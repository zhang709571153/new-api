+func TestRealyuImportedIdentityLoginAndNickname(t *testing.T) {
+	svc, repo, client := newAuthServiceWithEnt(t, nil, nil)
+	realyuIdentityTable(t, client)
+	ctx := context.Background()
+	password := "  " + strings.Repeat("旧密码", 12) + "  "
+	id := realyuImportedUser(t, client, "CaseSensitive", "imported@example.com", realyuPasswordFixture(password))
+	token, u, err := svc.Login(ctx, "CaseSensitive", password)
