@@ -0,0 +1,51 @@
+package repository
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+func (r *usageBillingRepository) ValidateRealYuResponseScope(ctx context.Context, ownerKeyID, currentKeyID, userID int64) (managed, same bool, err error) {
+	if r == nil || r.db == nil {
+		return false, false, service.ErrRealYuFundingDisabled
+	}
+	rows, err := r.db.QueryContext(ctx, `SELECT api_key_id,actor_user_id,COALESCE(team_id,0) FROM realyu_key_scopes WHERE api_key_id IN ($1,$2)`, ownerKeyID, currentKeyID)
+	if err != nil {
+		return false, false, err
+	}
+	defer rows.Close()
+	type subject struct{ actor, team int64 }
+	scopes := map[int64]subject{}
+	for rows.Next() {
+		var key int64
+		var s subject
+		if err = rows.Scan(&key, &s.actor, &s.team); err != nil {
+			return false, false, err
+		}
+		scopes[key] = s
+	}
+	if err = rows.Err(); err != nil {
+		return false, false, err
+	}
+	if len(scopes) == 0 {
+		for _, keyID := range []int64{ownerKeyID, currentKeyID} {
+			managed, err := realyuKeyRequiresFunding(ctx, r.db, keyID)
+			if err != nil {
+				return false, false, err
+			}
+			if managed {
+				if !r.realyuFundingEnabled {
+					return true, false, service.ErrRealYuFundingDisabled
+				}
+				return true, false, service.ErrRealYuFundingScope
+			}
+		}
+		return false, true, nil
+	}
+	if !r.realyuFundingEnabled {
+		return true, false, service.ErrRealYuFundingDisabled
+	}
+	owner, ownerFound := scopes[ownerKeyID]
+	current, currentFound := scopes[currentKeyID]
+	return true, ownerFound && currentFound && userID > 0 && owner.actor == userID && current.actor == userID && owner.team == current.team, nil
+}
