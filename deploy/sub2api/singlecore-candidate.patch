@@ -0,0 +1,23 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+)
+
+func realyuFundingRequiresPricing(ctx context.Context, key *APIKey) bool {
+	return RealYuFundingFromContext(ctx) != nil || (key != nil && key.RealYuFunding != nil)
+}
+
+// Missing or invalid pricing is not an explicit free price. Keep admitted work
+// reserved for reconciliation; never manufacture a zero-cost settlement.
+func realyuFundingPricingFailure(ctx context.Context, err error) error {
+	requestID := ""
+	if hold := RealYuFundingFromContext(ctx); hold != nil {
+		hold.Submitted()
+		requestID = hold.Request(0).RequestID
+	}
+	slog.Error("realyu funding pricing failed; reservation requires reconciliation", "request_id", requestID)
+	return fmt.Errorf("realyu funding settlement pricing failed: %w", err)
+}
