+package service
+
+import "context"
+
+// RealYuKeyUsage retains the installed client's integer-quota JSON contract.
+// The credential itself and upstream/internal-credit identities are never sent.
+type RealYuKeyUsage struct {
+	Object             string          `json:"object"`
+	Name               string          `json:"name"`
+	TotalGranted       int64           `json:"total_granted"`
+	TotalUsed          int64           `json:"total_used"`
+	TotalAvailable     int64           `json:"total_available"`
+	UnlimitedQuota     bool            `json:"unlimited_quota"`
+	ModelLimits        map[string]bool `json:"model_limits"`
+	ModelLimitsEnabled bool            `json:"model_limits_enabled"`
+	ExpiresAt          int64           `json:"expires_at"`
+}
+
+type realYuClientRepository interface {
+	GetRealYuKeyUsage(context.Context, int64) (*RealYuKeyUsage, error)
+}
+
+func (s *APIKeyService) GetRealYuKeyUsage(ctx context.Context, keyID int64) (*RealYuKeyUsage, error) {
+	if s == nil {
+		return nil, nil
+	}
+	repo, ok := s.apiKeyRepo.(realYuClientRepository)
+	if !ok {
+		return nil, nil
+	}
+	return repo.GetRealYuKeyUsage(ctx, keyID)
+}
diff --git a/backend/internal/service/realyu_funding.go b/backend/internal/service/realyu_funding.go
new file mode 100644
index 0000000000000000000000000000000000000000..233e7cdefe4631bd428ec432a95be4e044200237
--- /dev/null
+++ b/backend/internal/service/realyu_funding.go
@@ -0,0 +1,99 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"math"
+	"strings"
+
+	"github.com/shopspring/decimal"
+)
+
+const RealYuQuotaPerUSD int64 = 500000
+const RealYuMaxRequestQuota int64 = 2147483647
+const RealYuMaxWalletQuota int64 = 9007199254740991
+
+var (
+	ErrRealYuFundingDisabled     = errors.New("realyu funding is disabled")
+	ErrRealYuFundingScope        = errors.New("realyu funding scope is unavailable")
+	ErrRealYuFundingInsufficient = errors.New("realyu funding allowance is insufficient")
+	ErrRealYuFundingConflict     = errors.New("realyu funding request conflicts with its durable snapshot")
+	ErrRealYuFundingRange        = errors.New("realyu funding amount is out of range")
+	ErrRealYuFundingNotReserved  = errors.New("realyu funding request has not been reserved")
+)
+
+type RealYuFundingScope struct {
+	APIKeyID    int64 `json:"api_key_id"`
+	ActorUserID int64 `json:"actor_user_id"`
+	PayerUserID int64 `json:"payer_user_id"`
+	TeamID      int64 `json:"team_id"` // zero is the personal scope; SQL uses NULL.
+}
+
+type RealYuFundingRequest struct {
+	RequestID   string
+	APIKeyID    int64
+	ActorUserID int64
+	TargetQuota int64  // absolute amount, never an increment
+	Fingerprint string // stable server-computed request payload hash
+}
+
+type RealYuFundingReceipt struct {
+	RealYuFundingScope
+	RequestID         string `json:"request_id"`
+	Status            string `json:"status"`
+	SubscriptionID    int64  `json:"subscription_id"`
+	WeeklyResetAt     int64  `json:"weekly_reset_at"`
+	SubscriptionQuota int64  `json:"subscription_quota"`
+	WalletQuota       int64  `json:"wallet_quota"`
+	TargetQuota       int64  `json:"target_quota"`
+	OverageQuota      int64  `json:"overage_quota"`
+	WalletBalanceUSD  string `json:"wallet_balance_usd,omitempty"` // exact decimal, no float API
+	Applied           bool   `json:"applied"`
+}
+
+// Reservations are durable. Settle through native UsageBillingRepository.Apply
+// so payer funding, key/account usage counters and usage dedup commit together.
+// Refund only releases a still-reserved request; settled consumption is final.
+type RealYuFundingRepository interface {
+	Resolve(context.Context, int64, int64) (*RealYuFundingScope, error)
+	Reserve(context.Context, RealYuFundingRequest) (*RealYuFundingReceipt, error)
+	Refund(context.Context, RealYuFundingRequest) (*RealYuFundingReceipt, error)
+}
+
+func (r RealYuFundingRequest) Validate() error {
+	if r.APIKeyID <= 0 || r.ActorUserID <= 0 || strings.TrimSpace(r.RequestID) == "" || len(r.RequestID) > 256 || len(r.Fingerprint) > 256 {
+		return ErrRealYuFundingScope
+	}
+	if r.TargetQuota < 0 || r.TargetQuota > RealYuMaxRequestQuota {
+		return ErrRealYuFundingRange
+	}
+	return nil
+}
+
+// Native Sub pricing currently produces float64. Convert its shortest decimal
+// representation ONCE at the boundary, round half away from zero to quota, and
+// use integers/exact NUMERIC thereafter. No epsilon comparisons are permitted.
+func RealYuQuotaFromUSD(cost float64) (int64, error) {
+	if math.IsNaN(cost) || math.IsInf(cost, 0) || cost < 0 {
+		return 0, ErrRealYuFundingRange
+	}
+	return RealYuQuotaFromDecimalUSD(decimal.NewFromFloat(cost))
+}
+
+func RealYuQuotaFromDecimalUSD(cost decimal.Decimal) (int64, error) {
+	if cost.IsNegative() {
+		return 0, ErrRealYuFundingRange
+	}
+	q := cost.Mul(decimal.NewFromInt(RealYuQuotaPerUSD)).Round(0)
+	if q.GreaterThan(decimal.NewFromInt(RealYuMaxRequestQuota)) {
+		return 0, ErrRealYuFundingRange
+	}
+	return q.IntPart(), nil
+}
+
+func RealYuUSDFromQuota(quota int64) (string, error) {
+	if quota < -RealYuMaxWalletQuota || quota > RealYuMaxWalletQuota {
+		return "", ErrRealYuFundingRange
+	}
+	return decimal.NewFromInt(quota).Div(decimal.NewFromInt(RealYuQuotaPerUSD)).StringFixed(8), nil
+}
