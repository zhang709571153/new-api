+package repository
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/shopspring/decimal"
+)
+
+type RealYuFundingRepository struct {
+	db      *sql.DB
+	enabled bool
+	now     func() time.Time
+}
+
+func NewRealYuFundingRepository(db *sql.DB, enabled bool) *RealYuFundingRepository {
+	return &RealYuFundingRepository{db: db, enabled: enabled, now: time.Now}
+}
+
+// Called only on the API-key creation transaction. A group is a routing pool,
+// never a team identity. Imported team bindings remain immutable on conflict.
+func enrollRealYuPersonalKey(ctx context.Context, exec sqlExecutor, keyID, userID int64) error {
+	_, err := exec.ExecContext(ctx, `INSERT INTO realyu_key_scopes(api_key_id,actor_user_id,payer_user_id,team_id)
+        SELECT $1,u.id,u.id,NULL FROM users u WHERE u.id=$2
+        AND u.signup_source IN ('realyu_legacy','realyu_username')
+        ON CONFLICT(api_key_id) DO NOTHING`, keyID, userID)
+	return err
+}
+
+// Persistent ownership, not a cache or feature flag, decides whether stock
+// billing is forbidden. Incomplete imports/older unbound keys fail closed.
+func realyuKeyRequiresFunding(ctx context.Context, exec sqlExecutor, keyID int64) (bool, error) {
+	rows, err := exec.QueryContext(ctx, `SELECT
+        EXISTS(SELECT 1 FROM realyu_key_scopes WHERE api_key_id=$1) OR
+        EXISTS(SELECT 1 FROM api_keys k JOIN users u ON u.id=k.user_id
+         WHERE k.id=$1 AND u.signup_source IN ('realyu_legacy','realyu_username'))`, keyID)
+	if err != nil {
+		return false, err
+	}
+	defer rows.Close()
+	if !rows.Next() {
+		if err = rows.Err(); err != nil {
+			return false, err
+		}
+		return false, sql.ErrNoRows
+	}
+	var managed bool
+	err = rows.Scan(&managed)
+	return managed, err
+}
+
+func (r *RealYuFundingRepository) Resolve(ctx context.Context, keyID, actorID int64) (*service.RealYuFundingScope, error) {
+	var s service.RealYuFundingScope
+	err := r.db.QueryRowContext(ctx, `SELECT api_key_id,actor_user_id,payer_user_id,COALESCE(team_id,0)
+        FROM realyu_key_scopes WHERE api_key_id=$1`, keyID).Scan(&s.APIKeyID, &s.ActorUserID, &s.PayerUserID, &s.TeamID)
+	if errors.Is(err, sql.ErrNoRows) {
+		managed, lookupErr := realyuKeyRequiresFunding(ctx, r.db, keyID)
+		if lookupErr != nil {
+			return nil, lookupErr
+		}
+		if managed {
+			if !r.enabled {
+				return nil, service.ErrRealYuFundingDisabled
+			}
+			return nil, service.ErrRealYuFundingScope
+		}
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !r.enabled {
+		return nil, service.ErrRealYuFundingDisabled
+	}
+	if s.ActorUserID != actorID {
+		return nil, service.ErrRealYuFundingScope
+	}
+	var valid bool
+	err = r.db.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM api_keys k JOIN users u ON u.id=k.user_id
+		JOIN users payer ON payer.id=$4
+		WHERE k.id=$1 AND k.user_id=$2 AND u.status='active' AND u.deleted_at IS NULL AND k.deleted_at IS NULL
+		AND payer.status='active' AND payer.deleted_at IS NULL
+		AND ($3=0 OR EXISTS(SELECT 1 FROM realyu_teams t JOIN realyu_team_members m ON m.team_id=t.id
+		 WHERE t.id=$3 AND t.owner_user_id=$4 AND t.closed_at=0 AND m.user_id=$2 AND m.status='active')))`, s.APIKeyID, s.ActorUserID, s.TeamID, s.PayerUserID).Scan(&valid)
+	if err != nil {
+		return nil, err
+	}
+	if !valid {
+		return nil, service.ErrRealYuFundingScope
+	}
+	return &s, nil
+}
+
+func (r *RealYuFundingRepository) Reserve(ctx context.Context, req service.RealYuFundingRequest) (*service.RealYuFundingReceipt, error) {
+	return r.apply(ctx, req, "reserve")
+}
+func (r *RealYuFundingRepository) Refund(ctx context.Context, req service.RealYuFundingRequest) (*service.RealYuFundingReceipt, error) {
+	req.TargetQuota = 0
+	return r.apply(ctx, req, "refund")
+}
+func (r *RealYuFundingRepository) apply(ctx context.Context, req service.RealYuFundingRequest, action string) (*service.RealYuFundingReceipt, error) {
+	if !r.enabled {
+		return nil, service.ErrRealYuFundingDisabled
+	}
+	if err := req.Validate(); err != nil {
+		return nil, err
+	}
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	out, err := applyRealYuFundingTx(ctx, tx, req, action, r.now().Unix())
+	if err != nil {
+		return nil, err
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+type fundingRecord struct {
+	service.RealYuFundingReceipt
+	fingerprint      string
+	overflow, exempt bool
+}
+type fundingSubscription struct {
+	id, user, team, total, used, weekly, weekUsed, reset, start, end, price int64
+	status, source                                                          string
+	overflow                                                                bool
+}
+
+const fundingRecordSelect = `SELECT request_id,api_key_id,actor_user_id,payer_user_id,COALESCE(team_id,0),
+    COALESCE(subscription_id,0),weekly_reset_at,request_fingerprint,status,subscription_quota,wallet_quota,
+    target_quota,allow_wallet_overflow,member_cap_exempt,overage_quota FROM realyu_funding_requests
+    WHERE request_id=$1 AND api_key_id=$2`
+
+func readFundingRecord(ctx context.Context, tx *sql.Tx, req service.RealYuFundingRequest, lock bool) (*fundingRecord, error) {
+	q := fundingRecordSelect
+	if lock {
+		q += " FOR UPDATE"
+	}
+	v := new(fundingRecord)
+	err := tx.QueryRowContext(ctx, q, req.RequestID, req.APIKeyID).Scan(&v.RequestID, &v.APIKeyID, &v.ActorUserID, &v.PayerUserID, &v.TeamID,
+		&v.SubscriptionID, &v.WeeklyResetAt, &v.fingerprint, &v.Status, &v.SubscriptionQuota, &v.WalletQuota, &v.TargetQuota, &v.overflow, &v.exempt, &v.OverageQuota)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	return v, err
+}
+
+// Every scope serializes on its durable funding principal before touching a
+// reservation/subscription/member period. Team closure or key removal never
+// changes the immutable payer of previously admitted work.
+func applyRealYuFundingTx(ctx context.Context, tx *sql.Tx, req service.RealYuFundingRequest, action string, now int64) (*service.RealYuFundingReceipt, error) {
+	if err := req.Validate(); err != nil {
+		return nil, err
+	}
+	rec, err := readFundingRecord(ctx, tx, req, false)
+	if err != nil {
+		return nil, err
+	}
+	var scope service.RealYuFundingScope
+	if rec != nil {
+		scope = rec.RealYuFundingScope
+	} else {
+		if action != "reserve" {
+			return nil, service.ErrRealYuFundingNotReserved
+		}
+		err = tx.QueryRowContext(ctx, `SELECT api_key_id,actor_user_id,payer_user_id,COALESCE(team_id,0) FROM realyu_key_scopes WHERE api_key_id=$1`, req.APIKeyID).
+			Scan(&scope.APIKeyID, &scope.ActorUserID, &scope.PayerUserID, &scope.TeamID)
+		if err != nil {
+			return nil, service.ErrRealYuFundingScope
+		}
+	}
+	if scope.ActorUserID != req.ActorUserID {
+		return nil, service.ErrRealYuFundingScope
+	}
+	var balance decimal.Decimal
+	var closed, owner int64
+	if scope.TeamID > 0 {
+		err = tx.QueryRowContext(ctx, `SELECT owner_user_id,closed_at FROM realyu_teams WHERE id=$1 FOR UPDATE`, scope.TeamID).Scan(&owner, &closed)
+		if err != nil {
+			return nil, err
+		}
+		if action == "reserve" && (closed != 0 || owner != scope.PayerUserID) {
+			return nil, service.ErrRealYuFundingScope
+		}
+	} else {
+		var value string
+		err = tx.QueryRowContext(ctx, `SELECT balance::text FROM users WHERE id=$1 FOR UPDATE`, scope.PayerUserID).Scan(&value)
+		if err != nil {
+			return nil, err
+		}
+		balance, err = decimal.NewFromString(value)
+		if err != nil {
+			return nil, service.ErrRealYuFundingRange
+		}
+	}
+	// Another transaction can have completed this request while principal lock waited.
+	rec, err = readFundingRecord(ctx, tx, req, true)
+	if err != nil {
+		return nil, err
+	}
+	fresh := rec == nil
+	if fresh {
+		rec = &fundingRecord{RealYuFundingReceipt: service.RealYuFundingReceipt{RealYuFundingScope: scope, RequestID: req.RequestID, Status: "reserved"}, fingerprint: req.Fingerprint, overflow: scope.TeamID == 0, exempt: scope.TeamID > 0 && scope.ActorUserID == owner}
+	}
+	if rec.RealYuFundingScope != scope || rec.fingerprint != req.Fingerprint {
+		return nil, service.ErrRealYuFundingConflict
+	}
+	rec.WalletBalanceUSD = balance.StringFixed(8)
+	if rec.Status == "refunded" {
+		if action == "refund" {
+			return &rec.RealYuFundingReceipt, nil
+		}
+		return nil, service.ErrRealYuFundingConflict
+	}
+	if rec.Status == "settled" {
+		if action == "settle" && rec.TargetQuota == req.TargetQuota {
+			return &rec.RealYuFundingReceipt, nil
+		}
+		// A late failure callback cannot refund already delivered/settled usage.
+		if action == "refund" {
+			return &rec.RealYuFundingReceipt, nil
+		}
+		return nil, service.ErrRealYuFundingConflict
+	}
+	var cap int64
+	if action == "reserve" {
+		if err = validateFundingAdmission(ctx, tx, scope, req); err != nil {
+			return nil, err
+		}
+		if scope.TeamID > 0 {
+			var status string
+			err = tx.QueryRowContext(ctx, `SELECT status,weekly_cap_quota FROM realyu_team_members WHERE team_id=$1 AND user_id=$2 FOR SHARE`, scope.TeamID, scope.ActorUserID).Scan(&status, &cap)
+			if err != nil || status != "active" {
+				return nil, service.ErrRealYuFundingScope
+			}
+		}
+	}
+	var sub *fundingSubscription
+	if fresh {
+		sub, err = selectFundingSubscription(ctx, tx, scope, now)
+		if err != nil {
+			return nil, err
+		}
+		if sub != nil {
+			rec.SubscriptionID = sub.id
+			rec.overflow = sub.overflow
+			rec.WeeklyResetAt = sub.reset
+		}
+	} else if rec.SubscriptionID > 0 {
+		sub, err = readFundingSubscription(ctx, tx, rec.SubscriptionID)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if sub != nil {
+		if sub.user != scope.PayerUserID || sub.team != scope.TeamID {
+			return nil, service.ErrRealYuFundingConflict
+		}
+		oldReset := sub.reset
+		refreshFundingWeek(sub, now)
+		if fresh {
+			rec.WeeklyResetAt = sub.reset
+		}
+		if oldReset != sub.reset {
+			if _, err = tx.ExecContext(ctx, `UPDATE realyu_funding_subscriptions SET weekly_reset_at=$2,weekly_used=0 WHERE id=$1`, sub.id, sub.reset); err != nil {
+				return nil, err
+			}
+		}
+	}
+	target := req.TargetQuota
+	if action == "refund" {
+		target = 0
+	}
+	delta := target - rec.TargetQuota
+	available := int64(0)
+	if sub != nil {
+		available = fundingAvailable(sub)
+		if rec.WeeklyResetAt != sub.reset {
+			available = 0
+		}
+	}
+	if action == "reserve" {
+		if target <= 0 {
+			return nil, service.ErrRealYuFundingRange
+		}
+		if sub != nil && (sub.status != "active" || sub.start > now || sub.end <= now) {
+			return nil, service.ErrRealYuFundingInsufficient
+		}
+		if scope.TeamID > 0 && (sub == nil || sub.weekly <= 0) {
+			return nil, service.ErrRealYuFundingInsufficient
+		}
+		if delta > 0 && sub != nil && rec.WeeklyResetAt != sub.reset {
+			return nil, service.ErrRealYuFundingConflict
+		}
+	}
+	newSub := min(rec.SubscriptionQuota, target)
+	if delta > 0 && sub != nil {
+		extra := min(delta, available)
+		// Late settlement is charged to its original period, never the new week's rights.
+		if rec.WeeklyResetAt != sub.reset {
+			extra = 0
+		}
+		newSub = rec.SubscriptionQuota + extra
+		if scope.TeamID > 0 || !rec.overflow {
+			if action == "reserve" && delta > available {
+				return nil, service.ErrRealYuFundingInsufficient
+			}
+			newSub = target
+		}
+	}
+	newWallet := target - newSub
+	if scope.TeamID > 0 && newWallet != 0 {
+		return nil, service.ErrRealYuFundingInsufficient
+	}
+	if sub != nil && !rec.overflow && newWallet != 0 {
+		return nil, service.ErrRealYuFundingInsufficient
+	}
+	subDelta, walletDelta := newSub-rec.SubscriptionQuota, newWallet-rec.WalletQuota
+	if scope.TeamID == 0 {
+		usd, _ := service.RealYuUSDFromQuota(walletDelta)
+		charge, _ := decimal.NewFromString(usd)
+		if action == "reserve" && walletDelta > 0 && balance.LessThan(charge) {
+			return nil, service.ErrRealYuFundingInsufficient
+		}
+		next := balance.Sub(charge)
+		limit := decimal.NewFromInt(service.RealYuMaxWalletQuota).Div(decimal.NewFromInt(service.RealYuQuotaPerUSD))
+		if next.Abs().GreaterThan(limit) {
+			return nil, service.ErrRealYuFundingRange
+		}
+		if walletDelta != 0 {
+			if _, err = tx.ExecContext(ctx, `UPDATE users SET balance=balance-$2::numeric,updated_at=NOW() WHERE id=$1`, scope.PayerUserID, usd); err != nil {
+				return nil, err
+			}
+		}
+		rec.WalletBalanceUSD = next.StringFixed(8)
+	}
+	if sub != nil && subDelta != 0 {
+		if sub.used+subDelta < 0 || sub.used+subDelta > service.RealYuMaxWalletQuota {
+			return nil, service.ErrRealYuFundingRange
+		}
+		weekDelta := int64(0)
+		if rec.WeeklyResetAt == sub.reset && sub.weekly > 0 {
+			weekDelta = subDelta
+		}
+		if sub.weekUsed+weekDelta < 0 || sub.weekUsed+weekDelta > service.RealYuMaxWalletQuota {
+			return nil, service.ErrRealYuFundingRange
+		}
+		if _, err = tx.ExecContext(ctx, `UPDATE realyu_funding_subscriptions SET amount_used=amount_used+$2,weekly_used=weekly_used+$3 WHERE id=$1`, sub.id, subDelta, weekDelta); err != nil {
+			return nil, err
+		}
+	}
+	if scope.TeamID > 0 && delta != 0 {
+		if sub == nil {
+			return nil, service.ErrRealYuFundingScope
+		}
+		if _, err = tx.ExecContext(ctx, `INSERT INTO realyu_member_period_usage(team_id,user_id,subscription_id,weekly_reset_at) VALUES($1,$2,$3,$4) ON CONFLICT DO NOTHING`, scope.TeamID, scope.ActorUserID, sub.id, rec.WeeklyResetAt); err != nil {
+			return nil, err
+		}
+		var used int64
+		if err = tx.QueryRowContext(ctx, `SELECT used_quota FROM realyu_member_period_usage WHERE team_id=$1 AND user_id=$2 AND subscription_id=$3 AND weekly_reset_at=$4 FOR UPDATE`, scope.TeamID, scope.ActorUserID, sub.id, rec.WeeklyResetAt).Scan(&used); err != nil {
+			return nil, err
+		}
+		if used+delta < 0 || used+delta > service.RealYuMaxWalletQuota {
+			return nil, service.ErrRealYuFundingRange
+		}
+		if action == "reserve" && !rec.exempt && delta > 0 && used+delta > cap {
+			return nil, service.ErrRealYuFundingInsufficient
+		}
+		if _, err = tx.ExecContext(ctx, `UPDATE realyu_member_period_usage SET used_quota=used_quota+$5 WHERE team_id=$1 AND user_id=$2 AND subscription_id=$3 AND weekly_reset_at=$4`, scope.TeamID, scope.ActorUserID, sub.id, rec.WeeklyResetAt, delta); err != nil {
+			return nil, err
+		}
+	}
+	rec.SubscriptionQuota = newSub
+	rec.WalletQuota = newWallet
+	rec.TargetQuota = target
+	if action == "settle" {
+		rec.Status = "settled"
+		rec.OverageQuota = max(int64(0), subDelta-available)
+	} else if action == "refund" {
+		rec.Status = "refunded"
+		rec.OverageQuota = 0
+	}
+	if fresh {
+		_, err = tx.ExecContext(ctx, `INSERT INTO realyu_funding_requests(request_id,api_key_id,actor_user_id,payer_user_id,team_id,subscription_id,weekly_reset_at,request_fingerprint,status,subscription_quota,wallet_quota,target_quota,allow_wallet_overflow,member_cap_exempt,overage_quota)
+            VALUES($1,$2,$3,$4,NULLIF($5,0),NULLIF($6,0),$7,$8,$9,$10,$11,$12,$13,$14,$15)`, rec.RequestID, rec.APIKeyID, rec.ActorUserID, rec.PayerUserID, rec.TeamID, rec.SubscriptionID, rec.WeeklyResetAt, rec.fingerprint, rec.Status, newSub, newWallet, target, rec.overflow, rec.exempt, rec.OverageQuota)
+	} else {
+		_, err = tx.ExecContext(ctx, `UPDATE realyu_funding_requests SET status=$3,subscription_quota=$4,wallet_quota=$5,target_quota=$6,overage_quota=$7,updated_at=NOW() WHERE request_id=$1 AND api_key_id=$2`, rec.RequestID, rec.APIKeyID, rec.Status, newSub, newWallet, target, rec.OverageQuota)
+	}
+	if err != nil {
+		return nil, err
+	}
+	rec.Applied = fresh || delta != 0 || action != "reserve"
+	return &rec.RealYuFundingReceipt, nil
+}
+
+func validateFundingAdmission(ctx context.Context, tx *sql.Tx, s service.RealYuFundingScope, req service.RealYuFundingRequest) error {
+	var actor, payer, team, user int64
+	var keyStatus, userStatus string
+	var expires sql.NullTime
+	var quota, used decimal.Decimal
+	err := tx.QueryRowContext(ctx, `SELECT s.actor_user_id,s.payer_user_id,COALESCE(s.team_id,0),k.user_id,k.status,u.status,k.expires_at,k.quota,k.quota_used
+        FROM realyu_key_scopes s JOIN api_keys k ON k.id=s.api_key_id JOIN users u ON u.id=k.user_id
+        JOIN users payer ON payer.id=s.payer_user_id
+        WHERE s.api_key_id=$1 AND k.deleted_at IS NULL AND u.deleted_at IS NULL
+        AND payer.status='active' AND payer.deleted_at IS NULL FOR SHARE OF s,k,u,payer`, s.APIKeyID).
+		Scan(&actor, &payer, &team, &user, &keyStatus, &userStatus, &expires, &quota, &used)
+	if err != nil {
+		return service.ErrRealYuFundingScope
+	}
+	if actor != s.ActorUserID || payer != s.PayerUserID || team != s.TeamID || user != actor || keyStatus != "active" || userStatus != "active" || expires.Valid && !expires.Time.After(time.Now()) || quota.IsPositive() && !used.LessThan(quota) {
+		return service.ErrRealYuFundingScope
+	}
+	if quota.IsPositive() {
+		var pendingText string
+		if err = tx.QueryRowContext(ctx, `SELECT COALESCE(SUM(target_quota),0)::text FROM realyu_funding_requests WHERE api_key_id=$1 AND status='reserved' AND request_id<>$2`, s.APIKeyID, req.RequestID).Scan(&pendingText); err != nil {
+			return err
+		}
+		pending, err := decimal.NewFromString(pendingText)
+		if err != nil {
+			return service.ErrRealYuFundingRange
+		}
+		total := pending.Add(decimal.NewFromInt(req.TargetQuota)).Div(decimal.NewFromInt(service.RealYuQuotaPerUSD)).Add(used)
+		if total.GreaterThan(quota) {
+			return service.ErrRealYuFundingInsufficient
+		}
+	}
+	return nil
+}
+
+const fundingSubSelect = `SELECT id,user_id,COALESCE(team_id,0),amount_total,amount_used,weekly_amount,weekly_used,weekly_reset_at,start_time,end_time,purchase_price_cents,status,source,allow_wallet_overflow FROM realyu_funding_subscriptions`
+
+func scanFundingSubscription(row interface{ Scan(...any) error }) (*fundingSubscription, error) {
+	s := new(fundingSubscription)
+	err := row.Scan(&s.id, &s.user, &s.team, &s.total, &s.used, &s.weekly, &s.weekUsed, &s.reset, &s.start, &s.end, &s.price, &s.status, &s.source, &s.overflow)
+	return s, err
+}
+func readFundingSubscription(ctx context.Context, tx *sql.Tx, id int64) (*fundingSubscription, error) {
+	return scanFundingSubscription(tx.QueryRowContext(ctx, fundingSubSelect+` WHERE id=$1 FOR UPDATE`, id))
+}
+func selectFundingSubscription(ctx context.Context, tx *sql.Tx, s service.RealYuFundingScope, now int64) (*fundingSubscription, error) {
+	rows, err := tx.QueryContext(ctx, fundingSubSelect+` WHERE (($2=0 AND team_id IS NULL AND user_id=$1) OR ($2>0 AND team_id=$2)) AND status='active' AND end_time>$3 ORDER BY id FOR UPDATE`, s.PayerUserID, s.TeamID, now)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out *fundingSubscription
+	for rows.Next() {
+		if out != nil {
+			return nil, service.ErrRealYuFundingConflict
+		}
+		out, err = scanFundingSubscription(rows)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if err = rows.Err(); err != nil {
+		return nil, err
+	}
+	if out != nil && out.user != s.PayerUserID {
+		return nil, service.ErrRealYuFundingScope
+	}
+	if out != nil && s.TeamID == 0 && !(out.source == "workspace_admin" || out.source == "cny_order" && out.price > 0) {
+		return nil, nil
+	}
+	return out, nil
+}
+func refreshFundingWeek(s *fundingSubscription, now int64) {
+	if s.weekly <= 0 {
+		return
+	}
+	const week = int64(604800)
+	if s.reset == 0 {
+		s.reset = s.start + week
+	}
+	if now >= s.reset {
+		s.reset += ((now-s.reset)/week + 1) * week
+		s.weekUsed = 0
+	}
+}
+func fundingAvailable(s *fundingSubscription) int64 {
+	if s.weekly <= 0 {
+		return max(int64(0), s.total-s.used)
+	}
+	limit := s.weekly
+	if s.price > 0 {
+		seconds := min(int64(604800), max(int64(0), s.end-(s.reset-604800)))
+		limit = decimal.NewFromInt(s.weekly).Mul(decimal.NewFromInt(seconds)).Div(decimal.NewFromInt(604800)).Floor().IntPart()
+	}
+	return max(int64(0), limit-s.weekUsed)
+}
diff --git a/backend/internal/repository/realyu_key_allowance_repo.go b/backend/internal/repository/realyu_key_allowance_repo.go
new file mode 100644
index 0000000000000000000000000000000000000000..01afbc5032a00e27bb2412a2a36b36803df2e953
--- /dev/null
+++ b/backend/internal/repository/realyu_key_allowance_repo.go
@@ -0,0 +1,78 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/shopspring/decimal"
+	"time"
+)
+
+// realyuTeamKeyAvailable is a read-only PostgreSQL statement snapshot. Admission
+// still rechecks under the durable principal lock; this display is not a grant.
+func realyuTeamKeyAvailable(ctx context.Context, db sqlExecutor, keyID int64) (int64, error) {
+	now := time.Now().Unix()
+	const baseReset = `(CASE WHEN s.weekly_reset_at=0 THEN s.start_time+604800 ELSE s.weekly_reset_at END)`
+	const period = `(CASE WHEN $2>=` + baseReset + ` THEN ` + baseReset + `+(($2-` + baseReset + `)/604800+1)*604800 ELSE ` + baseReset + ` END)`
+	rows, err := db.QueryContext(ctx, `SELECT k.user_id,k.status,u.status,k.expires_at,k.quota::text,k.quota_used::text,
+        f.actor_user_id,f.payer_user_id,t.owner_user_id,t.closed_at,m.status,m.weekly_cap_quota,
+        COALESCE(s.id,0),COALESCE(s.user_id,0),COALESCE(s.amount_total,0),COALESCE(s.amount_used,0),
+        COALESCE(s.weekly_amount,0),COALESCE(s.weekly_used,0),COALESCE(s.weekly_reset_at,0),
+        COALESCE(s.start_time,0),COALESCE(s.end_time,0),COALESCE(s.purchase_price_cents,0),
+        COALESCE((SELECT p.used_quota FROM realyu_member_period_usage p WHERE p.team_id=t.id AND p.user_id=f.actor_user_id AND p.subscription_id=s.id AND p.weekly_reset_at=`+period+`),0),
+        COALESCE((SELECT SUM(r.target_quota) FROM realyu_funding_requests r WHERE r.api_key_id=k.id AND r.status='reserved'),0)::text
+        FROM realyu_key_scopes f JOIN api_keys k ON k.id=f.api_key_id JOIN users u ON u.id=k.user_id
+        JOIN users payer ON payer.id=f.payer_user_id AND payer.status='active' AND payer.deleted_at IS NULL
+        JOIN realyu_teams t ON t.id=f.team_id JOIN realyu_team_members m ON m.team_id=t.id AND m.user_id=f.actor_user_id
+        LEFT JOIN realyu_funding_subscriptions s ON s.team_id=t.id AND s.status='active' AND s.end_time>$2
+        WHERE f.api_key_id=$1 AND k.deleted_at IS NULL AND u.deleted_at IS NULL ORDER BY s.id LIMIT 2`, keyID, now)
+	if err != nil {
+		return 0, err
+	}
+	defer rows.Close()
+	var available int64
+	count := 0
+	for rows.Next() {
+		count++
+		if count > 1 {
+			return 0, service.ErrRealYuFundingConflict
+		}
+		var user, actor, payer, owner, closed, cap, memberUsed int64
+		var keyStatus, userStatus, memberStatus, quotaText, usedText, pendingText string
+		var expires sql.NullTime
+		s := new(fundingSubscription)
+		if err = rows.Scan(&user, &keyStatus, &userStatus, &expires, &quotaText, &usedText, &actor, &payer, &owner, &closed, &memberStatus, &cap,
+			&s.id, &s.user, &s.total, &s.used, &s.weekly, &s.weekUsed, &s.reset, &s.start, &s.end, &s.price, &memberUsed, &pendingText); err != nil {
+			return 0, err
+		}
+		if user != actor || payer != owner || closed != 0 || keyStatus != "active" || userStatus != "active" || memberStatus != "active" || expires.Valid && expires.Time.Unix() <= now || s.id == 0 || s.user != payer || s.start > now || s.weekly <= 0 {
+			continue
+		}
+		refreshFundingWeek(s, now)
+		available = fundingAvailable(s)
+		if actor != owner {
+			available = min(available, max(int64(0), cap-memberUsed))
+		}
+		quota, e := decimal.NewFromString(quotaText)
+		if e != nil {
+			return 0, service.ErrRealYuFundingRange
+		}
+		if quota.IsPositive() {
+			used, e := decimal.NewFromString(usedText)
+			if e != nil {
+				return 0, service.ErrRealYuFundingRange
+			}
+			pending, e := decimal.NewFromString(pendingText)
+			if e != nil {
+				return 0, service.ErrRealYuFundingRange
+			}
+			remaining := quota.Sub(used).Mul(decimal.NewFromInt(service.RealYuQuotaPerUSD)).Sub(pending).Floor()
+			if remaining.IsNegative() {
+				available = 0
+			} else if remaining.LessThan(decimal.NewFromInt(available)) {
+				available = remaining.IntPart()
+			}
+		}
+	}
+	return available, rows.Err()
+}
diff --git a/backend/internal/repository/realyu_key_enrollment_pg_test.go b/backend/internal/repository/realyu_key_enrollment_pg_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c6abafd79b77e45b7ae1eabacf5a9e98ac6a2732
--- /dev/null
+++ b/backend/internal/repository/realyu_key_enrollment_pg_test.go
@@ -0,0 +1,146 @@
+//go:build realyu_funding_pg
+
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	"entgo.io/ent/dialect"
+	entsql "entgo.io/ent/dialect/sql"
+	dbent "github.com/Wei-Shaw/sub2api/ent"
+	_ "github.com/Wei-Shaw/sub2api/ent/runtime"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func realyuKeyEnrollmentPG(t *testing.T) (*sql.DB, *dbent.Client) {
+	t.Helper()
+	db := realyuPG(t)
+	// Exercise the real generated Ent create against PG. These are native key
+	// columns only; the actual immutable funding migration is applied by realyuPG.
+	_, err := db.Exec(`CREATE SEQUENCE enrollment_key_id START 1000;
+        ALTER TABLE api_keys ALTER COLUMN id SET DEFAULT nextval('enrollment_key_id');
