+		{"javascript:alert(1)", "/logo.svg"},
+	} {
+		t.Run(tc.logo, func(t *testing.T) {
+			settings, err := json.Marshal(map[string]string{"site_logo": tc.logo})
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := string(injectSiteFavicon([]byte(html), settings))
+			if !strings.Contains(got, `href="`+tc.want+`"`) {
+				t.Fatalf("unexpected favicon: %s", got)
+			}
+			if !strings.Contains(got, `<title>Sub2API - AI API Gateway</title>`) {
+				t.Fatal("favicon mapping changed the upstream title")
+			}
+		})
+	}
+}
diff --git a/backend/migrations/300_realyu_legacy_identity.sql b/backend/migrations/300_realyu_legacy_identity.sql
new file mode 100644
index 0000000000000000000000000000000000000000..5d961c542d453af3beafef506802f47843629f6b
--- /dev/null
+++ b/backend/migrations/300_realyu_legacy_identity.sql
@@ -0,0 +1,13 @@
+-- One immutable login namespace for offline imports and username registration.
+-- Only offline imports carry source_user_id; profile edits never write aliases.
+CREATE TABLE IF NOT EXISTS realyu_legacy_identities (
+    source_user_id BIGINT UNIQUE CHECK (source_user_id > 0),
+    user_id BIGINT PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
+    login_name VARCHAR(191) NOT NULL UNIQUE CHECK (length(login_name) > 0),
+    email_verified_at TIMESTAMPTZ,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+ALTER TABLE users DROP CONSTRAINT IF EXISTS users_signup_source_check;
+ALTER TABLE users ADD CONSTRAINT users_signup_source_check
+    CHECK (signup_source IN ('email', 'linuxdo', 'wechat', 'oidc', 'github', 'google', 'dingtalk', 'realyu_legacy', 'realyu_username'));
diff --git a/backend/migrations/301_realyu_funding.sql b/backend/migrations/301_realyu_funding.sql
new file mode 100644
index 0000000000000000000000000000000000000000..9772fabe1a79a5c67acbbfb9579f22d9df73ef02
--- /dev/null
+++ b/backend/migrations/301_realyu_funding.sql
@@ -0,0 +1,75 @@
+-- RealYu customer funding. Sub users.balance is the ONLY personal wallet.
+-- Integer quota = USD * 500000; no shadow customer wallet or team PAYGO.
+-- API key owner is the actor; payer is an immutable funding audit identity.
+CREATE TABLE realyu_teams (
+    id BIGINT PRIMARY KEY CHECK (id > 0),
+    owner_user_id BIGINT NOT NULL REFERENCES users(id),
+    name TEXT NOT NULL DEFAULT '',
+    historical_quota BIGINT NOT NULL DEFAULT 0 CHECK (abs(historical_quota) <= 9007199254740991),
+    closed_at BIGINT NOT NULL DEFAULT 0
+);
+CREATE TABLE realyu_team_members (
+    team_id BIGINT NOT NULL REFERENCES realyu_teams(id),
+    user_id BIGINT NOT NULL REFERENCES users(id),
+    status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','disabled','removed')),
+    weekly_cap_quota BIGINT NOT NULL CHECK (weekly_cap_quota BETWEEN 0 AND 9007199254740991),
+    PRIMARY KEY(team_id,user_id)
+);
+CREATE TABLE realyu_key_scopes (
+    api_key_id BIGINT PRIMARY KEY REFERENCES api_keys(id),
+    actor_user_id BIGINT NOT NULL REFERENCES users(id),
+    payer_user_id BIGINT NOT NULL REFERENCES users(id),
+    team_id BIGINT REFERENCES realyu_teams(id),
+    CHECK (team_id IS NOT NULL OR actor_user_id = payer_user_id)
+);
+CREATE TABLE realyu_funding_subscriptions (
+    id BIGINT PRIMARY KEY CHECK (id > 0),
+    user_id BIGINT NOT NULL REFERENCES users(id),
+    team_id BIGINT REFERENCES realyu_teams(id),
+    amount_total BIGINT NOT NULL CHECK (amount_total BETWEEN 0 AND 9007199254740991),
+    amount_used BIGINT NOT NULL DEFAULT 0 CHECK (amount_used BETWEEN 0 AND 9007199254740991),
+    weekly_amount BIGINT NOT NULL DEFAULT 0 CHECK (weekly_amount BETWEEN 0 AND 9007199254740991),
+    weekly_used BIGINT NOT NULL DEFAULT 0 CHECK (weekly_used BETWEEN 0 AND 9007199254740991),
+    weekly_reset_at BIGINT NOT NULL DEFAULT 0,
+    start_time BIGINT NOT NULL,
+    end_time BIGINT NOT NULL CHECK (end_time > start_time),
+    status TEXT NOT NULL CHECK (status IN ('active','expired','cancelled')),
+    source TEXT NOT NULL,
+    purchase_price_cents BIGINT NOT NULL DEFAULT 0 CHECK (purchase_price_cents >= 0),
+    purchase_title TEXT NOT NULL DEFAULT '',
+    allow_wallet_overflow BOOLEAN NOT NULL DEFAULT FALSE,
+    CHECK (team_id IS NULL OR allow_wallet_overflow = FALSE)
+);
+CREATE INDEX realyu_funding_subscription_scope ON realyu_funding_subscriptions(user_id,team_id,status,end_time);
+CREATE TABLE realyu_funding_requests (
+    request_id TEXT NOT NULL CHECK (length(request_id) BETWEEN 1 AND 256),
+    api_key_id BIGINT NOT NULL,
+    actor_user_id BIGINT NOT NULL,
+    payer_user_id BIGINT NOT NULL,
+    team_id BIGINT,
+    subscription_id BIGINT REFERENCES realyu_funding_subscriptions(id),
+    weekly_reset_at BIGINT NOT NULL DEFAULT 0,
+    request_fingerprint TEXT NOT NULL,
+    status TEXT NOT NULL CHECK (status IN ('reserved','settled','refunded')),
+    subscription_quota BIGINT NOT NULL DEFAULT 0 CHECK (subscription_quota BETWEEN 0 AND 2147483647),
+    wallet_quota BIGINT NOT NULL DEFAULT 0 CHECK (wallet_quota BETWEEN 0 AND 2147483647),
+    target_quota BIGINT NOT NULL CHECK (target_quota BETWEEN 0 AND 2147483647),
+    allow_wallet_overflow BOOLEAN NOT NULL,
+    member_cap_exempt BOOLEAN NOT NULL,
+    overage_quota BIGINT NOT NULL DEFAULT 0 CHECK (overage_quota BETWEEN 0 AND 2147483647),
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    PRIMARY KEY(request_id,api_key_id),
+    CHECK (subscription_quota + wallet_quota = target_quota),
+    CHECK (team_id IS NULL OR wallet_quota = 0)
+);
+CREATE INDEX realyu_funding_requests_outstanding ON realyu_funding_requests(status,created_at) WHERE status='reserved';
+CREATE TABLE realyu_member_period_usage (
+    team_id BIGINT NOT NULL REFERENCES realyu_teams(id),
+    user_id BIGINT NOT NULL REFERENCES users(id),
+    subscription_id BIGINT NOT NULL REFERENCES realyu_funding_subscriptions(id),
+    weekly_reset_at BIGINT NOT NULL,
+    used_quota BIGINT NOT NULL DEFAULT 0 CHECK (used_quota BETWEEN 0 AND 9007199254740991),
+    opening_used_quota BIGINT NOT NULL DEFAULT 0 CHECK (opening_used_quota BETWEEN 0 AND 9007199254740991),
+    PRIMARY KEY(team_id,user_id,subscription_id,weekly_reset_at)
+);
diff --git a/backend/migrations/302_realyu_migration.sql b/backend/migrations/302_realyu_migration.sql
new file mode 100644
index 0000000000000000000000000000000000000000..d335dffa35dbb263a135051714313a79f492e68a
--- /dev/null
+++ b/backend/migrations/302_realyu_migration.sql
@@ -0,0 +1,43 @@
+-- Offline customer-import receipts. No HTTP endpoint creates or activates them.
+CREATE TABLE realyu_legacy_user_metadata (
+    user_id BIGINT PRIMARY KEY REFERENCES users(id),
+    source_role INTEGER NOT NULL CHECK (source_role IN (1,10,100))
+);
+CREATE TABLE realyu_migration_state (
+    singleton BOOLEAN PRIMARY KEY DEFAULT TRUE CHECK (singleton),
+    installation_id TEXT NOT NULL,
+    phase TEXT NOT NULL DEFAULT 'staging' CHECK (phase IN ('staging','active')),
+    source_sha256 CHAR(64),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE realyu_migration_runs (
+    operation_id TEXT PRIMARY KEY,
+    source_sha256 CHAR(64) NOT NULL,
+    mapping_sha256 CHAR(64) NOT NULL,
+    receipt JSONB NOT NULL,
+    applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+CREATE TABLE realyu_legacy_keys (
+    source_token_id BIGINT PRIMARY KEY,
+    api_key_id BIGINT NOT NULL UNIQUE REFERENCES api_keys(id),
+    source_actor_id BIGINT NOT NULL,
+    source_payer_id BIGINT NOT NULL,
+    legacy_team_id BIGINT NOT NULL DEFAULT 0,
+    model_limits_enabled BOOLEAN NOT NULL DEFAULT FALSE,
+    model_limits JSONB NOT NULL DEFAULT '{}',
+    unlimited_quota BOOLEAN NOT NULL,
+    opening_used_quota BIGINT NOT NULL,
+    opening_remaining_quota BIGINT NOT NULL,
+    CHECK (opening_used_quota BETWEEN 0 AND 9007199254740991),
+    CHECK (abs(opening_remaining_quota) <= 9007199254740991)
+);
+-- Historical orders/entitlements are preserved, never silently converted into
+-- a new paid purchase. A later payment adapter must explicitly claim fulfillment.
+CREATE TABLE realyu_legacy_records (
+    source_table TEXT NOT NULL,
+    source_key TEXT NOT NULL,
+    row_sha256 CHAR(64) NOT NULL,
+    source_row JSONB NOT NULL,
+    snapshot_sha256 CHAR(64) NOT NULL,
+    PRIMARY KEY (source_table, source_key)
+);
