@@ -0,0 +1,73 @@
+package routes
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"math"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type realyuClientFake struct {
+	usage *service.RealYuKeyUsage
+	err   error
+}
+
+func (f realyuClientFake) GetRealYuKeyUsage(context.Context, int64) (*service.RealYuKeyUsage, error) {
+	return f.usage, f.err
+}
+
+func TestRealYuKeyCheckContract(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	past := time.Now().Add(-time.Hour)
+	for _, tc := range []struct {
+		name   string
+		key    *service.APIKey
+		reader realyuClientFake
+		want   int
+	}{
+		{"native-exhausted-key-is-inspectable", &service.APIKey{ID: 1, Quota: 1, QuotaUsed: 1, Status: service.StatusAPIKeyQuotaExhausted}, realyuClientFake{}, 200},
+		{"legacy-int-contract", &service.APIKey{ID: 1}, realyuClientFake{usage: &service.RealYuKeyUsage{Object: "token_usage", TotalUsed: 123, TotalAvailable: 456, TotalGranted: 579, ModelLimits: map[string]bool{"allowed": true}}}, 200},
+		{"expired", &service.APIKey{ID: 1, ExpiresAt: &past}, realyuClientFake{}, 401},
+		{"missing-auth", nil, realyuClientFake{}, 401},
+		{"database-failure", &service.APIKey{ID: 1}, realyuClientFake{err: errors.New("private driver data")}, 503},
+		{"nonfinite", &service.APIKey{ID: 1, QuotaUsed: math.NaN()}, realyuClientFake{}, 503},
+		{"out-of-range", &service.APIKey{ID: 1, Quota: 1e20}, realyuClientFake{}, 503},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := gin.New()
+			auth := middleware.APIKeyAuthMiddleware(func(c *gin.Context) {
+				if tc.key != nil {
+					c.Set(string(middleware.ContextKeyAPIKey), tc.key)
+				}
+				c.Next()
+			})
+			RegisterRealYuClientRoutes(r, auth, tc.reader)
+			w := httptest.NewRecorder()
+			r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/api/client/key-check", nil))
+			require.Equal(t, tc.want, w.Code)
+			require.Equal(t, "no-store", w.Header().Get("Cache-Control"))
+			require.NotContains(t, w.Body.String(), "private driver data")
+			if tc.want == 200 {
+				var b struct {
+					Code bool                   `json:"code"`
+					Data service.RealYuKeyUsage `json:"data"`
+				}
+				require.NoError(t, json.Unmarshal(w.Body.Bytes(), &b))
+				require.True(t, b.Code)
+				require.Equal(t, "token_usage", b.Data.Object)
+				if tc.reader.usage != nil {
+					require.Equal(t, tc.reader.usage.TotalAvailable, b.Data.TotalAvailable)
+				}
+			}
+		})
+	}
+}
