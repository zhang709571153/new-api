+//go:build unit
+
+package handler
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type chatCyberFundingRepo struct{ handlerFundingRepo }
+
+func (r *chatCyberFundingRepo) Resolve(context.Context, int64, int64) (*service.RealYuFundingScope, error) {
+	return &service.RealYuFundingScope{APIKeyID: 2, ActorUserID: 1, PayerUserID: 1}, nil
+}
+
+type chatCyberPartialUpstream struct {
+	service.HTTPUpstream
+	c     *gin.Context
+	calls int
+}
+
+func (u *chatCyberPartialUpstream) Do(req *http.Request, _ string, _ int64, _ int) (*http.Response, error) {
+	u.calls++
+	// The transport fixture supplies the cyber mark and a genuine truncated raw
+	// Chat stream. The real forwarder must return a non-nil partial result/error;
+	// the public ChatCompletions handler (not the predicate helper) is under test.
+	// A raw Chat usage frame is a terminal signal in the native forwarder.
+	// Omit that frame to reach the real partial-result + error branch. Reported
+	// nonzero cyber usage is covered separately by the lifecycle tests.
+	service.MarkOpsCyberPolicy(u.c, service.CyberPolicyMark{Message: "synthetic cyber block", UpstreamStatus: 400})
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {"text/event-stream"}, "X-Request-Id": {"synthetic-chat-partial"}}, Request: req,
+		Body: io.NopCloser(strings.NewReader("data: {\"id\":\"chatcmpl-partial\",\"model\":\"gpt-5.1\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"partial\"},\"finish_reason\":null}]}\n\n"))}, nil
+}
+
+func TestRealYuFundingChatHandlerCyberPartialHasOneBill(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	funding := &chatCyberFundingRepo{}
+	inputPrice, outputPrice := .00000125, .000010
+	groupID := int64(4)
+	key := &service.APIKey{ID: 2, UserID: 1, User: &service.User{ID: 1, Status: service.StatusActive}, GroupID: &groupID,
+		Group: &service.Group{ID: groupID, Platform: service.PlatformOpenAI, Status: service.StatusActive, RateMultiplier: 1, Hydrated: true,
+			ModelPricing: []service.ChannelModelPricing{{Models: []string{"gpt-5.1"}, BillingMode: service.BillingModeToken, InputPrice: &inputPrice, OutputPrice: &outputPrice}}},
+		RealYuFunding: &service.RealYuFundingScope{APIKeyID: 2, ActorUserID: 1, PayerUserID: 1}, RealYuFundingRepository: funding}
+	repo := &grokCredentialHandlerRepo{accounts: []service.Account{{ID: 3, Name: "synthetic", Platform: service.PlatformOpenAI, Type: service.AccountTypeAPIKey,
+		Status: service.StatusActive, Schedulable: true, Concurrency: 1, Credentials: map[string]any{"api_key": "synthetic", "base_url": "https://upstream.invalid"},
+		Extra: map[string]any{"openai_responses_mode": "force_chat_completions"}}}}
+	upstream := &chatCyberPartialUpstream{}
+	logs := &cyberFundingUsageRepo{written: make(chan struct{}, 4)}
+	bill := &cyberFundingBillingRepo{}
+	cfg := &config.Config{}
+	cfg.Default.RateMultiplier = 1
+	billing := service.NewBillingService(cfg, nil)
+	cache := service.NewBillingCacheService(nil, nil, nil, nil, nil, nil, cfg, nil)
+	t.Cleanup(cache.Stop)
+	gateway := service.NewOpenAIGatewayService(repo, logs, bill, nil, nil, nil, nil, cfg, nil, nil, billing, nil, cache, upstream, &service.DeferredService{}, nil, nil, service.NewModelPricingResolver(nil, billing), nil, nil, nil, nil)
+	concurrency := &concurrencyCacheMock{
+		acquireUserSlotFn:    func(context.Context, int64, int, string) (bool, error) { return true, nil },
+		acquireAccountSlotFn: func(context.Context, int64, int, string) (bool, error) { return true, nil },
+	}
+	h := NewOpenAIGatewayHandler(gateway, service.NewConcurrencyService(concurrency), cache, &service.APIKeyService{}, nil, nil, nil, nil, cfg)
+	router := gin.New()
+	router.Use(func(c *gin.Context) {
+		upstream.c = c
+		c.Set(string(middleware.ContextKeyAPIKey), key)
+		c.Set(string(middleware.ContextKeyUser), middleware.AuthSubject{UserID: 1, Concurrency: 1})
+		c.Next()
+	})
+	router.POST("/v1/chat/completions", h.ChatCompletions)
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(`{"model":"gpt-5.1","messages":[{"role":"user","content":"synthetic"}],"stream":true,"max_tokens":1000}`))
+	request.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(recorder, request)
+	require.Equal(t, 1, upstream.calls, recorder.Body.String())
+	require.Contains(t, recorder.Body.String(), "partial")
+	require.Contains(t, upstream.c.GetString(service.OpsUpstreamErrorMessageKey), "before any terminal chunk", "fixture must reach the actual truncated-stream handler branch")
+	require.EqualValues(t, 1, funding.reserved.Load())
+	require.Zero(t, funding.refunded.Load())
+	bill.mu.Lock()
+	defer bill.mu.Unlock()
+	logs.mu.Lock()
+	defer logs.mu.Unlock()
+	require.Len(t, bill.commands, 1, "partial cyber result must not submit both simplified and full usage")
+	require.Len(t, logs.rows, 1)
+	require.NotNil(t, bill.commands[0].RealYuFunding)
+	require.Zero(t, bill.commands[0].RealYuFunding.TargetQuota, "no authoritative usage arrived before this synthetic truncation")
+	require.Equal(t, service.RequestTypeCyberBlocked, logs.rows[0].RequestType)
+}
