@@ -0,0 +1,101 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+
+	dbent "github.com/Wei-Shaw/sub2api/ent"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+var _ service.LegacyLoginRepository = (*userRepository)(nil)
+
+func (r *userRepository) GetByLegacyLoginName(ctx context.Context, loginName string) (*service.User, error) {
+	rows, err := txAwareSQLExecutor(ctx, r.sql, r.client).QueryContext(ctx,
+		`SELECT user_id FROM realyu_legacy_identities WHERE login_name = $1`, loginName)
+	if err != nil {
+		return nil, err
+	}
+	var id int64
+	if !rows.Next() {
+		err = rows.Err()
+		_ = rows.Close()
+		if err != nil {
+			return nil, err
+		}
+		return nil, service.ErrUserNotFound
+	}
+	err = rows.Scan(&id)
+	_ = rows.Close()
+	if err != nil {
+		return nil, err
+	}
+	u, err := r.GetByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if !u.HasUsernameIdentity() || u.LegacyLoginName != loginName {
+		return nil, service.ErrUserNotFound
+	}
+	return u, nil
+}
+
+func (r *userRepository) hydrateLegacyIdentity(ctx context.Context, user *service.User) error {
+	if !user.HasUsernameIdentity() {
+		return nil
+	}
+	rows, err := txAwareSQLExecutor(ctx, r.sql, r.client).QueryContext(ctx,
+		`SELECT login_name, email_verified_at FROM realyu_legacy_identities WHERE user_id = $1`, user.ID)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = rows.Close() }()
+	if !rows.Next() {
+		if err := rows.Err(); err != nil {
+			return err
+		}
+		return fmt.Errorf("legacy identity mapping is missing")
+	}
+	var verifiedAt sql.NullTime
+	if err := rows.Scan(&user.LegacyLoginName, &verifiedAt); err != nil {
+		return err
+	}
+	if verifiedAt.Valid {
+		user.LegacyEmailVerifiedAt = &verifiedAt.Time
+	}
+	return rows.Err()
+}
+
+func (r *userRepository) CreateWithUsernameIdentity(ctx context.Context, user *service.User, domainLimit string) error {
+	if user == nil || user.SignupSource != service.RealyuUsernameSignupSource || user.LegacyLoginName == "" {
+		return service.ErrInvalidCredentials
+	}
+	var ownedTx *dbent.Tx
+	if dbent.TxFromContext(ctx) == nil {
+		tx, err := r.client.Tx(ctx)
+		if err != nil {
+			return err
+		}
+		ownedTx = tx
+		defer func() { _ = tx.Rollback() }()
+		ctx = dbent.NewTxContext(ctx, tx)
+	}
+	// Native email uniqueness/alias locks and the immutable login-name INSERT
+	// share the transaction, including invitation redemption by the caller.
+	if err := r.create(ctx, user, true, domainLimit); err != nil {
+		return err
+	}
+	_, err := txAwareSQLExecutor(ctx, r.sql, r.client).ExecContext(ctx,
+		`INSERT INTO realyu_legacy_identities (user_id, login_name) VALUES ($1, $2)`, user.ID, user.LegacyLoginName)
+	if err != nil {
+		if isUniqueConstraintViolation(err) {
+			return service.ErrLoginNameUnavailable
+		}
+		return err
+	}
+	if ownedTx != nil {
+		return ownedTx.Commit()
+	}
+	return nil
+}
