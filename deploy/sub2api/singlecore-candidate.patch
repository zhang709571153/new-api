+	assert.Equal(t, "CaseSensitive", after.LegacyLoginName)
+	count, err = client.AuthIdentity.Query().Where(authidentity.UserIDEQ(id)).Count(ctx)
+	require.NoError(t, err)
+	assert.Zero(t, count, "profile edits must not create trusted email identities")
+	for _, identifier := range []string{"casesensitive", nickname, "imported@example.com"} {
+		_, _, err := svc.Login(ctx, identifier, password)
+		assert.Error(t, err)
+	}
+	_, _, err = svc.LoginOrRegisterOAuth(ctx, "imported@example.com", "provider nickname")
+	assert.ErrorIs(t, err, service.ErrInvalidCredentials, "unverified copied email must not allow OAuth account adoption")
+	_, _, err = svc.LoginOrRegisterVerifiedEmailOAuth(ctx, service.EmailOAuthIdentityInput{
+		ProviderType: "google", ProviderKey: "google", ProviderSubject: "synthetic-subject",
+		Email: "imported@example.com", EmailVerified: true,
+	})
+	assert.ErrorIs(t, err, service.ErrInvalidCredentials, "verified mailbox alone is not ownership of the imported account")
+	_, err = svc.ValidatePasswordCredentials(ctx, "imported@example.com", password)
+	assert.ErrorIs(t, err, service.ErrInvalidCredentials)
+	count, err = client.AuthIdentity.Query().Where(authidentity.UserIDEQ(id)).Count(ctx)
