+
+func TestZPayQueryUsesGETWithoutChangingGenericEasyPay(t *testing.T) {
+	for _, mode := range []string{"", "easypay", "zpay"} {
+		t.Run("mode="+mode, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				wantMethod := http.MethodPost
+				if mode == "zpay" {
+					wantMethod = http.MethodGet
+				}
+				if r.Method != wantMethod || r.URL.Path != "/api.php" {
+					t.Errorf("request = %s %s, want %s /api.php", r.Method, r.URL.Path, wantMethod)
+				}
+				if err := r.ParseForm(); err != nil {
+					t.Error(err)
+				}
+				for k, want := range map[string]string{"act": "order", "pid": "synthetic-pid", "key": "synthetic-secret", "out_trade_no": "test-order&42"} {
+					if got := r.Form.Get(k); got != want {
+						t.Errorf("parameter %s mismatch", k)
+					}
+				}
+				if mode == "zpay" && len(r.PostForm) != 0 {
+					t.Error("ZPay query unexpectedly has a POST body")
+				}
+				if mode != "zpay" && r.URL.RawQuery != "" {
+					t.Error("generic EasyPay query changed to URL parameters")
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"code":1,"status":1,"money":"12.34","trade_no":"synthetic-trade"}`))
+			}))
+			defer srv.Close()
+			p := newZPayTestProvider(t, srv.URL)
+			p.config["compatibilityMode"] = mode
+			result, err := p.QueryOrder(context.Background(), "test-order&42")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result.Status != payment.ProviderStatusPaid || result.Amount != 12.34 || result.TradeNo != "synthetic-trade" {
+				t.Fatalf("unexpected query result: %+v", result)
+			}
+		})
+	}
+}
