+func TestZPayQueryRejectsUnsuccessfulOrIncompleteResponses(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"empty", 200, ""}, {"html", 200, "<html>invalid merchant</html>"},
+		{"upstream failure cannot be paid", 200, `{"code":0,"status":1,"money":"12.34"}`},
+		{"missing success code", 200, `{"status":1,"money":"12.34"}`},
+		{"HTTP failure cannot be paid", 503, `{"code":1,"status":1}`},
+		{"oversize", 200, strings.Repeat(" ", maxEasypayResponseSize+1)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer srv.Close()
+			result, err := newZPayTestProvider(t, srv.URL).QueryOrder(context.Background(), "synthetic-order")
+			if err == nil || result != nil {
+				t.Fatal("invalid response must fail, never return a paid order")
+			}
+		})
+	}
+}
+
+func TestZPayQueryDoesNotRedirectOrExposeCredentials(t *testing.T) {
+	var redirected bool
+	destination := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, _ *http.Request) { redirected = true }))
+	defer destination.Close()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, destination.URL+"?key=synthetic-secret", http.StatusFound)
+	}))
+	p := newZPayTestProvider(t, srv.URL)
+	_, err := p.QueryOrder(context.Background(), "synthetic-order")
+	if err == nil || redirected {
+		t.Fatal("query must reject redirects")
+	}
+	if strings.Contains(err.Error(), "synthetic-secret") {
+		t.Fatal("redirect error leaked merchant secret")
+	}
+	srv.Close()
+	_, err = p.QueryOrder(context.Background(), "synthetic-order")
+	if err == nil {
+		t.Fatal("closed upstream must fail")
+	}
+	if strings.Contains(err.Error(), "synthetic-secret") || strings.Contains(err.Error(), "out_trade_no=") {
+		t.Fatal("transport error leaked query credentials")
+	}
+}
