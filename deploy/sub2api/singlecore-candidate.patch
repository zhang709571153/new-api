+
+	svc.RecordSuccessfulLogin(ctx, id)
+	count, err := client.AuthIdentity.Query().Where(authidentity.UserIDEQ(id)).Count(ctx)
+	require.NoError(t, err)
+	assert.Zero(t, count, "login must not verify copied email or grant a new identity")
+	nickname := "新昵称"
+	userSvc := service.NewUserService(repo, nil, nil, nil)
+	_, err = userSvc.UpdateProfile(ctx, id, service.UpdateProfileRequest{Username: &nickname})
+	require.NoError(t, err)
+	_, after, err := svc.Login(ctx, "CaseSensitive", password)
