@@ -0,0 +1,134 @@
+//go:build unit
+
+package handler
+
+import (
+	"context"
+	"errors"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+type cyberFundingBillingRepo struct {
+	service.UsageBillingRepository
+	mu       sync.Mutex
+	commands []*service.UsageBillingCommand
+}
+
+func (r *cyberFundingBillingRepo) Apply(_ context.Context, cmd *service.UsageBillingCommand) (*service.UsageBillingApplyResult, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.commands = append(r.commands, cmd)
+	return &service.UsageBillingApplyResult{Applied: true, RealYuFunding: &service.RealYuFundingReceipt{RealYuFundingScope: service.RealYuFundingScope{TeamID: 5}}}, nil
+}
+
+type cyberFundingUsageRepo struct {
+	service.UsageLogRepository
+	mu      sync.Mutex
+	rows    []*service.UsageLog
+	written chan struct{}
+}
+
+func (r *cyberFundingUsageRepo) Create(_ context.Context, row *service.UsageLog) (bool, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.rows = append(r.rows, row)
+	r.written <- struct{}{}
+	return true, nil
+}
+
+func TestRealYuFundingCyberUsageRetainsHoldAndBillsOnce(t *testing.T) {
+	for _, path := range []string{"/v1/responses", "/v1/messages"} {
+		for _, mode := range []string{"inline", "saturated", "queued"} {
+			for _, kind := range []string{"reported_tokens", "zero_tokens", "partial_result"} {
+				t.Run(path+"/"+mode+"/"+kind, func(t *testing.T) {
+					funding := &handlerFundingRepo{}
+					key := &service.APIKey{ID: 2, UserID: 1, User: &service.User{ID: 1}, RealYuFunding: &service.RealYuFundingScope{}, RealYuFundingRepository: funding}
+					const model = "realyu-cyber-priced"
+					inputPrice, outputPrice := 0.00000125, 0.000010
+					key.Group = &service.Group{ID: 4, RateMultiplier: 1, Hydrated: true, ModelPricing: []service.ChannelModelPricing{{Models: []string{model}, BillingMode: service.BillingModeToken, InputPrice: &inputPrice, OutputPrice: &outputPrice}}}
+					key.GroupID = &key.Group.ID
+					ctx, done, err := service.BeginRealYuFunding(context.Background(), key, .01)
+					require.NoError(t, err)
+					bill := &cyberFundingBillingRepo{}
+					logs := &cyberFundingUsageRepo{written: make(chan struct{}, 4)}
+					cfg := &config.Config{}
+					cfg.Default.RateMultiplier = 1
+					billing := service.NewBillingService(cfg, nil)
+					gw := service.NewOpenAIGatewayService(nil, logs, bill, nil, nil, nil, nil, cfg, nil, nil, billing, nil, nil, nil, nil, nil, nil, service.NewModelPricingResolver(nil, billing), nil, nil, nil, nil)
+					h := &OpenAIGatewayHandler{gatewayService: gw}
+					var release func()
+					if mode != "inline" {
+						pool := service.NewUsageRecordWorkerPoolWithOptions(service.UsageRecordWorkerPoolOptions{WorkerCount: 1, QueueSize: 1, TaskTimeout: time.Second, OverflowPolicy: "drop", AutoScaleEnabled: false})
+						h.usageRecordWorkerPool = pool
+						t.Cleanup(pool.Stop)
+						blocked, started := make(chan struct{}), make(chan struct{})
+						var once sync.Once
+						release = func() { once.Do(func() { close(blocked) }) }
+						defer release()
+						require.False(t, pool.Submit(func(context.Context) { close(started); <-blocked }).Dropped())
+						<-started
+						if mode == "saturated" {
+							require.False(t, pool.Submit(func(context.Context) {}).Dropped())
+						}
+					}
+					c := newTestGinContext()
+					c.Request = httptest.NewRequest("POST", path, strings.NewReader(`{}`)).WithContext(ctx)
+					c.Writer.Header().Set("X-Request-Id", "cyber-test-request")
+					mark := service.CyberPolicyMark{Message: "blocked", UpstreamStatus: 400}
+					if kind != "zero_tokens" {
+						mark.UpstreamInTok, mark.UpstreamOutTok = 1200, 300
+					}
+					service.MarkOpsCyberPolicy(c, mark)
+					account := &service.Account{ID: 3}
+					var result *service.OpenAIForwardResult
+					if kind == "partial_result" {
+						result = &service.OpenAIForwardResult{RequestID: "cyber-test-request", Model: model, Usage: service.OpenAIUsage{InputTokens: 1200, OutputTokens: 300}}
+					}
+					// These are the same branches used after HTTP Forward and
+					// ForwardAsAnthropic: a partial result has exactly one normal bill.
+					missing := needsCyberPolicyUsage(result, errors.New("synthetic cyber rejection"))
+					h.recordCyberPolicyIfMarked(c, key, account, nil, model, missing, nil, service.ChannelUsageFields{}, "")
+					h.recordCyberPolicyIfMarked(c, key, account, nil, model, missing, nil, service.ChannelUsageFields{}, "")
+					if result != nil {
+						h.submitOpenAIUsageRecordTask(ctx, result, func(taskCtx context.Context) {
+							require.NoError(t, gw.RecordUsage(taskCtx, &service.OpenAIRecordUsageInput{Result: result, APIKey: key, User: key.User, Account: account, CyberBlocked: true}))
+						})
+					}
+					done()
+					require.Zero(t, funding.refunded.Load(), "queued or settled usage must never refund at handler completion")
+					if release != nil {
+						release()
+					}
+					select {
+					case <-logs.written:
+					case <-time.After(3 * time.Second):
+						t.Fatal("usage task did not complete")
+					}
+					bill.mu.Lock()
+					defer bill.mu.Unlock()
+					logs.mu.Lock()
+					defer logs.mu.Unlock()
+					require.Len(t, bill.commands, 1)
+					require.Len(t, logs.rows, 1)
+					cmd := bill.commands[0]
+					require.NotNil(t, cmd.RealYuFunding)
+					require.Equal(t, service.RealYuFundingFromContext(ctx).Request(0).RequestID, cmd.RequestID)
+					require.Equal(t, service.RequestTypeCyberBlocked, logs.rows[0].RequestType)
+					if kind == "zero_tokens" {
+						require.Zero(t, cmd.RealYuFunding.TargetQuota)
+					} else {
+						require.EqualValues(t, 2250, cmd.RealYuFunding.TargetQuota)
+					}
+				})
+			}
+		}
+	}
+}
