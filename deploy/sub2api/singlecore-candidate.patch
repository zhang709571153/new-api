+        { name: 'gpt-6.1-sol', platform: 'openai', pricing: null, official_pricing: null },
+      ],
+    } as ModelPlazaGroup],
+  }
+}
+
+function mountContent(data: ModelPlazaResponse, loading = false, error = false) {
+  return mount(ModelPlazaContent, {
+    props: { response: data, loading, error },
+    global: { stubs: { PlazaFilterBar: true, PlazaGroupSection: true, Icon: true } },
+  })
+}
