@@ -0,0 +1,66 @@
+//go:build unit
+
+package middleware
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+type fundingAuthStub struct {
+	service.RealYuFundingRepository
+	removed bool
+	calls   int
+}
+
+func (s *fundingAuthStub) Resolve(_ context.Context, key, actor int64) (*service.RealYuFundingScope, error) {
+	s.calls++
+	if s.removed {
+		return nil, service.ErrRealYuFundingScope
+	}
+	return &service.RealYuFundingScope{APIKeyID: key, ActorUserID: actor, PayerUserID: 9, TeamID: 3}, nil
+}
+func TestRealYuFundingAuthUsesActorAndChecksMembershipOnEveryRequest(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	cfg := &config.Config{RunMode: config.RunModeStandard}
+	funding := &fundingAuthStub{}
+	cached := &service.APIKey{ID: 2, UserID: 7, Key: "synthetic-realyu-funding-key", Status: service.StatusActive, User: &service.User{ID: 7, Role: service.RoleUser, Status: service.StatusActive, Balance: 0, Concurrency: 3}}
+	repo := &stubApiKeyRepo{getByKey: func(context.Context, string) (*service.APIKey, error) { return cached, nil }, updateLastUsed: func(context.Context, int64, time.Time) error { return nil }}
+	svc := service.NewAPIKeyService(repo, nil, nil, nil, nil, nil, cfg)
+	svc.SetRealYuFundingRepository(funding)
+	r := gin.New()
+	r.Use(gin.HandlerFunc(NewAPIKeyAuthMiddleware(svc, nil, cfg)))
+	handler := func(c *gin.Context) {
+		key, ok := GetAPIKeyFromContext(c)
+		require.True(t, ok)
+		require.EqualValues(t, 7, key.User.ID)
+		require.EqualValues(t, 9, key.RealYuFunding.PayerUserID)
+		c.Status(200)
+	}
+	r.GET("/api/client/key-check", handler)
+	r.POST("/v1/responses", handler)
+	r.GET("/v1/responses", handler)
+	r.POST("/v1/embeddings", handler)
+	request := func(method, path string) int {
+		w := httptest.NewRecorder()
+		req := httptest.NewRequest(method, path, nil)
+		req.Header.Set("Authorization", "Bearer "+cached.Key)
+		r.ServeHTTP(w, req)
+		return w.Code
+	}
+	require.Equal(t, 200, request(http.MethodGet, "/api/client/key-check"))
+	require.Equal(t, 200, request(http.MethodPost, "/v1/responses"))
+	require.Nil(t, cached.RealYuFunding)
+	require.Equal(t, 503, request(http.MethodGet, "/v1/responses"))
+	require.Equal(t, 503, request(http.MethodPost, "/v1/embeddings"))
+	funding.removed = true
+	require.Equal(t, 403, request(http.MethodGet, "/api/client/key-check"))
+	require.Equal(t, 5, funding.calls)
+}
diff --git a/backend/internal/server/middleware/realyu_key_policy.go b/backend/internal/server/middleware/realyu_key_policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..8b9a5b5795513bff5c9bfc9c541754653be806cb
--- /dev/null
+++ b/backend/internal/server/middleware/realyu_key_policy.go
@@ -0,0 +1,141 @@
+package middleware
+
+import (
+	"context"
+	"net/http"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/httputil"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/requestmodel"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+// RealYuLegacyKeyPolicy preserves per-key model restrictions before any route
+// rewrite. It reuses the same duplicate-field and multipart parser as groups.
+type realyuKeyPolicyReader interface {
+	GetRealYuKeyUsage(context.Context, int64) (*service.RealYuKeyUsage, error)
+}
+
+func RealYuLegacyKeyPolicy(keys realyuKeyPolicyReader) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		key, ok := GetAPIKeyFromContext(c)
+		if !ok || key == nil {
+			c.Next()
+			return
+		}
+		usage, err := keys.GetRealYuKeyUsage(c.Request.Context(), key.ID)
+		if err != nil {
+			AbortWithError(c, http.StatusServiceUnavailable, "KEY_POLICY_UNAVAILABLE", "Key policy is temporarily unavailable")
+			return
+		}
+		if usage == nil || !usage.ModelLimitsEnabled {
+			c.Next()
+			return
+		}
+		// Per-turn authorization is deliberately not guessed from a WS handshake.
+		if isResponsesWebSocketRoute(c) {
+			AbortWithError(c, http.StatusServiceUnavailable, "LEGACY_KEY_WS_NOT_READY", "This key's WebSocket policy is not enabled yet")
+			return
+		}
+		var models []string
+		writesBody := c.Request.Method == http.MethodPost || c.Request.Method == http.MethodPut || c.Request.Method == http.MethodPatch
+		if model := groupModelAllowlistModelFromParams(c); model != "" {
+			models = []string{model}
+		} else if writesBody {
+			var done bool
+			models, done = groupModelAllowlistModelsFromBody(c)
+			if !done {
+				return
+			}
+			// The shared candidate reader intentionally includes case variants and
+			// session.model. Those cannot stand in for the actual top-level model
+			// read by Images/Responses, or for an inherited/default model.
+			body, err := httputil.ReadRequestBodyWithPrealloc(c.Request)
+			if err != nil {
+				AbortWithError(c, http.StatusBadRequest, "INVALID_REQUEST_BODY", "Failed to read request body")
+				return
+			}
+			if realyuAmbiguousModelFields(body) {
+				AbortWithError(c, http.StatusBadRequest, "AMBIGUOUS_MODEL", "Conflicting model fields are not allowed for this key")
+				return
+			}
+			if realyuImageWriteRoute(c) {
+				model, ok := realyuImagePolicyModel(c, body)
+				if !ok {
+					return
+				}
+				models = append(models, model)
+			} else if !requestmodel.IsLiveRequestRoute(c.FullPath()) {
+				// This exported parser shares Images' strict top-level JSON and
+				// last multipart model-field semantics; it does not use query or
+				// nested session values as a fallback.
+				model := service.ParseGrokMediaRequest(c.GetHeader("Content-Type"), body).Model
+				if model == "" {
+					AbortWithError(c, http.StatusBadRequest, "MODEL_REQUIRED", "An explicit model is required for this key")
+					return
+				}
+				models = append(models, model)
+			}
+			if len(models) == 0 {
+				AbortWithError(c, http.StatusBadRequest, "MODEL_REQUIRED", "An explicit model is required for this key")
+				return
+			}
+		}
+		if !writesBody && len(models) == 0 && strings.TrimSpace(c.Query("model")) != "" {
+			models = []string{strings.TrimSpace(c.Query("model"))}
+		}
+		for _, model := range models {
+			if !usage.ModelLimits[model] {
+				AbortWithError(c, http.StatusForbidden, "MODEL_NOT_ALLOWED", "Model is not allowed for this key")
+				return
+			}
+		}
+		c.Next()
+	}
+}
+
+func realyuImageWriteRoute(c *gin.Context) bool {
+	switch c.FullPath() {
+	case "/v1/images/generations", "/v1/images/edits", "/v1/images/generations/async", "/v1/images/edits/async",
+		"/images/generations", "/images/edits", "/images/generations/async", "/images/edits/async":
+		return true
+	default:
+		return false
+	}
+}
+
+func realyuAmbiguousModelFields(body []byte) bool {
+	// Empty duplicate JSON fields are ambiguous across first-value/last-value
+	// parsers. Reject them before a later parser can select an implicit model.
+	if gjson.ValidBytes(body) {
+		fields, empty := 0, false
+		gjson.ParseBytes(body).ForEach(func(key, value gjson.Result) bool {
+			if strings.EqualFold(key.String(), "model") {
+				fields++
+				empty = empty || value.Type != gjson.String || strings.TrimSpace(value.String()) == ""
+			}
+			return true
+		})
+		if fields > 1 && empty {
+			return true
+		}
+	}
+	return false
+}
+
+func realyuImagePolicyModel(c *gin.Context, body []byte) (string, bool) {
+	if model := service.ParseGrokMediaRequest(c.GetHeader("Content-Type"), body).Model; model != "" {
+		// Keep explicit public aliases intact for the later composite resolver.
+		return model, true
+	}
+	// Reuse the native parser for its default instead of copying gpt-image-2
+	// into a second configuration. Query, Model and session.model do not set it.
+	parsed, err := (&service.OpenAIGatewayService{}).ParseOpenAIImagesRequest(c, body)
+	if err != nil {
+		AbortWithError(c, http.StatusBadRequest, "INVALID_IMAGE_REQUEST", "Unable to determine the image model for this key")
+		return "", false
+	}
+	return parsed.Model, true
+}
