+	cfg := cloneStringMap(p.config)
+	cfg["compatibilityMode"] = "unknown"
+	if _, err := NewEasyPay("test", cfg); err == nil {
+		t.Fatal("unknown compatibility mode must be rejected")
+	}
+	// The explicit setting is normalized, without mutating the caller's map.
+	cfg["compatibilityMode"] = " ZPay "
+	configured, err := NewEasyPay("test", cfg)
+	if err != nil || configured.config["compatibilityMode"] != "zpay" || cfg["compatibilityMode"] != " ZPay " {
+		t.Fatal(fmt.Sprintf("compatibility setting was not isolated: %v", err))
+	}
+}
