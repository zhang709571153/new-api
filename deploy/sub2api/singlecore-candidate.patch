@@ -0,0 +1,78 @@
+package handler
+
+import (
+	"context"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type handlerFundingRepo struct {
+	service.RealYuFundingRepository
+	reserved, refunded atomic.Int64
+}
+
+func (r *handlerFundingRepo) Reserve(_ context.Context, req service.RealYuFundingRequest) (*service.RealYuFundingReceipt, error) {
+	r.reserved.Add(1)
+	return &service.RealYuFundingReceipt{}, nil
+}
+func (r *handlerFundingRepo) Refund(_ context.Context, req service.RealYuFundingRequest) (*service.RealYuFundingReceipt, error) {
+	r.refunded.Add(1)
+	return &service.RealYuFundingReceipt{}, nil
+}
+
+type fundingEstimator struct{ priced bool }
+
+func (e fundingEstimator) EstimateInflightReservation(context.Context, *service.APIKey, service.InflightEstimateRequest) (float64, bool) {
+	return .01, e.priced
+}
+func TestRealYuFundingHandlerRequiresEstimateAndRefundsFailure(t *testing.T) {
+	repo := &handlerFundingRepo{}
+	key := &service.APIKey{ID: 1, UserID: 2, RealYuFunding: &service.RealYuFundingScope{}, RealYuFundingRepository: repo}
+	_, _, err := reserveInflightBalanceCtx(context.Background(), nil, fundingEstimator{}, key, nil, service.InflightEstimateRequest{})
+	require.Error(t, err)
+	require.Zero(t, repo.reserved.Load())
+	ctx, done, err := reserveInflightBalanceCtx(context.Background(), nil, fundingEstimator{true}, key, nil, service.InflightEstimateRequest{})
+	require.NoError(t, err)
+	require.NotNil(t, service.RealYuFundingFromContext(ctx))
+	done()
+	done()
+	require.EqualValues(t, 1, repo.refunded.Load())
+}
+
+func TestRealYuFundingUsageTaskCannotDropOrLoseContext(t *testing.T) {
+	for _, kind := range []string{"openai", "messages"} {
+		t.Run(kind, func(t *testing.T) {
+			repo := &handlerFundingRepo{}
+			key := &service.APIKey{ID: 1, UserID: 2, RealYuFunding: &service.RealYuFundingScope{}, RealYuFundingRepository: repo}
+			parent, done, err := service.BeginRealYuFunding(context.Background(), key, .01)
+			require.NoError(t, err)
+			pool := service.NewUsageRecordWorkerPoolWithOptions(service.UsageRecordWorkerPoolOptions{WorkerCount: 1, QueueSize: 1, TaskTimeout: time.Second, OverflowPolicy: "drop", OverflowSamplePercent: 0, AutoScaleEnabled: false})
+			t.Cleanup(pool.Stop)
+			block := make(chan struct{})
+			started := make(chan struct{})
+			defer close(block)
+			require.False(t, pool.Submit(func(context.Context) { close(started); <-block }).Dropped())
+			<-started
+			require.False(t, pool.Submit(func(context.Context) {}).Dropped())
+			var called atomic.Bool
+			task := func(ctx context.Context) {
+				require.Same(t, service.RealYuFundingFromContext(parent), service.RealYuFundingFromContext(ctx))
+				called.Store(true)
+				service.RealYuFundingFromContext(ctx).Settled()
+			}
+			if kind == "openai" {
+				h := &OpenAIGatewayHandler{usageRecordWorkerPool: pool}
+				h.submitUsageRecordTask(parent, task)
+			} else {
+				h := &GatewayHandler{usageRecordWorkerPool: pool}
+				h.submitUsageRecordTask(parent, task)
+			}
+			require.True(t, called.Load(), "saturated queue must execute money-critical task inline")
+			done()
+			require.Zero(t, repo.refunded.Load())
+		})
+	}
+}
