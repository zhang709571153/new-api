+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+type realyuFundingStub struct {
+	RealYuFundingRepository
+	reserves, refunds int
+	fail              bool
+}
+
+func (s *realyuFundingStub) Reserve(_ context.Context, r RealYuFundingRequest) (*RealYuFundingReceipt, error) {
+	s.reserves++
+	if s.fail {
+		return nil, ErrRealYuFundingInsufficient
+	}
+	return &RealYuFundingReceipt{TargetQuota: r.TargetQuota}, nil
+}
+func (s *realyuFundingStub) Refund(_ context.Context, r RealYuFundingRequest) (*RealYuFundingReceipt, error) {
+	s.refunds++
+	return &RealYuFundingReceipt{}, nil
+}
+func (s *realyuFundingStub) Resolve(_ context.Context, key, actor int64) (*RealYuFundingScope, error) {
+	return &RealYuFundingScope{APIKeyID: key, ActorUserID: actor, PayerUserID: 4, TeamID: 5}, nil
+}
+func TestRealYuFundingLifecycleFailureAndUnknownOutcome(t *testing.T) {
+	for _, tc := range []struct {
+		name                 string
+		submit, settle, fail bool
+		refunds              int
+	}{{"upstream_rejected", false, false, false, 1}, {"successful_usage", true, true, false, 0}, {"unknown_commit_retains_reservation", true, false, false, 0}, {"reserve_rejected", false, false, true, 0}} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &realyuFundingStub{fail: tc.fail}
+			key := &APIKey{ID: 1, UserID: 2, RealYuFunding: &RealYuFundingScope{}, RealYuFundingRepository: repo}
+			ctx, done, err := BeginRealYuFunding(context.Background(), key, .01)
+			if tc.fail {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+				h := RealYuFundingFromContext(ctx)
+				require.NotNil(t, h)
+				if tc.submit {
+					h.Submitted()
+				}
+				if tc.settle {
+					h.Settled()
+				}
+			}
+			done()
+			done()
+			require.Equal(t, tc.refunds, repo.refunds)
+		})
+	}
+}
+func TestRealYuFundingPrepareCopiesCachedAPIKey(t *testing.T) {
+	repo := &realyuFundingStub{}
+	svc := &APIKeyService{}
+	svc.SetRealYuFundingRepository(repo)
+	cached := &APIKey{ID: 1, UserID: 2}
+	first, err := svc.PrepareRealYuFunding(context.Background(), cached)
+	require.NoError(t, err)
+	second, err := svc.PrepareRealYuFunding(context.Background(), cached)
+	require.NoError(t, err)
+	require.Nil(t, cached.RealYuFunding)
+	require.NotSame(t, first, second)
+	require.NotSame(t, first.RealYuFunding, second.RealYuFunding)
+}
+
+type realyuUsageStub struct {
+	UsageBillingRepository
+	cmd  *UsageBillingCommand
+	fail bool
+}
+
+func (s *realyuUsageStub) Apply(_ context.Context, c *UsageBillingCommand) (*UsageBillingApplyResult, error) {
+	s.cmd = c
+	if s.fail {
+		return nil, errors.New("synthetic failed commit")
+	}
+	return &UsageBillingApplyResult{Applied: true, RealYuFunding: &RealYuFundingReceipt{RealYuFundingScope: RealYuFundingScope{TeamID: 5}}}, nil
+}
+func TestRealYuFundingNativeBillingUsesExactQuotaAndNoLegacyFallback(t *testing.T) {
+	repo := &realyuFundingStub{}
+	key := &APIKey{ID: 1, UserID: 2, Quota: 1, RealYuFunding: &RealYuFundingScope{}, RealYuFundingRepository: repo}
+	key.User = &User{ID: 2}
+	p := &postUsageBillingParams{APIKey: key, User: key.User, Account: &Account{ID: 3, Type: AccountTypeOAuth}, Cost: &CostBreakdown{ActualCost: .0000009999, TotalCost: .0000009999}, APIKeyService: apiKeyQuotaUpdaterStub{}}
+	ctx, done, err := BeginRealYuFunding(context.Background(), key, .01)
+	require.NoError(t, err)
+	defer done()
+	RealYuFundingFromContext(ctx).Submitted()
+	usage := &realyuUsageStub{}
+	ok, err := applyUsageBilling(ctx, "upstream-id", nil, p, &billingDeps{}, usage)
+	require.NoError(t, err)
+	require.True(t, ok)
+	require.NotNil(t, usage.cmd.RealYuFunding)
+	require.Zero(t, usage.cmd.RealYuFunding.TargetQuota, "convert before native 8dp quantization")
+	require.Zero(t, usage.cmd.APIKeyQuotaCost)
+	require.Equal(t, usage.cmd.RequestID, usage.cmd.RealYuFunding.RequestID)
+	p.APIKey.Quota = 0
+	p.Cost.ActualCost = .01
+	_, err = applyUsageBilling(ctx, "upstream-id", nil, p, &billingDeps{}, usage)
+	require.NoError(t, err)
+	require.Equal(t, .01, usage.cmd.APIKeyQuotaCost, "unlimited team key still records lifetime usage")
+	_, err = applyUsageBilling(context.Background(), "r", nil, p, &billingDeps{}, usage)
+	require.ErrorIs(t, err, ErrRealYuFundingNotReserved)
+	_, err = applyUsageBilling(ctx, "r", nil, p, &billingDeps{}, nil)
+	require.ErrorIs(t, err, ErrRealYuFundingNotReserved)
+}
