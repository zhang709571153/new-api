+package service
+
+import (
+	"github.com/shopspring/decimal"
+	"github.com/stretchr/testify/require"
+	"math"
+	"testing"
+)
+
+func TestRealYuQuotaExactDecimalBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		s string
+		q int64
+	}{{"0", 0}, {"0.000000999999999", 0}, {"0.000001", 1}, {"1.234567", 617284}, {"4294.967294", RealYuMaxRequestQuota}} {
+		q, err := RealYuQuotaFromDecimalUSD(decimal.RequireFromString(tc.s))
+		require.NoError(t, err)
+		require.Equal(t, tc.q, q)
+	}
+	for _, v := range []float64{-1, math.NaN(), math.Inf(1), 5000} {
+		_, err := RealYuQuotaFromUSD(v)
+		require.ErrorIs(t, err, ErrRealYuFundingRange)
+	}
+	for _, q := range []int64{0, 1, RealYuMaxRequestQuota, RealYuMaxWalletQuota, -RealYuMaxWalletQuota} {
+		usd, err := RealYuUSDFromQuota(q)
+		require.NoError(t, err)
+		require.True(t, decimal.RequireFromString(usd).Mul(decimal.NewFromInt(RealYuQuotaPerUSD)).Equal(decimal.NewFromInt(q)))
+	}
+}
