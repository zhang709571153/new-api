@@ -0,0 +1,95 @@
+//go:build unit
+
+package service
+
+import (
+	"context"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRealYuFundingUsagePricingMustRemainAvailable(t *testing.T) {
+	const model = "realyu-test-priced-model"
+	for _, gateway := range []string{"openai", "claude"} {
+		for _, state := range []string{"priced", "missing", "missing_with_search", "explicit_free", "native_missing"} {
+			t.Run(gateway+"/"+state, func(t *testing.T) {
+				funding := &realyuFundingStub{}
+				key := &APIKey{ID: 2, UserID: 1, User: &User{ID: 1}}
+				managed := state != "native_missing"
+				if managed {
+					key.RealYuFunding = &RealYuFundingScope{APIKeyID: key.ID, ActorUserID: key.UserID, PayerUserID: key.UserID}
+					key.RealYuFundingRepository = funding
+				}
+				logs := &openAIRecordUsageLogRepoStub{}
+				bill := &openAIRecordUsageBillingRepoStub{result: &UsageBillingApplyResult{Applied: true}}
+				if managed {
+					bill.result.RealYuFunding = &RealYuFundingReceipt{RealYuFundingScope: RealYuFundingScope{TeamID: 5}}
+				}
+				pricing := &PricingService{pricingData: map[string]*LiteLLMModelPricing{
+					model: {InputCostPerToken: 0.000001, OutputCostPerToken: 0.000004},
+				}}
+				openai := newOpenAIRecordUsageServiceWithBillingRepoForTest(logs, bill, &openAIRecordUsageUserRepoStub{}, &openAIRecordUsageSubRepoStub{}, nil)
+				claude := newGatewayRecordUsageServiceWithBillingRepoForTest(logs, bill, &openAIRecordUsageUserRepoStub{}, &openAIRecordUsageSubRepoStub{})
+				billing := NewBillingService(openai.cfg, pricing)
+				openai.billingService, claude.billingService = billing, billing
+				// The request was priced at admission. Simulate a price disappearing
+				// or becoming explicitly free while the upstream operation is running.
+				estimate, priced := EstimateInflightReservationCost(billing, config.InflightReservationConfig{}, model, 4000, 1000, 1.1)
+				require.True(t, priced)
+				require.Positive(t, estimate)
+				ctx, done, err := BeginRealYuFunding(context.Background(), key, estimate)
+				require.NoError(t, err)
+				switch state {
+				case "missing", "missing_with_search", "native_missing":
+					delete(pricing.pricingData, model)
+				case "explicit_free":
+					pricing.pricingData[model] = &LiteLLMModelPricing{}
+				}
+				searchCount := 0
+				if state == "missing_with_search" {
+					searchCount = 1
+				}
+				account := &Account{ID: 3}
+				if gateway == "openai" {
+					err = openai.RecordUsage(ctx, &OpenAIRecordUsageInput{
+						Result: &OpenAIForwardResult{RequestID: "pricing-regression", Model: model, Usage: OpenAIUsage{InputTokens: 1000, OutputTokens: 100}, SearchCount: searchCount},
+						APIKey: key, User: key.User, Account: account,
+					})
+				} else {
+					err = claude.RecordUsage(ctx, &RecordUsageInput{
+						Result: &ForwardResult{RequestID: "pricing-regression", Model: model, Usage: ClaudeUsage{InputTokens: 1000, OutputTokens: 100}, SearchCount: searchCount},
+						APIKey: key, User: key.User, Account: account,
+					})
+				}
+				done()
+				require.Zero(t, funding.refunds, "unknown pricing must retain the admitted hold")
+				if state == "missing" || state == "missing_with_search" {
+					require.ErrorIs(t, err, ErrModelPricingUnavailable)
+					require.Zero(t, bill.calls, "missing price must not produce a zero settlement")
+					require.Zero(t, logs.calls, "do not publish a misleading free usage row")
+					require.False(t, RealYuFundingFromContext(ctx).settled)
+					return
+				}
+				require.NoError(t, err)
+				require.Equal(t, 1, bill.calls)
+				require.Equal(t, 1, logs.calls)
+				if !managed {
+					require.Nil(t, bill.lastCmd.RealYuFunding)
+					require.Zero(t, logs.lastLog.ActualCost)
+					return
+				}
+				require.NotNil(t, bill.lastCmd.RealYuFunding)
+				require.True(t, RealYuFundingFromContext(ctx).settled)
+				if state == "explicit_free" {
+					require.Zero(t, bill.lastCmd.RealYuFunding.TargetQuota)
+					require.Zero(t, logs.lastLog.ActualCost)
+				} else {
+					require.EqualValues(t, 770, bill.lastCmd.RealYuFunding.TargetQuota)
+					require.InDelta(t, 0.00154, logs.lastLog.ActualCost, 1e-12)
+				}
+			})
+		}
+	}
+}
