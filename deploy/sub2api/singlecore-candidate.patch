index 0000000000000000000000000000000000000000..af016b8a3c33ca1c1474c8ac8bd63064d1a9d828
--- /dev/null
+++ b/backend/internal/service/realyu_funding_lifecycle.go
@@ -0,0 +1,101 @@
+package service
+
+import (
+	"context"
+	"github.com/google/uuid"
+	"log/slog"
+	"sync"
+	"time"
+)
+
+type realyuFundingContextKey struct{}
+
+// The reservation is persisted before forwarding. A crash/unknown billing
+// outcome retains the reservation for reconciliation; there is NO expiry-based
+// refund that might return already-consumed money. Only a handler with no
+// submitted usage task releases its reservation automatically.
+type RealYuFundingHold struct {
+	repo                            RealYuFundingRepository
+	request                         RealYuFundingRequest
+	mu                              sync.Mutex
+	submitted, handlerDone, settled bool
+}
+
+func BeginRealYuFunding(ctx context.Context, key *APIKey, estimateUSD float64) (context.Context, func(), error) {
+	if key == nil || key.RealYuFunding == nil {
+		return ctx, func() {}, nil
+	}
+	if key.RealYuFundingRepository == nil {
+		return ctx, func() {}, ErrRealYuFundingDisabled
+	}
+	if RealYuFundingFromContext(ctx) != nil {
+		return ctx, func() {}, ErrRealYuFundingConflict
+	}
+	q, err := RealYuQuotaFromUSD(estimateUSD)
+	if err != nil || q <= 0 {
+		return ctx, func() {}, ErrRealYuFundingRange
+	}
+	// Server-generated, unique per admitted operation. Client request headers
+	// are not accepted as dedup keys (replay must not produce unbilled work).
+	request := RealYuFundingRequest{RequestID: "realyu:" + uuid.NewString(), APIKeyID: key.ID, ActorUserID: key.UserID, TargetQuota: q}
+	if _, err = key.RealYuFundingRepository.Reserve(ctx, request); err != nil {
+		return ctx, func() {}, err
+	}
+	hold := &RealYuFundingHold{repo: key.RealYuFundingRepository, request: request}
+	return WithRealYuFunding(ctx, hold), hold.HandlerDone, nil
+}
+func WithRealYuFunding(ctx context.Context, h *RealYuFundingHold) context.Context {
+	if h == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, realyuFundingContextKey{}, h)
+}
+func RealYuFundingFromContext(ctx context.Context) *RealYuFundingHold {
+	if ctx == nil {
+		return nil
+	}
+	h, _ := ctx.Value(realyuFundingContextKey{}).(*RealYuFundingHold)
+	return h
+}
+func (h *RealYuFundingHold) Submitted() {
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	h.submitted = true
+	h.mu.Unlock()
+}
+func (h *RealYuFundingHold) Settled() {
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	h.settled = true
+	h.mu.Unlock()
+}
+func (h *RealYuFundingHold) Request(finalQuota int64) RealYuFundingRequest {
+	r := h.request
+	r.TargetQuota = finalQuota
+	return r
+}
+func (h *RealYuFundingHold) HandlerDone() {
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	if h.handlerDone {
+		h.mu.Unlock()
+		return
+	}
+	h.handlerDone = true
+	refund := !h.submitted && !h.settled
+	h.mu.Unlock()
+	if !refund {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if _, err := h.repo.Refund(ctx, h.request); err != nil {
+		slog.Error("realyu funding refund requires reconciliation", "request_id", h.request.RequestID)
+	}
+}
