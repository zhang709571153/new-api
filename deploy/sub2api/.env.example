# This file is a template, not a working deployment. Keep the filled file private.
# Registry manifests verified 2026-10-09; runtime acceptance remains separate.
# Git tag is v0.2.15, Docker Hub tag is 0.2.15 (without v).
SUB2API_IMAGE=weishaw/sub2api:0.2.15@sha256:da0fd94daebf890419e21e956821fd6c2008fc666f9617f2eb917f4492245da3
POSTGRES_IMAGE=postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
REDIS_IMAGE=redis:8-alpine@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0
REALYU_IMAGE=realyu-sub2api:candidate
REALYU_VERSION=realyu-sub2api-candidate
TZ=Asia/Shanghai
SUB2API_PORT=28080
REALYU_PORT=23000

# Use an ABSOLUTE directory inside the Linux guest, outside the checkout.
# Windows NTFS/SMB is not an appropriate location for live PostgreSQL/SQLite files.
STATE_ROOT=
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=
SUB2API_POSTGRES_PASSWORD=
SUB2API_REDIS_PASSWORD=
SUB2API_JWT_SECRET=
SUB2API_TOTP_ENCRYPTION_KEY=

# Migration MUST preserve the old site's session/crypto secrets. Only a fresh
# isolated test site uses newly generated secrets; do not rotate them at restore.
REALYU_SESSION_SECRET=
REALYU_CRYPTO_SECRET=
REALYU_SUB2API_ADMIN_URL=http://127.0.0.1:28080
# Optional RealYu remote-file/download egress; independent of Sub2API account proxies.
# Leave blank for direct egress. Never disable TLS verification to fix a trust error.
REALYU_HTTP_PROXY=
REALYU_HTTPS_PROXY=
REALYU_NO_PROXY_EXTRA=
# Put the Sub2API admin key and stable identity secret in the PRIVATE file
# ${STATE_ROOT}/integration/sub2api.json, using bindings.example.json as schema.
# Never populate or commit the example itself.
# Keep provision.mode=prewarmed in that JSON. Normal requests do not create
# backend users or log them in. The portal reconciles authorized subjects into
# enrollment-queue; its companion --watch worker drains them before API readiness.
# Create integration, enrollment-queue and prewarm directories under STATE_ROOT.
